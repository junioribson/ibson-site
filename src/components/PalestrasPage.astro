---
// Landing page de Palestras: hero imersivo animado, temas com imagem, formatos
// e CTA de noite. Conteúdo em `talks` (content.*.ts). Claro + escuro (tokens).
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { getContent, normalizeLocale, localizePath, imgDims } from "../i18n/utils";
import { t } from "../i18n/ui";

const locale = normalizeLocale(Astro.currentLocale);
const { talks } = getContent(locale);
const ui = t(locale);
const home = localizePath("/", locale);
const contato = `${home}#contato`;
---

<Nav />
<main id="top" class="lp lp-talks">
  <section class="lp-hero">
    <div class="lp-aurora" aria-hidden="true">
      <span class="orb orb-a"></span><span class="orb orb-b"></span><span class="orb orb-c"></span>
      <span class="lp-grid-lines"></span>
    </div>
    <div class="wrap lp-hero-in">
      <a class="lp-back" href={home}>‹ {ui.breadcrumbHome}</a>
      <span class="lp-kicker reveal">{ui.kickerPalestras}</span>
      <h1 class="lp-title reveal">{talks.title}</h1>
      <p class="lp-lead reveal">{talks.subtitle}</p>
      <div class="lp-cta-row reveal">
        <a class="lp-btn lp-btn-primary" href={contato}><span>{talks.cta.label}</span></a>
        <a class="lp-btn lp-btn-ghost" href="#temas">{ui.lpSeeThemes}</a>
      </div>
      <p class="lp-geo reveal">{talks.geoNote}</p>
    </div>
    <a class="lp-scroll" href="#tese" aria-label={ui.heroScrollAria}><span></span></a>
  </section>

  <section class="lp-tese" id="tese">
    <div class="wrap lp-tese-in">
      {talks.intro.map((p, i) => <p class:list={["lp-tese-p reveal", { lead: i === 0 }]} set:html={p} />)}
    </div>
  </section>

  <section class="lp-temas" id="temas">
    <div class="wrap">
      <div class="lp-shead reveal"><span class="lp-shead-dot"></span>{ui.lpThemes}</div>
      <div class="lp-temas-grid">
        {
          talks.themes.map((th, i) => (
            <article class="lp-tema reveal">
              <div class="lp-tema-media">
                <img loading="lazy" src={th.cover} {...imgDims(th.cover)} alt={th.title} />
                <span class="lp-tema-idx">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <div class="lp-tema-body">
                <h3>{th.title}</h3>
                <p>{th.description}</p>
                <span class="lp-tema-aud">{th.audience}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lp-formats">
    <div class="wrap lp-formats-in">
      <div class="lp-fcol reveal">
        <span class="lp-fcol-t">{ui.lpFormats}</span>
        <div class="lp-chips">{talks.formats.map((f) => <span class="lp-chip">{f}</span>)}</div>
      </div>
      <div class="lp-fcol reveal">
        <span class="lp-fcol-t">{ui.lpDurations}</span>
        <div class="lp-chips">{talks.durations.map((d) => <span class="lp-chip">{d}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="lp-faq" id="faq">
    <div class="wrap">
      <div class="lp-shead reveal"><span class="lp-shead-dot"></span>{ui.lpFaqTitle}</div>
      <div class="lp-faq-list">
        {
          talks.faq.map((f) => (
            <details class="lp-faq-item reveal">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lp-final">
    <div class="lp-final-bg" aria-hidden="true"><span class="orb orb-f1"></span><span class="orb orb-f2"></span></div>
    <div class="wrap lp-final-in reveal">
      <h2 class="lp-final-t">{ui.lpTalksCta}</h2>
      <p class="lp-final-note">{talks.note}</p>
      <a class="lp-btn lp-btn-primary lp-btn-lg" href={contato}><span>{talks.cta.label}</span></a>
    </div>
  </section>
</main>
<Footer />

<style>
  .lp { --lp-neon: linear-gradient(120deg, #6a2ee6 0%, #9a54ff 50%, #c94f8a 100%); }
  .lp-back {
    position: relative; z-index: 3; font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.06em; color: var(--accent); display: block; width: fit-content; margin-bottom: 26px;
  }

  /* ===== HERO ===== */
  .lp-hero {
    position: relative; overflow: hidden; min-height: 94svh;
    display: flex; align-items: center; padding: 130px 0 90px; background: var(--bg);
  }
  .lp-aurora { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .orb { position: absolute; border-radius: 50%; filter: blur(72px); will-change: transform, opacity; }
  .orb-a { width: 46vw; height: 46vw; left: -8vw; top: -6vw; background: radial-gradient(circle, #7b57f0, transparent 68%); opacity: 0.5; animation: drift1 22s ease-in-out infinite; }
  .orb-b { width: 40vw; height: 40vw; right: -6vw; top: 8vw; background: radial-gradient(circle, #c94f8a, transparent 68%); opacity: 0.38; animation: drift2 26s ease-in-out infinite; }
  .orb-c { width: 38vw; height: 38vw; left: 30vw; bottom: -14vw; background: radial-gradient(circle, #5b2ee6, transparent 68%); opacity: 0.4; animation: drift3 30s ease-in-out infinite; }
  :root[data-theme="light"] .orb-a { opacity: 0.34; }
  :root[data-theme="light"] .orb-b { opacity: 0.26; }
  :root[data-theme="light"] .orb-c { opacity: 0.28; }
  .lp-grid-lines {
    position: absolute; inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px; opacity: 0.35;
    mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 72%);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 72%);
  }
  @keyframes drift1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(4vw,3vw) scale(1.1); } }
  @keyframes drift2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-3vw,4vw) scale(1.08); } }
  @keyframes drift3 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(3vw,-3vw) scale(1.12); } }
  @media (prefers-reduced-motion: reduce) { .orb { animation: none !important; } }

  .lp-hero-in { position: relative; z-index: 2; max-width: 980px; }
  .lp-kicker {
    display: inline-block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--accent); text-shadow: 0 0 20px var(--glow); margin-bottom: 22px;
  }
  .lp-title {
    font-size: clamp(38px, 6.4vw, 82px); font-weight: 800; letter-spacing: -0.04em;
    line-height: 1.02; color: var(--heading); margin: 0; max-width: 18ch; text-wrap: balance;
  }
  .lp-lead {
    margin-top: 24px; font-size: clamp(17px, 1.7vw, 22px); line-height: 1.55;
    color: var(--text); max-width: 62ch;
  }
  .lp-cta-row { margin-top: 40px; display: flex; gap: 16px; flex-wrap: wrap; }
  .lp-btn {
    display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-sans);
    font-weight: 800; font-size: 15px; padding: 15px 30px; border-radius: 999px;
    transition: transform 0.3s var(--e), box-shadow 0.3s var(--e), filter 0.3s var(--e);
  }
  .lp-btn-primary { color: #fff; background: var(--lp-neon); box-shadow: 0 18px 40px -14px rgba(122, 46, 230, 0.7); }
  .lp-btn-primary:hover { transform: translateY(-3px); box-shadow: 0 26px 54px -16px rgba(201, 79, 138, 0.7); filter: brightness(1.07); }
  .lp-btn-lg { padding: 18px 40px; font-size: 16px; }
  .lp-btn-ghost { color: var(--heading); border: 1px solid var(--line-strong, var(--line)); background: var(--panel); }
  .lp-btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-3px); }

  .lp-scroll { position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%); z-index: 2; width: 26px; height: 42px; border: 2px solid var(--line-strong, var(--line)); border-radius: 14px; display: flex; justify-content: center; }
  .lp-scroll span { width: 4px; height: 8px; border-radius: 2px; background: var(--accent); margin-top: 7px; animation: scrolldot 1.6s ease-in-out infinite; }
  @keyframes scrolldot { 0%,100% { opacity: 0; transform: translateY(0); } 40% { opacity: 1; } 80% { opacity: 0; transform: translateY(12px); } }

  /* ===== TESE ===== */
  .lp-tese { padding: clamp(70px, 10vw, 130px) 0; }
  .lp-tese-in { max-width: 820px; }
  .lp-tese-p { font-size: clamp(18px, 1.7vw, 22px); line-height: 1.7; color: var(--text); margin: 0 0 22px; }
  .lp-tese-p.lead { font-size: clamp(22px, 2.6vw, 32px); line-height: 1.34; font-weight: 700; color: var(--heading); letter-spacing: -0.02em; margin-bottom: 30px; }
  .lp-tese-p :global(strong) { color: var(--heading); }

  /* ===== TEMAS ===== */
  .lp-temas { padding: 0 0 clamp(70px, 10vw, 130px); }
  .lp-shead { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 34px; }
  .lp-shead-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lp-neon); box-shadow: 0 0 14px var(--glow); }
  .lp-temas-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .lp-tema { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--panel); transition: transform 0.4s var(--e), box-shadow 0.4s var(--e), border-color 0.3s; }
  .lp-tema:hover { transform: translateY(-8px); border-color: var(--accent); box-shadow: 0 34px 60px -34px rgba(90, 30, 200, 0.5); }
  .lp-tema-media { position: relative; aspect-ratio: 16 / 11; overflow: hidden; }
  .lp-tema-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--e); }
  .lp-tema:hover .lp-tema-media img { transform: scale(1.07); }
  .lp-tema-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(10, 4, 20, 0.55)); }
  .lp-tema-idx { position: absolute; top: 12px; left: 14px; z-index: 2; font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: #fff; letter-spacing: 0.1em; padding: 5px 9px; border-radius: 8px; background: rgba(20, 8, 40, 0.5); backdrop-filter: blur(6px); border: 1px solid rgba(255, 255, 255, 0.18); }
  .lp-tema-body { padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .lp-tema-body h3 { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.24; color: var(--heading); }
  .lp-tema-body p { font-size: 14.5px; line-height: 1.6; color: var(--text-soft, var(--text)); margin: 0; flex: 1; }
  .lp-tema-aud { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.05em; line-height: 1.5; color: var(--accent); border-top: 1px solid var(--line); padding-top: 12px; }

  /* ===== FORMATOS ===== */
  .lp-formats { padding: 0 0 clamp(70px, 10vw, 120px); }
  .lp-formats-in { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; border-top: 1px solid var(--line); padding-top: clamp(40px, 6vw, 64px); }
  .lp-fcol-t { display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 18px; }
  .lp-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .lp-chip { font-family: var(--font-sans); font-weight: 700; font-size: 14px; color: var(--heading); padding: 10px 18px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); transition: border-color 0.25s, color 0.25s, transform 0.25s; }
  .lp-chip:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

  .lp-geo { margin-top: 22px; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.02em; color: var(--ink-soft); }

  /* ===== FAQ (PAA) ===== */
  .lp-faq { padding: 0 0 clamp(70px, 10vw, 120px); }
  .lp-faq-list { max-width: 820px; }
  .lp-faq-item { border-top: 1px solid var(--line); }
  .lp-faq-item:last-child { border-bottom: 1px solid var(--line); }
  .lp-faq-item summary { list-style: none; cursor: pointer; padding: 20px 0; font-family: var(--font-sans); font-weight: 700; font-size: clamp(16px, 1.6vw, 19px); color: var(--heading); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .lp-faq-item summary::-webkit-details-marker { display: none; }
  .lp-faq-item summary::after { content: "+"; font-family: var(--font-mono); font-size: 22px; line-height: 1; color: var(--accent); transition: transform 0.25s var(--e); flex: none; }
  .lp-faq-item[open] summary::after { transform: rotate(45deg); }
  .lp-faq-item p { margin: 0 0 20px; font-size: 15.5px; line-height: 1.7; color: var(--text); max-width: 70ch; }

  /* ===== CTA FINAL (noite) ===== */
  .lp-final { position: relative; overflow: hidden; padding: clamp(80px, 12vw, 150px) 0; background: linear-gradient(160deg, #1a0733, #2a0148 55%, #150026); text-align: center; }
  .lp-final-bg { position: absolute; inset: 0; z-index: 0; }
  .orb-f1 { width: 50vw; height: 50vw; left: -10vw; top: -20vw; background: radial-gradient(circle, #7b57f0, transparent 66%); opacity: 0.5; animation: drift1 24s ease-in-out infinite; }
  .orb-f2 { width: 40vw; height: 40vw; right: -8vw; bottom: -18vw; background: radial-gradient(circle, #c94f8a, transparent 66%); opacity: 0.42; animation: drift2 28s ease-in-out infinite; }
  .lp-final-in { position: relative; z-index: 2; max-width: 780px; }
  .lp-final-t { font-size: clamp(28px, 4.6vw, 52px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.08; color: #fff; margin: 0 auto; max-width: 18ch; }
  .lp-final-note { margin: 22px auto 34px; font-size: clamp(15px, 1.5vw, 18px); line-height: 1.6; color: rgba(255, 255, 255, 0.78); max-width: 60ch; }

  @media (max-width: 980px) { .lp-temas-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .lp-temas-grid { grid-template-columns: 1fr; }
    .lp-formats-in { grid-template-columns: 1fr; gap: 30px; }
    .lp-hero { min-height: auto; padding: 116px 0 72px; }
  }
</style>
