---
// Sobre: trajetória com autoridade, sem currículo nem autopromoção.
// TODO(asset): quando houver retrato editorial, definir `photo`
// (ex.: "/assets/retratos/ibson.webp"). Até lá, placeholder sóbrio.
import { getContent, localizePath, normalizeLocale } from "../i18n/utils";
import { t } from "../i18n/ui";
const locale = normalizeLocale(Astro.currentLocale);
const { about } = getContent(locale);
const ui = t(locale);
const aboutMoreHref = localizePath("/ibson-junior", locale);
// Retrato com troca por tema: fundo escuro (marrom) no tema escuro, fundo claro
// (colete) no tema claro. O frame .fr (aspect 4/5, object-fit cover) faz o recorte.
const ALT = {
  pt: { dark: "Ibson Junior sentado em poltrona de couro, terno escuro, retrato editorial em estúdio", light: "Ibson Junior sorrindo, retrato de busto em fundo claro" },
  es: { dark: "Ibson Junior sentado en un sillón de cuero, traje oscuro, retrato editorial de estudio", light: "Ibson Junior sonriendo, retrato de busto sobre fondo claro" },
  en: { dark: "Ibson Junior seated in a leather armchair, dark suit, editorial studio portrait", light: "Ibson Junior smiling, head and shoulders portrait on light background" },
}[locale];
---

<section class="sobre" id="sobre">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerSobre}</span>
    </div>
    <div class="sobre-grid">
      <div class="sobre-photo reveal">
        <div class="fr">
          <picture style="display:contents">
            <source srcset="/assets/retratos/ibson-poltrona.avif" type="image/avif" />
            <img class="portrait-dark" src="/assets/retratos/ibson-poltrona.webp" alt={ALT.dark} width="1086" height="1448" style="object-position:50% 32%" />
          </picture>
          <picture style="display:contents">
            <source srcset="/assets/retratos/ibson-colete.avif" type="image/avif" />
            <img class="portrait-light" src="/assets/retratos/ibson-colete.webp" alt={ALT.light} width="1024" height="1536" loading="lazy" style="object-position:50% 12%" />
          </picture>
        </div>
      </div>
      <div class="sobre-text reveal d1">
        <h2>{about.title}</h2>
        <p class="about-sub">{about.subtitle}</p>
        <div class="body">
          {about.body.map((p) => <p set:html={p} />)}
        </div>
        <a class="about-more" href={aboutMoreHref}>{ui.aboutMore} <span aria-hidden="true">→</span></a>
      </div>
      <div class="about-proofs reveal">
        {
          about.microprovas.map((m) => (
            <div class="pr">
              <span class="k">{m.k}</span>
              <span class="v" set:html={m.v} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-sub {
    margin-top: 14px;
    font-size: 17px;
    color: var(--ink-soft);
    font-style: italic;
    max-width: 48ch;
  }
  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transition: color 0.25s, text-decoration-color 0.25s;
  }
  .body :global(a:hover) { color: var(--accent); text-decoration-color: var(--accent); }
  .about-more {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 26px;
    font-family: var(--font-sans); font-weight: 800; font-size: 14.5px;
    color: var(--accent); text-shadow: 0 0 16px var(--glow);
    transition: gap 0.25s var(--e);
  }
  .about-more span { transition: transform 0.25s var(--e); }
  .about-more:hover span { transform: translateX(4px); }
  /* Troca de retrato por tema: marrom (fundo escuro) no tema escuro; colete (fundo
     claro) no tema claro. Só um aparece; o frame .fr recorta via object-fit cover. */
  .portrait-light { display: none; }
  :root[data-theme="light"] .portrait-dark { display: none; }
  :root[data-theme="light"] .portrait-light { display: block; }
</style>
