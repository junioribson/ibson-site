---
// Repertório: lastro intelectual que sustenta a prática. Coruja como arquétipo
// (discernimento, visão, leitura fina). Fatos reais apenas.
import { getContent, normalizeLocale } from "../i18n/utils";
import { t } from "../i18n/ui";
const locale = normalizeLocale(Astro.currentLocale);
const { archetypes } = getContent(locale);
const ui = t(locale);

// TODO(asset): logomarca de Dr. José Eduardo / Mães que Curam quando o Ibson enviar.
const REP = {
  pt: {
    h2: "Repertório que sustenta a prática.",
    intro:
      "A autoridade que me interessa não nasce da exposição. Nasce da combinação entre experiência, leitura, escuta e decisões tomadas sob pressão. Cada linha abaixo é menos um título e mais uma marca de percurso: é desse acúmulo, e não do cargo do momento, que nasce o critério.",
    itens: [
      "<strong>Conselheiro administrativo</strong> em projeto liderado pelo Dr. José Eduardo, nas frentes de saúde, educação e comunidade.",
      "<strong>Formação executiva Advanced</strong> em Conselhos e Governança pela Board Academy.",
      "<strong>Coautor</strong> do livro Conselho Diário, 365 Insights Estratégicos.",
      "<strong>Organizador de obras editoriais</strong> da ProliferArte, como Mente Aberta e ValorizArte.",
      "<strong>Artigos autorais mensais</strong> sobre IA, cultura, conteúdo, liderança e decisão.",
      '<strong>Diretor de Conteúdo</strong> na <a href="https://www.futbolsites.net/pt" target="_blank" rel="noopener">Futbol Sites</a>, liderando operações editoriais no Brasil.',
      "<strong>Criação de ativos editoriais</strong> no esporte digital: Antenados no Futebol e a chegada da Bolavip ao Brasil.",
    ],
  },
  es: {
    h2: "Un repertorio que sostiene la práctica.",
    intro:
      "La autoridad que me interesa no nace de la exposición. Nace de la combinación entre experiencia, lectura, escucha y decisiones tomadas bajo presión. Cada línea a continuación es menos un título y más una marca de recorrido: es de esa acumulación, y no del cargo del momento, que nace el criterio.",
    itens: [
      "<strong>Consejero administrativo</strong> en un proyecto liderado por el Dr. José Eduardo, en los frentes de salud, educación y comunidad.",
      "<strong>Formación ejecutiva Advanced</strong> en Consejos y Gobernanza por la Board Academy.",
      "<strong>Coautor</strong> del libro Conselho Diário, 365 Insights Estratégicos.",
      "<strong>Organizador de obras editoriales</strong> de ProliferArte, como Mente Aberta y ValorizArte.",
      "<strong>Artículos de autor mensuales</strong> sobre IA, cultura, contenido, liderazgo y decisión.",
      '<strong>Director de Contenido</strong> en <a href="https://www.futbolsites.net/pt" target="_blank" rel="noopener">Futbol Sites</a>, liderando operaciones editoriales en Brasil.',
      "<strong>Creación de activos editoriales</strong> en el deporte digital: Antenados no Futebol y la llegada de Bolavip a Brasil.",
    ],
  },
  en: {
    h2: "A repertoire that sustains the practice.",
    intro:
      "The authority I care about is not born from exposure. It comes from the combination of experience, reading, listening and decisions made under pressure. Each line below is less a title and more a mark of the journey: it is from that accumulation, not from the current role, that judgment is born.",
    itens: [
      "<strong>Advisory board member</strong> in a project led by Dr. José Eduardo, across health, education and community.",
      "<strong>Advanced executive training</strong> in Boards and Governance by Board Academy.",
      "<strong>Co-author</strong> of the book Conselho Diário, 365 Insights Estratégicos.",
      "<strong>Editor of editorial works</strong> for ProliferArte, such as Mente Aberta and ValorizArte.",
      "<strong>Monthly authored articles</strong> on AI, culture, content, leadership and decision-making.",
      '<strong>Content Director</strong> at <a href="https://www.futbolsites.net/pt" target="_blank" rel="noopener">Futbol Sites</a>, leading editorial operations in Brazil.',
      "<strong>Creation of editorial assets</strong> in digital sports: Antenados no Futebol and Bolavip's arrival in Brazil.",
    ],
  },
} as const;
const rep = REP[locale];
const itens = rep.itens;
---

<section class="repo repertorio" id="repertorio">
  <div
    class="arch-layer on-light arch-right"
    style={`--arch-img:url('${archetypes.owl.src}');--arch-tint:var(--purple-deep);--arch-opacity:.09`}
    aria-hidden="true"
  >
  </div>
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerRepertorio}</span>
    </div>
    <div class="rep-grid">
      <div class="rep-left reveal">
        <h2>{rep.h2}</h2>
        <p>{rep.intro}</p>
        <ul class="rep-list">
          {itens.map((i) => <li set:html={i} />)}
        </ul>
      </div>
      <div class="rep-photo-col reveal d1">
        <img
          class="rep-photo"
          src="/assets/retratos/ibson-junior-executivo.jpg"
          alt="Ibson Junior, executivo de conteúdo e liderança."
          width="514"
          height="900"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .repertorio .rep-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: 54px;
    align-items: stretch;
  }
  .rep-list li { min-width: 0; }
  .rep-photo-col { position: relative; min-height: 0; }
  .rep-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 16%;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 66px -34px rgba(0, 0, 0, 0.85);
  }
  .rep-left .rep-list { margin-top: 30px; }
  .repertorio h2 {
    font-size: clamp(26px, 3.4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.06;
    max-width: 16ch;
    color: #fff;
  }
  .repertorio .rep-grid > div p {
    margin-top: 22px;
    font-size: 17px;
    color: #e7dcc6;
    line-height: 1.72;
    max-width: 46ch;
  }
  .rep-list { list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .rep-list li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 16.5px;
    color: var(--cream);
    line-height: 1.5;
  }
  .rep-list :global(a) {
    color: #db6bff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(219, 107, 255, 0.5);
    transition: color 0.25s, text-decoration-color 0.25s;
  }
  .rep-list :global(a:hover) { color: #ec8bff; text-decoration-color: #ec8bff; }
  .rep-list :global(strong) { color: #fff; font-weight: 700; }
  .rep-list li::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    flex: 0 0 auto;
    transform: translateY(-2px);
  }
  @media (max-width: 980px) {
    .repertorio .rep-grid { grid-template-columns: minmax(0, 1fr); gap: 30px; align-items: start; }
    .rep-photo-col { order: -1; }
    .rep-photo { height: auto; aspect-ratio: 4 / 5; max-height: 540px; }
  }
</style>
