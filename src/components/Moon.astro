---
// "Lua" agora é o globo-constelação (arte do Ibson), com giro e brilho suaves.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class={`${className} moon-net`} aria-hidden="true">
  <img src="/assets/arquetipos/moon-network.webp" alt="" />
</div>

<style>
  .moon-net {
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 60px 8px rgba(176, 146, 94, 0.28), 0 0 120px 30px rgba(123, 87, 240, 0.14);
  }
  .moon-net img {
    width: 130%;
    height: 130%;
    object-fit: cover;
    object-position: center;
    transform: translate(-11.5%, -11.5%);
    animation: moon-spin 90s linear infinite;
    transform-origin: 50% 50%;
  }
  @keyframes moon-spin {
    to { transform: translate(-11.5%, -11.5%) rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .moon-net img { animation: none; }
  }
</style>
