---
import Logo from "./Logo.astro";
import { footer, nav } from "../data/content";
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <Logo class="foot-logo" variant="branca" />
        <b>{footer.name.toUpperCase()}</b><span class="s">{footer.line}</span>
        <p>{footer.complement}</p>
      </div>
      <div class="fcol">
        <h3 class="fcol-h">Navegar</h3>
        {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="fcol">
        <h3 class="fcol-h">Conectar</h3>
        <a href="https://www.linkedin.com/in/ibson-junior/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="mailto:contato@ibsonjunior.com.br">E-mail ↗</a>
        <a href="#contato">Convidar para palestra</a>
        <a href="#contato">Falar sobre mentoria</a>
      </div>
    </div>
    <div class="foot-base">
      <span>© 2026 IBSON JUNIOR · SITE OFICIAL</span>
      <span>CONSCIÊNCIA · LIDERANÇA · DECISÃO</span>
    </div>
  </div>
</footer>

<style>
  .foot-logo { color: #fff; }
</style>
