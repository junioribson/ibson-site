---
// Página de leitura de um artigo (locale-aware) + botão "Traduzir" com idiomas.
import { getCollection, render } from "astro:content";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import ArticleCard from "./ArticleCard.astro";
import { articleTheme } from "../data/clusters";
import { localizePath, normalizeLocale, htmlLang, LANGS } from "../i18n/utils";
import { t } from "../i18n/ui";

const { entry } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const ui = t(locale);
const d = entry.data;
const { Content } = await render(entry);

// Só oferece no botão "Traduzir" os idiomas que já têm este artigo (evita 404).
const [ptCol, esCol, enCol] = await Promise.all([
  getCollection("artigos"),
  getCollection("artigosEs"),
  getCollection("artigosEn"),
]);
const availByLocale: Record<string, boolean> = {
  pt: ptCol.some((e) => e.id === entry.id),
  es: esCol.some((e) => e.id === entry.id),
  en: enCol.some((e) => e.id === entry.id),
};
const translateLangs = LANGS.filter((lg) => availByLocale[lg.code]);

// "Veja também" com cluster de tópico: prioriza artigos do MESMO tema (internal
// linking temático, sinal de autoridade de tópico), completando com os mais
// recentes até 3. Mesmo idioma, exceto o atual.
const collByLocale: Record<string, typeof ptCol> = { pt: ptCol, es: esCol, en: enCol };
const pool = (collByLocale[locale] ?? ptCol)
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => (a.data.dateISO < b.data.dateISO ? 1 : -1));
const currentTheme = articleTheme[entry.id];
const sameTheme = currentTheme ? pool.filter((e) => articleTheme[e.id] === currentTheme) : [];
const others = pool.filter((e) => !sameTheme.includes(e));
const related = [...sameTheme, ...others].slice(0, 3);

const url = new URL(localizePath(`/artigos/${entry.id}`, locale), "https://ibsonjunior.com.br").href;
const coverAbs = `https://ibsonjunior.com.br${d.cover}`;
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;

// Entidade canônica (definida em cheio na home). Autor/publisher apontam para
// ela por @id, para o Google entender que TODO artigo é da mesma pessoa.
const PERSON_ID = "https://ibsonjunior.com.br/#person";
const homePath = localizePath("/", locale);
const homeAbs = new URL(homePath, "https://ibsonjunior.com.br").href;
const libAbs = new URL(localizePath("/artigos", locale), "https://ibsonjunior.com.br").href;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: d.title,
      image: [coverAbs],
      datePublished: d.dateISO,
      dateModified: d.dateISO,
      author: { "@type": "Person", "@id": PERSON_ID, name: "Ibson Junior", url: homeAbs },
      publisher: { "@type": "Person", "@id": PERSON_ID, name: "Ibson Junior" },
      mainEntityOfPage: { "@type": "WebPage", "@id": url },
      description: d.excerpt,
      articleSection: d.category,
      inLanguage: htmlLang(locale),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: ui.breadcrumbHome, item: homeAbs },
        { "@type": "ListItem", position: 2, name: ui.artigosKicker, item: libAbs },
        { "@type": "ListItem", position: 3, name: d.title, item: url },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

<Nav />
<main id="top" class="artpage">
  <article class="art">
    <div class="wrap art-in">
      <div class="art-toolbar">
        <a class="art-back" href={localizePath("/artigos", locale)}>{ui.articleBackAll}</a>
        <details class="art-translate">
          <summary aria-label={ui.articleTranslateTo}>🌐 {ui.articleTranslate}</summary>
          <div class="art-langs">
            {
              translateLangs.map((lg) => (
                <a
                  class:list={["art-lang", { on: lg.code === locale }]}
                  href={localizePath(`/artigos/${entry.id}`, lg.code)}
                  hreflang={lg.htmlLang}
                  lang={lg.htmlLang}
                  data-lang={lg.code}
                >
                  <span>{lg.flag}</span> {lg.label}
                </a>
              ))
            }
          </div>
        </details>
      </div>
      <div class="art-cat">{d.category}</div>
      <h1 class="art-title">{d.title}</h1>
      <div class="art-byline">
        <span>{ui.articleBy} <a class="art-author" href={homePath}><strong>Ibson Junior</strong></a></span>
        <span class="art-dot">·</span>
        <time datetime={d.dateISO}>{d.date}</time>
        <span class="art-dot">·</span>
        <span>{d.readingTime} {ui.articleReadingOf}</span>
      </div>
      <div class="art-cover">
        <img src={d.cover} alt={`Ibson Junior: ${d.title}`} width="1200" height="628" loading="eager" />
      </div>
      <div class="art-body">
        <Content />
      </div>
      <aside class="art-cta">
        <p class="art-cta-title">{ui.articleCtaTitle}</p>
        <p class="art-cta-text">{ui.articleCtaText}</p>
        <a class="art-cta-btn" href={d.linkedinUrl} target="_blank" rel="noopener">
          {ui.articleCtaButton} <span aria-hidden="true">↗</span>
        </a>
      </aside>
      {
        related.length > 0 && (
          <section class="art-related">
            <h2 class="art-related-title">{ui.articleRelatedTitle}</h2>
            <div class="art-related-grid">
              {related.map((e) => (
                <ArticleCard
                  slug={e.id}
                  title={e.data.title}
                  cover={e.data.cover}
                  category={e.data.category}
                  readingTime={e.data.readingTime}
                  date={e.data.date}
                />
              ))}
            </div>
          </section>
        )
      }
      <div class="art-foot">
        <a class="art-more" href={localizePath("/artigos", locale)}>{ui.articleSeeAll}</a>
        <a class="art-share" href={shareUrl} target="_blank" rel="noopener">{ui.articleShare}</a>
      </div>
    </div>
  </article>
</main>
<Footer />

<style>
  .artpage { padding-top: 92px; }
  .art-in { max-width: clamp(760px, 74vw, 880px); padding-top: 40px; padding-bottom: 80px; }
  .art-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; row-gap: 12px; flex-wrap: wrap; margin-bottom: 26px; position: relative;
  }
  .art-back {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
    color: var(--accent);
  }
  /* Botão Traduzir */
  .art-translate { position: relative; }
  .art-translate summary {
    list-style: none; cursor: pointer; user-select: none;
    font-family: var(--font-sans); font-weight: 700; font-size: 13px;
    color: var(--heading); padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--line-strong); background: var(--panel);
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .art-translate summary::-webkit-details-marker { display: none; }
  .art-translate[open] summary,
  .art-translate summary:hover { border-color: var(--accent); color: #fff; background: var(--accent); }
  .art-langs {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 20;
    display: flex; flex-direction: column; min-width: 180px; max-width: calc(100vw - 40px);
    background: rgba(18, 12, 28, 0.97); backdrop-filter: blur(10px);
    border: 1px solid var(--line); border-radius: 12px;
    padding: 6px; box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.85);
  }
  .art-lang {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-sans); font-size: 14px; font-weight: 600;
    color: var(--cream); padding: 10px 12px; border-radius: 8px;
    transition: background 0.2s, color 0.2s;
  }
  .art-lang span { font-size: 18px; }
  .art-lang:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .art-lang.on { color: var(--accent); }

  .art-cat {
    font-family: var(--font-sans); font-weight: 800; font-size: 12.5px;
    text-transform: uppercase; letter-spacing: 0.02em; color: var(--accent);
    text-shadow: 0 0 16px var(--glow); margin-bottom: 14px;
  }
  .art-title {
    font-size: clamp(30px, 5vw, 52px); font-weight: 800; letter-spacing: -0.035em;
    line-height: 1.06; color: var(--heading); max-width: 20ch;
  }
  .art-byline {
    margin-top: 20px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 12.5px;
    color: #a98bff; text-shadow: 0 0 14px rgba(138, 92, 255, 0.55);
  }
  .art-byline strong { color: var(--heading); font-weight: 700; text-shadow: none; }
  .art-author { color: inherit; text-decoration: none; }
  .art-author:hover strong { color: var(--accent); }
  .art-dot { opacity: 0.6; }
  /* No tema claro (fundo creme), o roxo neon vira um roxo vivo e legível. */
  :root[data-theme="light"] .art-byline { color: #5a24d6; text-shadow: none; }
  .art-cover {
    margin: 34px 0 12px; border-radius: 14px; overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 30px 66px -34px rgba(0, 0, 0, 0.85);
  }
  .art-cover img { display: block; width: 100%; height: auto; }

  .art-body { margin-top: 30px; }
  .art-body :global(p) {
    font-size: clamp(17px, 1.35vw, 19px); line-height: 1.78;
    color: var(--text); margin: 0 0 24px; max-width: 74ch;
    text-align: justify; hyphens: auto; -webkit-hyphens: auto;
    text-wrap: pretty; hyphenate-limit-chars: 6 3 2;
  }
  /* Em telas estreitas, justificar deixa buracos: volta ao alinhamento à esquerda. */
  @media (max-width: 620px) {
    .art-body :global(p) { text-align: left; hyphens: manual; }
  }
  .art-body :global(p:first-of-type) {
    font-size: clamp(19px, 1.6vw, 22px); line-height: 1.6; color: var(--heading); font-weight: 500;
  }
  /* H2: usa a largura toda da coluna e equilibra as linhas quando quebra.
     Um script reduz um pouco o tamanho (até --h2-min) para caber em uma linha
     e só deixa quebrar em duas quando realmente necessário. */
  .art-body :global(h2) {
    font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.16; color: var(--heading); margin: 46px 0 16px;
    text-wrap: balance;
  }
  .art-body :global(blockquote) {
    margin: 32px 0; padding: 4px 0 4px 24px; border-left: 3px solid var(--accent);
    font-size: clamp(19px, 1.7vw, 23px); line-height: 1.5; color: var(--heading); font-weight: 600;
  }
  .art-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .art-body :global(strong) { color: var(--heading); }
  .art-body :global(em) { color: var(--text); }
  .art-body :global(ul), .art-body :global(ol) { margin: 0 0 24px; padding-left: 24px; }
  .art-body :global(li) { font-size: 18px; line-height: 1.7; color: var(--text); margin-bottom: 8px; }

  .art-body :global(figure.art-fig) { margin: 34px 0; text-align: center; }
  /* As figuras NUNCA são ampliadas além da resolução nativa, para não pixelizar.
     Cada <img> traz um max-width em px igual à sua largura nativa (injetado no
     markdown), então em telas largas ela para no tamanho real e centraliza; em
     telas estreitas reduz (width:100%). width:100% + width/height reservam o
     espaço, sem salto de layout. */
  .art-body :global(figure.art-fig img) {
    display: block; width: 100%; max-width: 100%; height: auto;
    margin: 0 auto; border-radius: 12px;
    border: 1px solid var(--line);
    box-shadow: 0 24px 50px -30px rgba(0, 0, 0, 0.85);
  }
  .art-body :global(figure.art-fig figcaption) {
    margin-top: 12px; font-family: var(--font-mono); font-size: 12.5px;
    letter-spacing: 0.02em; line-height: 1.5; color: var(--ink-soft); text-align: center;
  }

  /* Bloco de fechamento: convida a continuar a conversa no post do LinkedIn. */
  .art-cta {
    margin-top: 52px; padding: clamp(24px, 3vw, 34px);
    border-radius: 16px; border: 1px solid var(--line);
    background:
      radial-gradient(130% 150% at 100% 0%, var(--glow), transparent 55%),
      var(--panel);
  }
  .art-cta-title {
    font-family: var(--font-sans); font-weight: 800;
    font-size: clamp(19px, 2.2vw, 25px); letter-spacing: -0.02em;
    line-height: 1.2; color: var(--heading); margin: 0 0 10px;
  }
  .art-cta-text {
    font-size: 15.5px; line-height: 1.62; color: var(--text);
    margin: 0 0 22px; max-width: 62ch;
  }
  .art-cta-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-sans); font-weight: 800; font-size: 14.5px;
    color: #fff; background: var(--accent);
    padding: 13px 24px; border-radius: 999px;
    box-shadow: 0 16px 34px -14px var(--glow);
    transition: transform 0.25s ease, box-shadow 0.3s ease, filter 0.25s ease;
  }
  .art-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 22px 44px -16px var(--glow); filter: brightness(1.08); }
  .art-cta-btn span { font-size: 15px; }

  /* "Veja também": circulação interna, estilo Top Stories. */
  .art-related { margin-top: 56px; padding-top: 34px; border-top: 1px solid var(--line); }
  .art-related-title {
    font-family: var(--font-sans); font-weight: 800;
    font-size: clamp(18px, 2vw, 22px); letter-spacing: -0.02em;
    line-height: 1.2; color: var(--heading); margin: 0 0 22px;
  }
  .art-related-grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px;
  }
  /* Cards mais compactos neste contexto (mini galeria). */
  .art-related-grid :global(.art-body) { padding: 16px 18px 18px; gap: 9px; }
  .art-related-grid :global(.art-body h3) { font-size: 16px; line-height: 1.25; }
  .art-related-grid :global(.art-ex) { display: none; }

  /* Mobile: faixa horizontal com "peek" do próximo card (Top Stories). */
  @media (max-width: 620px) {
    .art-related-grid {
      display: flex; grid-template-columns: none; gap: 14px;
      overflow-x: auto; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; padding-bottom: 6px;
    }
    .art-related-grid::-webkit-scrollbar { display: none; }
    .art-related-grid :global(.artcard) { flex: 0 0 82%; scroll-snap-align: start; }
  }

  .art-foot {
    margin-top: 40px; padding-top: 26px; border-top: 1px solid var(--line);
    display: flex; gap: 24px; flex-wrap: wrap; align-items: center;
  }
  .art-more { color: var(--accent); font-weight: 800; font-size: 14px; text-shadow: 0 0 16px var(--glow); }
  .art-share { color: var(--ink-soft); font-weight: 700; font-size: 14px; transition: color 0.3s; }
  .art-share:hover { color: var(--accent); }
  @media (max-width: 620px) { .artpage { padding-top: 94px; } .art-in { padding-bottom: 60px; } }
</style>

<script>
  // Diagramação dos H2: mantém o tamanho maior que o corpo, mas reduz um pouco
  // (até um piso) para caber em UMA linha. Só deixa quebrar em duas quando o
  // título é longo demais mesmo no piso. Mede as linhas realmente renderizadas
  // (robusto ao carregamento tardio das fontes) e reavalia no resize.
  const MIN = 22; // nunca menor que isto (o corpo tem no máx. 19px)

  const lineCount = (el: HTMLElement) => {
    const lh = parseFloat(getComputedStyle(el).lineHeight) || 1;
    return Math.round(el.offsetHeight / lh);
  };

  const fitHeadings = () => {
    document.querySelectorAll<HTMLElement>(".art-body h2").forEach((h) => {
      h.style.fontSize = ""; // volta ao tamanho base do CSS (clamp)
      let size = parseFloat(getComputedStyle(h).fontSize);
      let guard = 0;
      // encolhe enquanto quebrar em mais de uma linha, até caber ou atingir o piso
      while (lineCount(h) > 1 && size > MIN && guard < 80) {
        size -= 0.5;
        h.style.fontSize = size + "px";
        guard++;
      }
    });
  };

  const run = () => requestAnimationFrame(fitHeadings);
  run();
  window.addEventListener("load", run);
  if ((document as any).fonts?.ready) (document as any).fonts.ready.then(run);
  // reforços para pegar fontes que carregam depois do ready inicial
  setTimeout(run, 350);
  setTimeout(run, 900);
  let tid: number | undefined;
  window.addEventListener("resize", () => {
    clearTimeout(tid);
    tid = window.setTimeout(run, 150);
  });
</script>
