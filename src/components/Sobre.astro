---
// Sobre: trajetória com autoridade, sem currículo nem autopromoção.
// TODO(asset): quando houver retrato editorial, definir `photo`
// (ex.: "/assets/retratos/ibson.jpg"). Até lá, placeholder sóbrio.
import { getContent } from "../i18n/utils";
import { t } from "../i18n/ui";
const { about } = getContent(Astro.currentLocale);
const ui = t(Astro.currentLocale);
const photo: string | null = "/assets/retratos/ibson-junior-retrato.jpg";
---

<section class="sobre" id="sobre">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerSobre}</span>
    </div>
    <div class="sobre-grid">
      <div class="sobre-photo reveal">
        <div class="fr">
          {
            photo ? (
              <img src={photo} alt="Ibson Junior, executivo de conteúdo, liderança e comunicação." width="1330" height="1400" />
            ) : (
              <div class="ph-portrait" aria-label="Retrato editorial de Ibson Junior (a chegar)">
                <span>RETRATO</span>
              </div>
            )
          }
        </div>
      </div>
      <div class="sobre-text reveal d1">
        <h2>{about.title}</h2>
        <p class="about-sub">{about.subtitle}</p>
        <div class="body">
          {about.body.map((p) => <p set:html={p} />)}
        </div>
      </div>
      <div class="about-proofs reveal">
        {
          about.microprovas.map((m) => (
            <div class="pr">
              <span class="k">{m.k}</span>
              <span class="v" set:html={m.v} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-sub {
    margin-top: 14px;
    font-size: 17px;
    color: var(--ink-soft);
    font-style: italic;
    max-width: 48ch;
  }
  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(219, 107, 255, 0.5);
    transition: color 0.25s, text-decoration-color 0.25s;
  }
  .body :global(a:hover) { color: var(--accent); text-decoration-color: var(--accent); }
  .ph-portrait {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--purple-deep), var(--night));
  }
  .ph-portrait span {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.34em;
    color: rgba(255, 255, 255, 0.5);
  }
</style>
