---
// Hub de tema (/temas/<slug>/): página-pilar que agrupa os artigos de um tema,
// com H1, tese e a lista de artigos. Cluster forte + internal linking + o "termo
// que mostra todos os artigos" de um assunto. Conteúdo em `themeHub` (clusters.ts).
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import ArticleCard from "./ArticleCard.astro";
import { getCollection } from "astro:content";
import { localizePath, normalizeLocale, articlesCollection } from "../i18n/utils";
import { t } from "../i18n/ui";
import { themeLabel, themeHub, articleTheme, type Theme } from "../data/clusters";

const { theme } = Astro.props as { theme: Theme };
const locale = normalizeLocale(Astro.currentLocale);
const ui = t(locale);
const label = themeLabel[locale][theme];
const hub = themeHub[locale][theme];
const libHref = localizePath("/artigos", locale);

const all = (await getCollection(articlesCollection(locale)))
  .filter((a) => articleTheme[a.id] === theme)
  .sort((a, b) => b.data.dateISO.localeCompare(a.data.dateISO));
---

<Nav />
<main id="top" class="hubpage">
  <article class="wrap hub-in">
    <a class="hub-back" href={libHref}>‹ {ui.artigosKicker}</a>
    <div class="hub-kicker">{ui.themeLabel}</div>
    <h1 class="hub-h1">{label}</h1>
    <p class="hub-intro">{hub.intro}</p>

    <div class="hub-grid">
      {
        all.map((a) => (
          <ArticleCard
            slug={a.id}
            title={a.data.title}
            cover={a.data.cover}
            category={a.data.category}
            readingTime={a.data.readingTime}
            date={a.data.date}
          />
        ))
      }
    </div>

    <div class="hub-foot">
      <a class="hub-all" href={libHref}>{ui.artigosSeeAll} →</a>
    </div>
  </article>
</main>
<Footer />

<style>
  .hubpage { padding-top: 92px; }
  .hub-in { max-width: clamp(760px, 88vw, 1160px); padding-top: 40px; padding-bottom: 90px; }
  .hub-back {
    display: block; width: fit-content; font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.06em; color: var(--accent); margin-bottom: 28px;
  }
  .hub-kicker {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent); text-shadow: 0 0 16px var(--glow); margin-bottom: 14px;
  }
  .hub-h1 {
    font-size: clamp(36px, 6vw, 68px); font-weight: 800; letter-spacing: -0.04em;
    line-height: 1.03; color: var(--heading); margin: 0; max-width: 18ch;
  }
  .hub-intro {
    margin-top: 20px; margin-bottom: 44px; font-size: clamp(17px, 1.7vw, 22px);
    line-height: 1.6; color: var(--text); max-width: 62ch;
  }
  .hub-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .hub-foot { margin-top: 44px; }
  .hub-all { font-family: var(--font-sans); font-weight: 800; font-size: 15px; color: var(--accent); text-shadow: 0 0 16px var(--glow); }
  @media (max-width: 980px) { .hub-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .hub-grid { grid-template-columns: 1fr; } .hubpage { padding-top: 84px; } }
</style>
