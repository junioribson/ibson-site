---
// Mentoria: bloco de ALTO IMPACTO visual. Fonte display redonda e grossa
// (Poppins) com palavra em gradiente, brilhos de fundo, cards com borda em
// gradiente + número gigante vazado, "para quem é" como tags e micro-interações.
// Só CSS (não pesa no PageSpeed). Tokens -> funciona nos 2 temas. Responsivo.
import { getContent } from "../i18n/utils";
import { t } from "../i18n/ui";
const { mentorship: m } = getContent(Astro.currentLocale);
const ui = t(Astro.currentLocale);

// Destaca (gradiente) as 2 últimas palavras do título e a 2ª frase da âncora.
const titleWords = m.title.trim().replace(/\.$/, "").split(" ");
const titleHead = titleWords.slice(0, -2).join(" ");
const titleTail = titleWords.slice(-2).join(" ");
const [pullA, ...pullRest] = m.intro[0].split(/(?<=\.)\s+/);
const pullB = pullRest.join(" ");
---

<section class="ment" id="mentoria">
  <div class="ment-glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="ment-top reveal">
      <div class="ment-top-l">
        <div class="shead">
          <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerMentoria}</span>
        </div>
        <h2 class="ment-h2">{titleHead} <span class="grad">{titleTail}</span>.</h2>
      </div>
      <div class="ment-top-r">
        <div class="ment-top-r-main">
          <p class="ment-sub">{m.subtitle}</p>
          <p class="ment-pull">{pullA}{pullB && <> <span class="grad">{pullB}</span></>}</p>
        </div>
        <span class="ment-note ment-note-top">{m.note}</span>
      </div>
    </div>

    <div class="ment-grid">
      <article class="ment-card ment-card-what reveal">
        <span class="ment-num" aria-hidden="true">01</span>
        <span class="ment-card-k">{ui.mentWhatIs}</span>
        <p class="ment-lead-p">{m.whatIs[0]}</p>
        {m.whatIs.slice(1).map((p) => <p>{p}</p>)}
      </article>

      <article class="ment-card ment-card-who reveal d1">
        <span class="ment-num" aria-hidden="true">02</span>
        <span class="ment-card-k">{ui.mentWhoFor}</span>
        <div class="ment-who">
          {m.whoFor.map((i) => <span>{i}</span>)}
        </div>
      </article>
    </div>

    <div class="ment-topics reveal">
      <span class="ment-topics-k">{ui.mentTopics}</span>
      <div class="ment-chips">
        {m.topics.map((tp) => <span class="ment-chip">{tp}</span>)}
      </div>
    </div>

    <div class="ment-cta reveal">
      <a class="btn btn-violet" href={m.cta.href}>{m.cta.label}</a>
    </div>
  </div>
</section>

<style>
  .ment { position: relative; overflow: hidden; padding: clamp(88px, 12vh, 140px) 0; isolation: isolate; }
  .ment::before { display: none; } /* remove o orb global; usamos o .ment-glow */
  .ment > .wrap { position: relative; z-index: 2; }

  /* Brilhos de fundo (formas suaves, movimento lento). Puro CSS. */
  .ment-glow {
    position: absolute; inset: -10% -6%; z-index: 0; pointer-events: none;
    background:
      radial-gradient(38vw 38vw at 82% 8%, color-mix(in srgb, var(--accent) 26%, transparent), transparent 60%),
      radial-gradient(30vw 30vw at 6% 96%, rgba(201, 79, 138, 0.18), transparent 60%);
    filter: blur(30px);
    opacity: 0.9;
    animation: ment-drift 26s ease-in-out infinite alternate;
  }
  :root[data-theme="light"] .ment-glow { opacity: 0.5; }
  @keyframes ment-drift {
    0% { transform: translate3d(-2%, 1%, 0) scale(1); }
    100% { transform: translate3d(3%, -2%, 0) scale(1.08); }
  }

  /* Gradiente reutilizável (violeta -> magenta), legível nos 2 temas. */
  .grad {
    background: linear-gradient(100deg, #7b3fe4 0%, #b14bff 42%, #d8568f 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: grad-slide 7s linear infinite;
  }
  @keyframes grad-slide { to { background-position: 200% 0; } }

  /* Cabeçalho de impacto: título à esquerda; direita ÚTIL (subtítulo + gancho),
     alinhada à altura do título, sem espaço morto. */
  .ment-top {
    display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 54px; align-items: start; margin-bottom: 52px;
  }
  .ment-top-l .shead { margin-bottom: 22px; }
  .ment-top-r { display: flex; flex-direction: column; justify-content: space-between; gap: 26px; padding-top: 6px; }
  .ment-top-r-main { display: flex; flex-direction: column; gap: 20px; }
  .ment-note-top { max-width: 42ch; border-top: 1px solid var(--line); padding-top: 16px; }
  .ment-h2 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.6vw, 68px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--heading);
    max-width: 15ch;
  }
  .ment-sub { color: var(--text-soft); font-size: 16.5px; line-height: 1.62; max-width: 44ch; }

  /* Frase-âncora (gancho), redonda e grossa */
  .ment-pull {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.5vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--heading);
    margin: 0;
  }

  /* Grade de cards com BORDA EM GRADIENTE + número gigante vazado */
  .ment-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 22px; margin: 46px 0 46px; }
  .ment-card {
    position: relative;
    border-radius: 24px;
    padding: clamp(28px, 3vw, 42px);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--accent) 8%, var(--panel)), var(--panel)) padding-box,
      linear-gradient(140deg, color-mix(in srgb, var(--accent) 70%, transparent), color-mix(in srgb, #d8568f 40%, transparent) 45%, transparent 72%) border-box;
    border: 1.5px solid transparent;
    overflow: hidden;
    transition: transform 0.5s var(--e), box-shadow 0.5s;
  }
  .ment-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 40px 80px -44px rgba(10, 2, 26, 0.7), 0 0 70px -34px var(--glow);
  }
  .ment-num {
    position: absolute; top: 18px; right: 26px;
    font-family: var(--font-display); font-size: clamp(54px, 6vw, 82px); font-weight: 800; line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent) 55%, transparent);
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.5s var(--e), transform 0.6s var(--e);
  }
  .ment-card:hover .ment-num { opacity: 0.85; transform: translateY(-3px); }
  .ment-card-k {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 18px; position: relative; z-index: 1;
  }
  .ment-card-k::before { content: ""; width: 26px; height: 2px; border-radius: 2px; background: currentColor; opacity: 0.7; }
  .ment-card-what p { font-size: 15px; line-height: 1.7; color: var(--text-soft); margin-bottom: 12px; max-width: 46ch; }
  .ment-card-what p:last-child { margin-bottom: 0; }
  .ment-lead-p { font-size: 16.5px !important; line-height: 1.55 !important; color: var(--heading) !important; font-weight: 500; }

  /* "Para quem é" como nuvem de TAGS (mais visual que uma lista) */
  .ment-who { display: flex; flex-wrap: wrap; gap: 9px; }
  .ment-who span {
    font-size: 13.5px; line-height: 1;
    padding: 10px 14px; border-radius: 11px;
    border: 1px solid var(--line); background: var(--panel-2);
    color: var(--text-soft);
    transition: transform 0.22s var(--e), color 0.25s, border-color 0.25s, background 0.25s;
  }
  .ment-who span:hover {
    transform: translateY(-3px);
    color: var(--heading);
    border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
    background: color-mix(in srgb, var(--accent) 12%, var(--panel-2));
  }

  /* Temas (pills) */
  .ment-topics { margin-bottom: 46px; }
  .ment-topics-k {
    display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 18px;
  }
  .ment-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .ment-chip {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.02em;
    padding: 10px 17px; border-radius: 999px;
    border: 1px solid var(--line-strong); background: var(--panel); color: var(--text-soft);
    cursor: default;
    transition: transform 0.2s var(--e), color 0.25s, border-color 0.25s, background 0.25s, box-shadow 0.25s;
  }
  .ment-chip:hover {
    transform: translateY(-3px); color: #fff; border-color: var(--accent); background: var(--accent);
    box-shadow: 0 12px 28px -14px var(--glow);
  }

  /* CTA */
  .ment-cta { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .ment-note { font-family: var(--font-mono); font-size: 12px; color: var(--text-dim); max-width: 48ch; line-height: 1.5; }

  /* Responsivo */
  @media (max-width: 960px) {
    .ment-top { grid-template-columns: 1fr; gap: 22px; }
    .ment-grid { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 560px) { .ment-cta { gap: 16px; } .ment-num { top: 14px; right: 18px; } }
  @media (prefers-reduced-motion: reduce) {
    .ment-glow, .grad { animation: none; }
  }
</style>
