---
// Lua realista em SVG: sombreamento esférico (luz no alto à esquerda),
// mares lunares, textura de crateras (turbulência) e brilho suave.
// Autocontido e escalável. Substitui a antiga lua chapada em CSS.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class={className} aria-hidden="true">
  <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="moon-sphere" cx="38%" cy="33%" r="72%">
        <stop offset="0%" stop-color="#fffdf6" />
        <stop offset="42%" stop-color="#f4ecd9" />
        <stop offset="72%" stop-color="#ddd0b4" />
        <stop offset="100%" stop-color="#a2926f" />
      </radialGradient>
      <radialGradient id="moon-limb" cx="38%" cy="33%" r="72%">
        <stop offset="0%" stop-color="rgba(0,0,0,0)" />
        <stop offset="74%" stop-color="rgba(40,28,10,0)" />
        <stop offset="100%" stop-color="rgba(40,28,10,0.55)" />
      </radialGradient>
      <radialGradient id="moon-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="rgba(245,236,210,0.55)" />
        <stop offset="55%" stop-color="rgba(245,236,210,0.14)" />
        <stop offset="100%" stop-color="rgba(245,236,210,0)" />
      </radialGradient>
      <filter id="moon-craters" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" seed="7" result="n" />
        <feColorMatrix in="n" type="saturate" values="0" result="g" />
        <feComponentTransfer in="g" result="c">
          <feFuncA type="linear" slope="0.5" intercept="0" />
        </feComponentTransfer>
      </filter>
      <clipPath id="moon-clip"><circle cx="100" cy="100" r="88" /></clipPath>
    </defs>

    <!-- brilho externo -->
    <circle cx="100" cy="100" r="128" fill="url(#moon-glow)" />

    <g clip-path="url(#moon-clip)">
      <!-- disco -->
      <circle cx="100" cy="100" r="88" fill="url(#moon-sphere)" />

      <!-- mares lunares (posições evocando a face visível) -->
      <g fill="#9c8a68" opacity="0.5" style="filter:blur(3px)">
        <ellipse cx="82" cy="72" rx="26" ry="22" />
        <ellipse cx="112" cy="66" rx="17" ry="15" />
        <ellipse cx="122" cy="92" rx="15" ry="18" />
        <ellipse cx="76" cy="104" rx="20" ry="16" />
        <ellipse cx="138" cy="78" rx="9" ry="9" />
        <ellipse cx="98" cy="120" rx="12" ry="10" />
      </g>
      <g fill="#8a7859" opacity="0.35" style="filter:blur(2px)">
        <ellipse cx="86" cy="80" rx="14" ry="12" />
        <ellipse cx="118" cy="84" rx="8" ry="9" />
      </g>

      <!-- textura de crateras -->
      <rect x="0" y="0" width="200" height="200" filter="url(#moon-craters)"
            opacity="0.16" style="mix-blend-mode:multiply" />
      <rect x="0" y="0" width="200" height="200" filter="url(#moon-craters)"
            opacity="0.10" style="mix-blend-mode:screen" />

      <!-- crateras pontuais com bordas iluminadas -->
      <g>
        <circle cx="70" cy="140" r="9" fill="#b7a684" opacity="0.5" />
        <circle cx="69" cy="139" r="7.5" fill="#8c7a5b" opacity="0.45" />
        <circle cx="132" cy="128" r="6" fill="#b7a684" opacity="0.5" />
        <circle cx="131" cy="127" r="4.5" fill="#8c7a5b" opacity="0.4" />
        <circle cx="150" cy="104" r="4" fill="#8c7a5b" opacity="0.4" />
      </g>

      <!-- limb darkening (arredonda a esfera) -->
      <circle cx="100" cy="100" r="88" fill="url(#moon-limb)" />
    </g>
  </svg>
</div>
