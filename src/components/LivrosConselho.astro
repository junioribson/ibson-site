---
// Livros & Conselho: livro "Conselho Diário" (coautor) + Conselheiro Consultivo.
// Defina `cover` de cada card quando as imagens chegarem.
interface Card {
  cover?: string | null;
  kicker: string;
  title: string;
  text: string;
  phLabel: string;
}

const cards: Card[] = [
  {
    cover: null,
    kicker: "Co-participação · Livro",
    title: "Conselho Diário, 365 Insights Estratégicos",
    text: "Coautor de uma obra que reúne um ano de provocações estratégicas, um insight por dia para quem decide.",
    phLabel: "CAPA DO LIVRO",
  },
  {
    cover: null,
    kicker: "Formação · Board Academy",
    title: "Conselheiro Consultivo",
    text: "Formado pela Board Academy e preparado para atuar também como conselheiro administrativo ou fiscal, levando visão estratégica para a mesa de decisão.",
    phLabel: "BOARD ACADEMY",
  },
];
---

<section class="repo" id="repertorio">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">Livros &amp; Conselho</span>
    </div>
    <div class="tcards">
      {
        cards.map((c, i) => (
          <div class={`tcard reveal${i === 1 ? " d1" : ""}`}>
            <div class="ph">
              {c.cover ? (
                <img src={c.cover} alt={c.title} />
              ) : (
                <div class="ph-repo">
                  <span>{c.phLabel}</span>
                </div>
              )}
            </div>
            <div class="tx">
              <div class="tk">{c.kicker}</div>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ph-repo {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, var(--purple-deep), var(--night));
  }
  .ph-repo span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.5);
  }
</style>
