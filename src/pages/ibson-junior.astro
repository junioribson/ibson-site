---
import Base from "../layouts/Base.astro";
import IbsonJunior from "../components/IbsonJunior.astro";
import { getContent, normalizeLocale, htmlLang, localizePath } from "../i18n/utils";
import { t } from "../i18n/ui";

const locale = normalizeLocale(Astro.currentLocale);
const { identity } = getContent(locale);
const ui = t(locale);
const url = new URL(Astro.url.pathname, "https://ibsonjunior.com.br").href;
const homeAbs = new URL(localizePath("/", locale), "https://ibsonjunior.com.br").href;
const PERSON_ID = "https://ibsonjunior.com.br/#person";

// AboutPage sobre a MESMA entidade (#person). Reforça, não cria uma nova.
const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${url}#about`,
      url,
      name: "Ibson Junior",
      inLanguage: htmlLang(locale),
      isPartOf: { "@id": "https://ibsonjunior.com.br/#website" },
      mainEntity: { "@id": PERSON_ID },
      about: { "@id": PERSON_ID },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: ui.breadcrumbHome, item: homeAbs },
        { "@type": "ListItem", position: 2, name: "Ibson Junior", item: url },
      ],
    },
  ],
};
---

<Base
  title={identity.seoTitle}
  description={identity.seoDescription}
  ogTitle={identity.socialTitle}
  ogDescription={identity.seoDescription}
  ogImage={`https://ibsonjunior.com.br${identity.portrait}`}
  ogType="profile"
  jsonLd={aboutSchema}
>
  <IbsonJunior />
</Base>
