---
// Artigos como biblioteca autoral, não blog. Reforçam autoridade.
// TODO(links): trocar url de cada artigo pelo link definitivo no LinkedIn.
import { articles } from "../data/content";
---

<section class="arts" id="artigos">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">Artigos</span>
    </div>
    <div class="arts-head reveal">
      <h2>{articles.title}</h2>
      <div class="meta">Publicados no LinkedIn ↗</div>
    </div>
    <p class="arts-intro reveal">{articles.intro}</p>

    <div class="arts-lib">
      {
        articles.list.map((a) => (
          <a class="libcard reveal" href={a.url} target="_blank" rel="noopener">
            <div class="lib-meta">
              <span class="lib-cat">{a.category}</span>
              <span class="lib-time">{a.date} · {a.readingTime}</span>
            </div>
            <h3>{a.title}</h3>
            <p>{a.summary}</p>
            <span class="lib-read">Ler artigo ↗</span>
          </a>
        ))
      }
    </div>

    <div class="arts-foot reveal">
      <a href={articles.allUrl} target="_blank" rel="noopener">
        Ver todos no LinkedIn <span>↗</span>
      </a>
    </div>
  </div>
</section>
