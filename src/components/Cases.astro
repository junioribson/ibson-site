---
// Cases como prova de repertório: contexto, decisão, o que foi construído,
// prova e aprendizado. Números como prova, não como espetáculo.
import { getContent } from "../i18n/utils";
import { t as tr } from "../i18n/ui";
const { cases, archetypes } = getContent(Astro.currentLocale);
const ui = tr(Astro.currentLocale);
const { wolflife: w, tiktok: t, footmarketing: f } = cases;
---

<section class="cases" id="cases">
  <div
    class="arch-layer on-light arch-bottom-r"
    style={`--arch-img:url('${archetypes.wolf.src}');--arch-tint:var(--purple);--arch-opacity:.08`}
    aria-hidden="true"
  >
  </div>
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerCases}</span>
    </div>
    <div class="cases-head reveal">
      <h2>{cases.title}</h2>
      <p>{cases.subtitle}</p>
    </div>

    <!-- Case 1: WolfLife -->
    <div class="feat reveal">
      <div class="fglow" aria-hidden="true"></div>
      <div class="fl">
        <div class="fk-row">
          <img class="feat-logo" src="/assets/logo/wolflife.png" alt="WolfLife" width="460" height="447" loading="lazy" />
        </div>
        <div class="fk" style="margin-top:16px;color:#9c8aa8">{w.tag}</div>
        <div class="fstats" style="margin-top:26px">
          {w.provas.map((p) => (
            <div class="fs"><div class="n">{p.n}</div><div class="t">{p.t}</div></div>
          ))}
        </div>
      </div>
      <div class="fr-ctx">
        {w.body.map((p) => <p>{p}</p>)}
        <div class="learn"><b>O que fica.</b> {w.aprendizado}</div>
        <a class="fbtn" href={w.cta.href} target="_blank" rel="noopener" style="margin-top:22px">
          {w.cta.label} ↗
        </a>
      </div>
    </div>

    <!-- Subcase: TikTok -->
    <div class="subcase reveal">
      <div class="subcase-left">
        <svg class="tiktok-logo" viewBox="0 0 48 48" role="img" aria-label="TikTok" xmlns="http://www.w3.org/2000/svg">
          <path class="tk-c" d="M33.5 8.2c1.3 2.4 3.4 4.2 6 4.9v6.3c-2.5-.1-4.9-.9-7-2.3v10.2c0 5.9-4.8 10.7-10.7 10.7S11.1 33.4 11.1 27.5 15.9 16.8 21.8 16.8c.5 0 1 0 1.5.1v6.5c-.5-.2-1-.2-1.5-.2-2.4 0-4.3 1.9-4.3 4.3s1.9 4.3 4.3 4.3 4.3-1.9 4.3-4.3V6.5h6.4c0 .6.1 1.2.2 1.7z"/>
          <path class="tk-r" d="M33.5 8.2c1.3 2.4 3.4 4.2 6 4.9v6.3c-2.5-.1-4.9-.9-7-2.3v10.2c0 5.9-4.8 10.7-10.7 10.7S11.1 33.4 11.1 27.5 15.9 16.8 21.8 16.8c.5 0 1 0 1.5.1v6.5c-.5-.2-1-.2-1.5-.2-2.4 0-4.3 1.9-4.3 4.3s1.9 4.3 4.3 4.3 4.3-1.9 4.3-4.3V6.5h6.4c0 .6.1 1.2.2 1.7z"/>
          <path class="tk-w" d="M33.5 8.2c1.3 2.4 3.4 4.2 6 4.9v6.3c-2.5-.1-4.9-.9-7-2.3v10.2c0 5.9-4.8 10.7-10.7 10.7S11.1 33.4 11.1 27.5 15.9 16.8 21.8 16.8c.5 0 1 0 1.5.1v6.5c-.5-.2-1-.2-1.5-.2-2.4 0-4.3 1.9-4.3 4.3s1.9 4.3 4.3 4.3 4.3-1.9 4.3-4.3V6.5h6.4c0 .6.1 1.2.2 1.7z"/>
        </svg>
        <div class="subcase-nums">
          <div class="num">9 <em>Bi+</em></div>
          <div class="num-sub">visualizações</div>
        </div>
      </div>
      <div>
        <div class="sk">{t.name}</div>
        <p class="st">{t.body}</p>
      </div>
    </div>

    <!-- Case 2: Futmarketing -->
    <div class="casecard reveal">
      <img class="cc-logo" src="/assets/logo/futmarketing.png" alt="Futmarketing" width="360" height="334" loading="lazy" />
      <div class="cc-tag">{f.tag}</div>
      <h3>{f.name}</h3>
      {f.body.map((p) => <p>{p}</p>)}
      <a class="cc-cta" href={f.cta.href} target="_blank" rel="noopener">{f.cta.label} ↗</a>
    </div>
  </div>
</section>
