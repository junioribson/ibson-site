---
// HERO v2: composição editorial cinematográfica.
// Campo de luz reativo ao cursor, tipografia com revelação em máscara,
// marca como elemento gráfico, letreiro (marquee) de território.
import { hero } from "../data/content";
const keywords = ["Consciência", "Decisão", "Liderança", "Conteúdo", "IA", "Cultura", "Responsabilidade", "Governança"];
---

<section class="hx" id="hero">
  <!-- Campo de luz (parallax no contêiner; orbs flutuam por dentro) -->
  <div class="hx-field" aria-hidden="true" data-depth="26">
    <div class="hx-orb o1"></div>
    <div class="hx-orb o2"></div>
    <div class="hx-orb o3"></div>
    <div class="hx-orb o4"></div>
  </div>

  <!-- Marca como motivo gráfico (gira; parallax no wrapper) -->
  <div class="hx-mark-wrap" aria-hidden="true" data-depth="-18">
    <svg class="hx-mark" viewBox="0 0 100 100">
      <path d="M50 8 L90 88 L67 88 L50 55 L33 88 L10 88 Z" />
      <path d="M50 30 L67 66 L50 66 Z" opacity="0.5" />
    </svg>
  </div>

  <div class="hx-rail" aria-hidden="true"><span>MANIFESTO · 2026</span></div>

  <div class="wrap hx-in">
    <div class="hx-eye">
      <span class="hx-dot"></span>
      <span class="hx-k">{hero.topline}</span>
    </div>

    <h1 class="hx-h1">
      <span class="ln"><i style="--d:.05s">Consciência, decisão</i></span>
      <span class="ln"><i style="--d:.14s">e responsabilidade</i></span>
      <span class="ln"><i style="--d:.24s" class="hx-accent">em tempos complexos.</i></span>
    </h1>

    <p class="hx-sub">{hero.subheadline}</p>

    <div class="hx-cta">
      <a class="hx-btn hx-btn-fill" href={hero.ctas.primary.href}>
        <span>{hero.ctas.primary.label}</span>
      </a>
      <a class="hx-btn hx-btn-line" href={hero.ctas.secondary.href}>
        <span>{hero.ctas.secondary.label}</span>
      </a>
    </div>
  </div>

  <!-- Letreiro de território -->
  <div class="hx-marquee" aria-hidden="true">
    <div class="hx-track">
      {[0, 1].map(() => (
        <div class="hx-set">
          {keywords.map((k) => (<span class="hx-word">{k}<b>·</b></span>))}
        </div>
      ))}
    </div>
  </div>

  <a class="hx-scroll" href="#tese" aria-label="Descer">
    <span>Role</span>
    <span class="hx-scroll-line"></span>
  </a>
</section>

<style>
  .hx {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 150px 0 0;
    background:
      radial-gradient(120% 90% at 82% 4%, rgba(123, 87, 240, 0.30), transparent 55%),
      radial-gradient(90% 80% at 2% 104%, rgba(176, 146, 94, 0.16), transparent 55%),
      linear-gradient(168deg, #1c1030 0%, #150826 52%, #100718 100%);
  }

  /* Campo de luz */
  .hx-field { position: absolute; inset: -10%; z-index: 0; pointer-events: none; filter: blur(60px); }
  .hx-orb { position: absolute; border-radius: 50%; will-change: transform; }
  .o1 { width: 44vw; height: 44vw; right: -6%; top: -12%; background: radial-gradient(circle, rgba(123, 87, 240, 0.6), transparent 66%); animation: float1 26s ease-in-out infinite alternate; }
  .o2 { width: 34vw; height: 34vw; left: -8%; bottom: -14%; background: radial-gradient(circle, rgba(176, 146, 94, 0.5), transparent 66%); animation: float2 32s ease-in-out infinite alternate; }
  .o3 { width: 30vw; height: 30vw; right: 20%; bottom: -18%; background: radial-gradient(circle, rgba(201, 79, 138, 0.34), transparent 64%); animation: float1 22s ease-in-out infinite alternate-reverse; }
  .o4 { width: 22vw; height: 22vw; left: 32%; top: -8%; background: radial-gradient(circle, rgba(68, 2, 111, 0.4), transparent 66%); animation: float2 28s ease-in-out infinite alternate; }
  @keyframes float1 { to { transform: translate(-8%, 8%) scale(1.15); } }
  @keyframes float2 { to { transform: translate(9%, -7%) scale(1.12); } }

  /* Marca gráfica: wrapper posiciona (sem transform), svg gira */
  .hx-mark-wrap {
    position: absolute;
    right: -6vw;
    top: 50%;
    width: min(58vw, 760px);
    height: min(58vw, 760px);
    margin-top: calc(min(58vw, 760px) / -2);
    z-index: 1;
    pointer-events: none;
    will-change: transform;
  }
  .hx-mark {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.10;
    animation: markspin 100s linear infinite;
    transform-origin: 50% 50%;
  }
  .hx-mark path { fill: var(--purple); stroke: none; }
  @keyframes markspin { to { transform: rotate(360deg); } }

  /* Rail vertical */
  .hx-rail {
    position: absolute;
    left: 22px;
    top: 50%;
    z-index: 3;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.42em;
    color: var(--ink-soft);
    opacity: 0.7;
  }

  .hx-in { position: relative; z-index: 3; max-width: 1120px; }

  .hx-eye { display: flex; align-items: center; gap: 14px; margin-bottom: 30px; opacity: 0; transform: translateY(12px); animation: rise .8s var(--e) .1s forwards; }
  .hx-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--violet); box-shadow: 0 0 0 5px rgba(91, 46, 230, 0.14); }
  .hx-k { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ink-soft); }

  .hx-h1 {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(42px, 8.2vw, 128px);
    line-height: 0.94;
    letter-spacing: -0.05em;
    max-width: 15ch;
  }
  .hx-h1 .ln { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .hx-h1 .ln > i {
    display: inline-block;
    font-style: normal;
    transform: translateY(112%);
    animation: linereveal 1.05s cubic-bezier(0.16, 1, 0.3, 1) var(--d) forwards;
  }
  .hx-accent {
    background: linear-gradient(100deg, var(--violet) 0%, var(--magenta) 42%, var(--violet-2) 70%, var(--violet) 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: linereveal 1.05s cubic-bezier(0.16, 1, 0.3, 1) var(--d) forwards, accent-slide 7s linear infinite;
  }
  @keyframes linereveal { to { transform: none; } }

  .hx-sub {
    margin-top: 34px;
    max-width: 52ch;
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.55;
    color: #c8b9d6;
    font-weight: 500;
    opacity: 0;
    transform: translateY(14px);
    animation: rise .9s var(--e) .5s forwards;
  }

  .hx-cta { margin-top: 40px; display: flex; gap: 16px; flex-wrap: wrap; opacity: 0; transform: translateY(14px); animation: rise .9s var(--e) .62s forwards; }
  .hx-btn {
    position: relative;
    overflow: hidden;
    font-weight: 700;
    font-size: 15px;
    padding: 17px 30px;
    border-radius: 40px;
    transition: transform .3s var(--e), box-shadow .3s, color .3s;
  }
  .hx-btn span { position: relative; z-index: 2; }
  .hx-btn-fill { background: var(--violet); color: #fff; }
  .hx-btn-fill::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(100deg, var(--violet-2), var(--magenta)); transform: scaleX(0); transform-origin: left; transition: transform .45s var(--e); }
  .hx-btn-fill:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -16px rgba(91, 46, 230, 0.6); }
  .hx-btn-fill:hover::before { transform: scaleX(1); }
  .hx-btn-line { border: 1.5px solid rgba(255, 255, 255, 0.3); color: var(--cream); }
  .hx-btn-line:hover { border-color: #fff; background: rgba(255, 255, 255, 0.06); transform: translateY(-3px); }

  /* Marquee */
  .hx-marquee { position: absolute; left: 0; right: 0; bottom: 84px; z-index: 2; overflow: hidden; opacity: 0; animation: rise 1s var(--e) .9s forwards; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .hx-track { display: flex; width: max-content; animation: marquee 34s linear infinite; }
  .hx-set { display: flex; }
  .hx-word { font-family: var(--font-sans); font-weight: 800; font-size: clamp(20px, 2.6vw, 34px); letter-spacing: -0.02em; color: rgba(255, 255, 255, 0.13); white-space: nowrap; padding: 0 6px; }
  .hx-word b { color: var(--violet); margin: 0 22px; font-weight: 800; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .hx-scroll { position: absolute; right: var(--gut); bottom: 30px; z-index: 3; display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-soft); opacity: 0; animation: rise 1s var(--e) 1s forwards; }
  .hx-scroll-line { width: 40px; height: 1px; background: rgba(255, 255, 255, 0.4); position: relative; overflow: hidden; }
  .hx-scroll-line::after { content: ""; position: absolute; inset: 0; background: var(--violet); animation: slide 1.8s var(--e) infinite; }

  @keyframes rise { to { opacity: 1; transform: none; } }

  @media (max-width: 900px) {
    .hx-rail { display: none; }
    .hx-mark { opacity: 0.06; right: -24vw; }
    .hx-marquee { bottom: 70px; }
  }
  @media (max-width: 620px) {
    .hx { padding-top: 120px; }
    .hx-h1 { font-size: clamp(38px, 12vw, 60px); }
    .hx-cta .hx-btn { flex: 1 1 auto; text-align: center; }
    .hx-marquee { display: none; }
    .hx-scroll { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hx-h1 .ln > i, .hx-eye, .hx-sub, .hx-cta, .hx-marquee, .hx-scroll { animation: none !important; opacity: 1 !important; transform: none !important; }
    .hx-track { animation: none; }
    .hx-mark { animation: none; }
  }
</style>

<script>
  // Parallax reativo ao cursor (suave, com rAF)
  const hx = document.getElementById("hero");
  if (hx && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const layers = [...hx.querySelectorAll<HTMLElement>("[data-depth]")];
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    const onMove = (e: MouseEvent) => {
      const r = hx.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width - 0.5;
      ty = (e.clientY - r.top) / r.height - 0.5;
      if (!raf) raf = requestAnimationFrame(loop);
    };
    const loop = () => {
      cx += (tx - cx) * 0.06;
      cy += (ty - cy) * 0.06;
      for (const el of layers) {
        const d = parseFloat(el.dataset.depth || "0");
        el.style.transform = `translate3d(${(-cx * d).toFixed(1)}px, ${(-cy * d).toFixed(1)}px, 0)`;
      }
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(loop);
      else raf = 0;
    };
    hx.addEventListener("mousemove", onMove);
  }
</script>
