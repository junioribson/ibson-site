---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import HubPage from "../../components/HubPage.astro";
import { normalizeLocale, htmlLang, localizePath, articlesCollection } from "../../i18n/utils";
import { t } from "../../i18n/ui";
import { themeOrder, themeSlug, themeHub, themeLabel, articleTheme } from "../../data/clusters";

export function getStaticPaths() {
  return themeOrder.map((th) => ({ params: { theme: themeSlug[th] }, props: { theme: th } }));
}

const { theme } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const ui = t(locale);
const hub = themeHub[locale][theme];
const label = themeLabel[locale][theme];
const url = new URL(Astro.url.pathname, "https://ibsonjunior.com.br").href;
const homeAbs = new URL(localizePath("/", locale), "https://ibsonjunior.com.br").href;
const libAbs = new URL(localizePath("/artigos", locale), "https://ibsonjunior.com.br").href;
const arts = (await getCollection(articlesCollection(locale)))
  .filter((a) => articleTheme[a.id] === theme)
  .sort((a, b) => b.data.dateISO.localeCompare(a.data.dateISO));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}#collection`,
      url,
      name: hub.seoTitle,
      inLanguage: htmlLang(locale),
      about: { "@id": "https://ibsonjunior.com.br/#person" },
      isPartOf: { "@id": "https://ibsonjunior.com.br/#website" },
      hasPart: arts.map((a) => ({
        "@type": "BlogPosting",
        headline: a.data.title,
        url: new URL(localizePath(`/artigos/${a.id}`, locale), "https://ibsonjunior.com.br").href,
        datePublished: a.data.dateISO,
        image: `https://ibsonjunior.com.br${a.data.cover}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: ui.breadcrumbHome, item: homeAbs },
        { "@type": "ListItem", position: 2, name: ui.artigosKicker, item: libAbs },
        { "@type": "ListItem", position: 3, name: label, item: url },
      ],
    },
  ],
};
---

<Base title={hub.seoTitle} description={hub.seoDescription} ogDescription={hub.seoDescription} jsonLd={schema}>
  <HubPage theme={theme} />
</Base>
