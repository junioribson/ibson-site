---
import Base from "../layouts/Base.astro";
import PrivacyPage from "../components/PrivacyPage.astro";
import { normalizeLocale, htmlLang, localizePath } from "../i18n/utils";
import { t } from "../i18n/ui";
import { privacyDoc } from "../data/privacy";

const locale = normalizeLocale(Astro.currentLocale);
const ui = t(locale);
const doc = privacyDoc(locale);
const url = new URL(Astro.url.pathname, "https://ibsonjunior.com.br").href;
const homeAbs = new URL(localizePath("/", locale), "https://ibsonjunior.com.br").href;
const desc = doc.intro.replace(/<[^>]+>/g, "");

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${url}#webpage`,
      url,
      name: doc.title,
      inLanguage: htmlLang(locale),
      isPartOf: { "@id": "https://ibsonjunior.com.br/#website" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: ui.breadcrumbHome, item: homeAbs },
        { "@type": "ListItem", position: 2, name: doc.title, item: url },
      ],
    },
  ],
};
---

<Base title={`${doc.title} | Ibson Junior`} description={desc} ogDescription={desc} jsonLd={schema}>
  <PrivacyPage />
</Base>
