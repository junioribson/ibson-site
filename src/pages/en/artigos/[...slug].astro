---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import ArticlePage from "../../../components/ArticlePage.astro";

export async function getStaticPaths() {
  const artigos = await getCollection("artigosEn");
  return artigos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const coverAbs = `https://ibsonjunior.com.br${d.cover}`;
---

<Base title={`${d.title} | Ibson Junior`} description={d.excerpt} ogImage={coverAbs}>
  <ArticlePage entry={entry} />
</Base>
