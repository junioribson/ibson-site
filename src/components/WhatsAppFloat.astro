---
// Balão flutuante de WhatsApp, presente em todas as páginas (vai no Base.astro).
// Abre a conversa direta com o Ibson, com mensagem inicial no idioma da página.
// z-index 50: fica sobre o conteúdo, mas atrás do menu mobile (55), da galeria
// (80) e do banner de cookies (200), para não cobrir os botões deles.
import { t } from "../i18n/ui";
import Icon from "./Icon.astro";
import { waLink } from "../data/whatsapp";
const ui = t(Astro.currentLocale);
---

<a
  class="wa-float"
  href={waLink(ui.waPrefill)}
  target="_blank"
  rel="noopener"
  aria-label={ui.waAria}
  title={ui.ctaWhats}
>
  <Icon name="whatsapp" size={30} class="wa-ic" />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 50;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3), 0 2px 6px rgba(0, 0, 0, 0.22);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .wa-float:hover {
    background: #1ebe5b;
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.36), 0 2px 6px rgba(0, 0, 0, 0.22);
  }
  .wa-float:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .wa-ic {
    width: 30px;
    height: 30px;
  }
  @media (max-width: 560px) {
    .wa-float {
      width: 54px;
      height: 54px;
      right: 15px;
      bottom: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      transition: none;
    }
    .wa-float:hover {
      transform: none;
    }
  }
</style>
