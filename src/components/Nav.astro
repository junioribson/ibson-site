---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getContent, localizePath, normalizeLocale, LANGS } from "../i18n/utils";
import { t } from "../i18n/ui";

const locale = normalizeLocale(Astro.currentLocale);
const { nav } = getContent(locale);
const ui = t(locale);
const links = nav.links;
const LINKEDIN = "https://www.linkedin.com/in/ibson-junior/";
const here = Astro.url.pathname; // preserva a página atual ao trocar de idioma
const homeHref = localizePath("/", locale);
---

<nav id="nav">
  <div class="nav-in">
    <a class="brand" href={homeHref}>
      <Logo class="brand-logo" surface="adaptive" />
      <span><b>IBSON JUNIOR</b><span class="bs">{ui.brandTagline}</span></span>
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={localizePath(l.href, locale)} data-s={l.id}>{l.label}</a>)}
    </div>
    <div class="nav-r">
      <div class="langsel" role="group" aria-label="Idioma / Language">
        {
          LANGS.map((lg) => (
            <a
              class:list={["lang", { on: lg.code === locale }]}
              href={localizePath(here, lg.code)}
              hreflang={lg.htmlLang}
              lang={lg.htmlLang}
              title={lg.label}
              aria-label={lg.label}
              data-lang={lg.code}
            >
              <span class="lang-flag">{lg.flag}</span>
              <span class="lang-code">{lg.short}</span>
            </a>
          ))
        }
      </div>
      <div class="nav-theme"><ThemeToggle /></div>
      <a class="nav-li" href={LINKEDIN} target="_blank" rel="noopener" aria-label={ui.connectLinkedin} title={ui.connectLinkedin}>
        <Icon name="linkedin" class="ic" />
      </a>
      <a class="nav-cta" href={localizePath(nav.cta.href, locale)}>{nav.cta.label}</a>
      <button class="hamb" id="hamb" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<div class="mmenu" id="mmenu">
  {links.map((l) => <a href={localizePath(l.href, locale)}><span>{l.label}</span></a>)}
  <div class="mlangs">
    {
      LANGS.map((lg) => (
        <a class:list={["mlang", { on: lg.code === locale }]} href={localizePath(here, lg.code)} data-lang={lg.code} hreflang={lg.htmlLang}>
          <span class="lang-flag">{lg.flag}</span> {lg.label}
        </a>
      ))
    }
  </div>
  <div class="mtheme"><span class="mtheme-lbl">{ui.themeLabel}</span><ThemeToggle /></div>
  <a class="mmenu-li" href={LINKEDIN} target="_blank" rel="noopener">
    <Icon name="linkedin" class="ic" /> {ui.connectLinkedin}
  </a>
  <div class="mfoot">{ui.menuTagline}</div>
</div>

<style>
  .brand-logo { color: var(--purple); }
  .nav-li {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 8px;
    border: 1px solid var(--line-strong); color: var(--text);
    transition: background 0.3s, color 0.3s, transform 0.25s var(--e), border-color 0.3s, box-shadow 0.3s;
  }
  .nav-li:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(219, 107, 255, 0.1);
    box-shadow: 0 0 20px -3px var(--glow);
    transform: translateY(-2px);
  }
  .nav-li .ic { width: 18px; height: 18px; }

  /* Seletor de idioma (bandeiras) */
  .langsel { display: inline-flex; align-items: center; gap: 2px; margin-right: 4px; }
  .lang {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 6px 8px; border-radius: 7px;
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.04em;
    color: var(--text-dim, #b9aacb); opacity: 0.72;
    transition: background 0.25s, color 0.25s, opacity 0.25s;
  }
  .lang .lang-flag { font-size: 15px; line-height: 1; }
  .lang:hover { opacity: 1; background: var(--panel-2); color: var(--heading); }
  .lang.on { opacity: 1; color: var(--heading); background: rgba(219, 107, 255, 0.16); }
  .lang.on .lang-code { color: var(--accent); }
  /* Bandeiras compactas no topo: só o ícone (o código PT/ES/EN aparece no menu mobile) */
  .lang .lang-code { display: none; }
  .lang { padding: 6px 7px; }
  .nav-theme { display: inline-flex; align-items: center; }
  @media (max-width: 1280px) {
    .nav-li { display: none; }
    .nav-theme { display: none; }
  }
  .mtheme { display: flex; align-items: center; gap: 14px; margin-top: 20px; }
  .mtheme-lbl { font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.03em; color: var(--tint); }

  /* Bandeiras no menu mobile */
  .mlangs { display: flex; flex-direction: column; gap: 12px; margin-top: 18px; }
  .mlang {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.03em;
    color: var(--tint);
  }
  .mlang .lang-flag { font-size: 20px; }
  .mlang.on { color: var(--accent); }

  .mmenu-li {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.04em;
    color: var(--tint); margin-top: 16px;
  }
  .mmenu-li .ic { width: 20px; height: 20px; }

  /* Telas bem estreitas (~360px): evita aperto/estouro do cabeçalho. */
  @media (max-width: 400px) {
    .nav-in { gap: 8px; }
    .brand { min-width: 0; }
    .brand b { font-size: 13px; }
    .langsel { gap: 0; margin-right: 0; }
    .lang { padding: 5px 5px; }
  }
</style>

<script>
  const navEl = document.getElementById("nav");
  const hamb = document.getElementById("hamb");
  const mmenu = document.getElementById("mmenu");

  const onScroll = () => {
    if (navEl) navEl.classList.toggle("scrolled", window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const closeMenu = () => {
    document.body.classList.remove("menu", "lock");
    hamb?.setAttribute("aria-expanded", "false");
  };
  hamb?.addEventListener("click", () => {
    const open = document.body.classList.toggle("menu");
    document.body.classList.toggle("lock", open);
    hamb.setAttribute("aria-expanded", String(open));
    if (open && mmenu) mmenu.scrollTop = 0; // sempre abre pelo topo
  });
  mmenu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // Link ativo conforme a seção visível (ids são iguais em todos os idiomas)
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".nav-links a")];
  const ids = navLinks.map((l) => l.dataset.s).filter(Boolean) as string[];
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          navLinks.forEach((l) => l.classList.toggle("on", l.dataset.s === e.target.id));
        }
      }),
    { rootMargin: "-45% 0px -50% 0px" }
  );
  ids
    .map((i) => document.getElementById(i))
    .filter((el): el is HTMLElement => Boolean(el))
    .forEach((s) => spy.observe(s));
</script>
