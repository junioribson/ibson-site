---
// TESE, cena central (spectacle): scroll travado (pinned) com tipografia cinética.
// A seção prende na tela; enquanto o usuário rola, o título se revela palavra a
// palavra e depois dá lugar à frase de impacto (com "critério" em destaque).
// A coreografia (pin + scrub) fica em src/scripts/motion.ts. Em mobile / sem-JS /
// prefers-reduced-motion NÃO há pin: o conteúdo aparece estático e legível.
import { getContent } from "../i18n/utils";
const { thesis } = getContent(Astro.currentLocale);
const titleWords = thesis.title.split(" ");
const closingHtml = thesis.closing.replace(/(crit[ée]rio)/i, "<em>$1</em>");
---

<section class="tese" id="tese" data-thesis>
  <div class="tese-pin">
    <div class="tese-atmos" aria-hidden="true"></div>
    <div class="wrap tese-stage" data-thesis-main>
      <span class="tese-kicker">{thesis.kicker}</span>
      <h2 class="tese-title" data-thesis-title>
        {titleWords.map((w) => (
          <span class="tw"><span>{w}</span></span>
        ))}
      </h2>
      <div class="tese-body" data-thesis-body>
        {thesis.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="tese-closing-wrap" data-thesis-closing aria-hidden="true">
      <p class="wrap tese-closing" set:html={closingHtml}></p>
    </div>
  </div>
</section>

<style>
  .tese { position: relative; background: #0b0713; }
  .tese-pin { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; }
  .tese-atmos {
    position: absolute; inset: -10%; z-index: 0;
    background:
      radial-gradient(120% 95% at 80% 26%, rgba(122, 74, 255, 0.32), transparent 58%),
      radial-gradient(85% 75% at 14% 84%, rgba(201, 79, 138, 0.18), transparent 60%),
      #0b0713;
    will-change: transform, opacity;
  }
  .tese-stage { position: relative; z-index: 2; width: 100%; }
  .tese-kicker {
    font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.28em;
    text-transform: uppercase; color: #b79bff; display: inline-block; margin-bottom: 26px;
  }
  .tese-title {
    font-weight: 800; font-size: clamp(40px, 7.4vw, 112px); line-height: 0.98;
    letter-spacing: -0.045em; color: #fff; max-width: 15ch; margin: 0;
    display: flex; flex-wrap: wrap; gap: 0 0.28em;
  }
  .tese-title .tw { display: inline-block; overflow: hidden; padding-bottom: 0.08em; }
  .tese-title .tw > span { display: inline-block; will-change: transform; }
  .tese-body { margin-top: 34px; max-width: 58ch; display: flex; flex-direction: column; gap: 16px; }
  .tese-body p { font-size: clamp(16px, 1.5vw, 20px); line-height: 1.62; color: rgba(255, 255, 255, 0.76); margin: 0; }
  .tese-closing-wrap {
    position: absolute; inset: 0; z-index: 3; display: flex; align-items: center;
    opacity: 0; pointer-events: none;
  }
  .tese-closing {
    margin: 0; font-weight: 800; font-size: clamp(32px, 5.4vw, 82px); line-height: 1.04;
    letter-spacing: -0.035em; color: #fff; max-width: 20ch;
  }
  .tese-closing em {
    font-style: normal;
    background: linear-gradient(100deg, #8b6bff, #db6bff 38%, #ff7ac0 66%, #f0a35c);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }

  /* Sem pin: mobile, sem-JS, reduced-motion. Conteúdo estático e legível. */
  @media (max-width: 900px) {
    .tese-pin { min-height: auto; padding: 88px 0; }
    .tese-title { font-size: clamp(34px, 9vw, 60px); }
    .tese-closing-wrap { position: static; opacity: 1; margin-top: 40px; }
  }
  html:not(.js-motion) .tese-title .tw > span { transform: none; }
  html:not(.js-motion) .tese-closing-wrap { position: static; opacity: 1; margin-top: 40px; }
  @media (prefers-reduced-motion: reduce) {
    .tese-title .tw > span { transform: none !important; }
    .tese-closing-wrap { position: static; opacity: 1; margin-top: 40px; }
  }
</style>
