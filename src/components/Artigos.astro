---
// Bloco de artigos na home: mostra os 3 artigos MAIS RECENTES (dinâmico, por data).
// A lista completa fica na biblioteca /artigos. Cada card abre a página no site.
import { getCollection } from "astro:content";
import { getContent, localizePath, normalizeLocale, articlesCollection } from "../i18n/utils";
import { t } from "../i18n/ui";
import ArticleCard from "./ArticleCard.astro";

const locale = normalizeLocale(Astro.currentLocale);
const { articles } = getContent(locale);
const ui = t(locale);
const latest = (await getCollection(articlesCollection(locale)))
  .sort((a, b) => b.data.dateISO.localeCompare(a.data.dateISO))
  .slice(0, 3);
---

<section class="arts" id="artigos">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.artigosKicker}</span>
    </div>
    <div class="arts-head reveal">
      <h2>{articles.title}</h2>
      <div class="meta">{ui.artigosLatest}</div>
    </div>
    <p class="arts-intro reveal">{articles.intro}</p>

    <div class="artgrid">
      {
        latest.map((a) => (
          <ArticleCard
            slug={a.id}
            title={a.data.title}
            cover={a.data.cover}
            category={a.data.category}
            readingTime={a.data.readingTime}
          />
        ))
      }
    </div>

    <div class="arts-foot reveal">
      <a href={localizePath("/artigos", locale)}>{ui.artigosSeeAll} <span>→</span></a>
    </div>
  </div>
</section>

<style>
  .artgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 980px) {
    .artgrid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .artgrid { grid-template-columns: 1fr; }
  }
</style>
