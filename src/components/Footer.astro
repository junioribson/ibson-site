---
import Logo from "./Logo.astro";
import { getContent, localizePath, normalizeLocale } from "../i18n/utils";
import { t } from "../i18n/ui";
const locale = normalizeLocale(Astro.currentLocale);
const { footer, nav } = getContent(locale);
const ui = t(locale);
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <Logo class="foot-logo" surface="dark" />
        <b>{footer.name.toUpperCase()}</b><span class="s">{footer.line}</span>
        <p>{footer.complement}</p>
      </div>
      <div class="fcol">
        <h3 class="fcol-h">{ui.footerNavigate}</h3>
        {nav.links.map((l) => <a href={localizePath(l.href, locale)}>{l.label}</a>)}
        <a href={localizePath("/ibson-junior", locale)}>{ui.footerAbout}</a>
        <a href={localizePath("/imprensa", locale)}>{ui.footerPress}</a>
      </div>
      <div class="fcol">
        <h3 class="fcol-h">{ui.footerConnect}</h3>
        <a href="https://www.linkedin.com/in/ibson-junior/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="mailto:contato@ibsonjunior.com.br">{ui.footerEmail}</a>
        <a href={localizePath("/#contato", locale)}>{ui.footerInviteTalk}</a>
        <a href={localizePath("/#contato", locale)}>{ui.footerTalkMentoring}</a>
      </div>
    </div>
    <div class="foot-base">
      <span>{ui.footerRights}</span>
      <span>{ui.footerTagline}</span>
    </div>
  </div>
</footer>

<style>
  .foot-logo { color: #fff; }
</style>
