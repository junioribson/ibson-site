---
// Mentoria: conversa estratégica de alto valor. Layout premium (cards com
// contraste e micro-interações), sem imagem de arquétipo. Só CSS: não pesa no
// PageSpeed. Funciona nos dois temas (tokens) e em todos os tamanhos.
import { getContent } from "../i18n/utils";
import { t } from "../i18n/ui";
const { mentorship: m } = getContent(Astro.currentLocale);
const ui = t(Astro.currentLocale);
const [leadFirst, ...leadRest] = m.intro;
---

<section class="ment" id="mentoria">
  <div class="wrap">
    <header class="ment-headrow reveal">
      <div>
        <div class="shead">
          <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerMentoria}</span>
        </div>
        <h2 class="ment-h2">{m.title}</h2>
      </div>
      <p class="ment-sub">{m.subtitle}</p>
    </header>

    <p class="ment-pull reveal">{leadFirst}</p>
    <div class="ment-pull-body reveal d1">
      {leadRest.map((p) => <p>{p}</p>)}
    </div>

    <div class="ment-grid">
      <article class="ment-card ment-card-what reveal">
        <span class="ment-card-k">{ui.mentWhatIs}</span>
        {m.whatIs.map((p) => <p>{p}</p>)}
      </article>
      <article class="ment-card ment-card-who reveal d1">
        <span class="ment-card-k">{ui.mentWhoFor}</span>
        <ul class="ment-who">
          {m.whoFor.map((i) => <li>{i}</li>)}
        </ul>
      </article>
    </div>

    <div class="ment-topics reveal">
      <span class="ment-topics-k">{ui.mentTopics}</span>
      <div class="ment-chips">
        {m.topics.map((tp) => <span class="ment-chip">{tp}</span>)}
      </div>
    </div>

    <div class="ment-cta reveal">
      <a class="btn btn-violet" href={m.cta.href}>{m.cta.label}</a>
      <span class="ment-note">{m.note}</span>
    </div>
  </div>
</section>

<style>
  .ment { position: relative; overflow: hidden; padding: 120px 0; }
  .ment > .wrap { position: relative; z-index: 2; }

  /* Cabeçalho: título grande à esquerda, subtítulo de apoio à direita. */
  .ment-headrow {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 30px;
  }
  .ment-headrow .shead { margin-bottom: 22px; }
  .ment-h2 {
    font-size: clamp(30px, 4.2vw, 54px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--heading);
    max-width: 16ch;
  }
  .ment-sub {
    color: var(--text-soft);
    font-size: 16.5px;
    line-height: 1.6;
    max-width: 42ch;
    padding-bottom: 6px;
  }

  /* Frase-âncora + apoio */
  .ment-pull {
    font-size: clamp(20px, 2.1vw, 27px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--heading);
    max-width: 26ch;
    margin: 6px 0 20px;
  }
  .ment-pull-body { max-width: 64ch; }
  .ment-pull-body p { font-size: 16.5px; line-height: 1.72; color: var(--text-soft); margin-bottom: 12px; }
  .ment-pull-body p:last-child { margin-bottom: 0; }

  /* Grade de cards premium */
  .ment-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 24px;
    margin: 44px 0 44px;
  }
  .ment-card {
    position: relative;
    border-radius: 20px;
    padding: clamp(26px, 3vw, 40px);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 42%),
      var(--panel);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.45s var(--e), border-color 0.35s, box-shadow 0.45s;
  }
  .ment-card::before {
    content: "";
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent 72%);
    opacity: 0.7;
  }
  .ment-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow: 0 34px 74px -42px rgba(12, 2, 30, 0.6), 0 0 60px -32px var(--glow);
  }
  .ment-card-k {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .ment-card-k::before { content: ""; width: 24px; height: 1px; background: currentColor; opacity: 0.55; }
  .ment-card-what p { font-size: 15.5px; line-height: 1.72; color: var(--text-soft); margin-bottom: 13px; }
  .ment-card-what p:last-child { margin-bottom: 0; }

  /* "Para quem é": lista elegante com marcador e movimento no hover */
  .ment-who { list-style: none; display: flex; flex-direction: column; }
  .ment-who li {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line-2);
    font-size: 15.5px;
    color: var(--text-soft);
    transition: color 0.25s, padding-left 0.3s var(--e);
  }
  .ment-who li::before {
    content: "";
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); flex: 0 0 auto;
    box-shadow: 0 0 10px var(--glow);
  }
  .ment-who li:last-child { border-bottom: 0; }
  .ment-who li:hover { color: var(--heading); padding-left: 6px; }

  /* Temas (pills) */
  .ment-topics { margin-bottom: 42px; }
  .ment-topics-k {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .ment-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .ment-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    color: var(--text-soft);
    cursor: default;
    transition: transform 0.2s var(--e), color 0.25s, border-color 0.25s, background 0.25s, box-shadow 0.25s;
  }
  .ment-chip:hover {
    transform: translateY(-3px);
    color: #fff;
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 12px 28px -14px var(--glow);
  }

  /* CTA */
  .ment-cta { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .ment-note {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-dim);
    max-width: 48ch;
    line-height: 1.5;
  }

  /* Responsivo */
  @media (max-width: 960px) {
    .ment { padding: 96px 0; }
    .ment-headrow { grid-template-columns: 1fr; gap: 16px; align-items: start; }
    .ment-sub { padding-bottom: 0; }
    .ment-grid { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 560px) {
    .ment { padding: 74px 0; }
    .ment-cta { gap: 16px; }
  }
</style>
