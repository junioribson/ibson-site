---
// Logomarca oficial de Ibson Junior (extraída do material de marca em alta).
// variant "roxa" para fundos claros, "branca" para fundos escuros.
interface Props {
  class?: string;
  variant?: "roxa" | "branca";
}
const { class: className, variant = "roxa" } = Astro.props;
const src = variant === "branca" ? "/assets/logo/logo-branca.png" : "/assets/logo/logo-roxa.png";
---

<img class={className} src={src} alt="Ibson Junior" width="843" height="843" />
