---
// ProliferArte: origem cultural, contadores animados, estante de publicações
// (só apresentação, sem link) e convite para o Facebook do movimento.
import { getContent, imgDims, htmlLang } from "../i18n/utils";
import { t } from "../i18n/ui";
const { cases } = getContent(Astro.currentLocale);
const ui = t(Astro.currentLocale);
import Icon from "./Icon.astro";
const p = cases.proliferarte;
const FACEBOOK = "https://www.facebook.com/ProliferArte/";
// Valor final JÁ formatado no HTML (não "0"): crawlers e navegadores sem JS leem o
// número real. A contagem animada zera e sobe só quando o contador entra na tela.
const LANG = htmlLang(Astro.currentLocale);
const fmtCount = (to = 0, decimals = 0, suffix = "") =>
  to.toLocaleString(LANG, { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
---

<section class="prolifer" id="proliferarte">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{p.name} · {ui.proliferSince}</span>
    </div>
    <div class="pro-grid">
      <div class="reveal">
        <h2>{ui.proliferH2}</h2>
        <div class="body">
          {p.body.map((par) => <p>{par}</p>)}
        </div>
      </div>
    </div>

    <div class="pro-counters reveal stagger">
      {
        p.provas.map((s) => (
          <div class="pc-item">
            {s.static ? (
              <div class="pc-n">{s.display}</div>
            ) : (
              <div class="pc-n">
                <span class="count" data-to={s.to} data-decimals={s.decimals ?? 0} data-suffix={s.suffix ?? ""}>{fmtCount(s.to, s.decimals ?? 0, s.suffix ?? "")}</span>
              </div>
            )}
            <div class="pc-t">{s.label}</div>
          </div>
        ))
      }
    </div>

    <div class="reveal">
      <div class="pubs-lbl">Publicações e coletâneas</div>
      <div class="pubs">
        {
          p.galeria.map((pub) => (
            <figure class="pub">
              <div class="pc">
                <img loading="lazy" src={pub.src} {...imgDims(pub.src)} alt={`Publicação da ProliferArte: ${pub.title}`} />
              </div>
              <figcaption class="pb"><h3>{pub.title}</h3></figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="pro-fb reveal">
      <img class="pro-fb-logo" src="/assets/logo/proliferarte.png" alt="ProliferArte" width="220" height="220" loading="lazy" />
      <div class="pro-fb-text">
        <h3>{ui.proliferLiveTitle}</h3>
        <p>{ui.proliferLiveText}</p>
      </div>
      <a class="pro-fb-btn" href={FACEBOOK} target="_blank" rel="noopener">
        <Icon name="facebook" class="ic" /> Seguir no Facebook
      </a>
    </div>
  </div>
</section>

<style>
  .pro-counters {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
    margin: 10px 0 54px;
  }
  .pc-item {
    position: relative;
    background: linear-gradient(160deg, rgba(219, 107, 255, 0.09), rgba(255, 255, 255, 0.015));
    border: 1px solid rgba(219, 107, 255, 0.2);
    border-radius: 12px;
    padding: 26px 20px 24px;
    overflow: hidden;
    transition: transform 0.4s var(--e), border-color 0.4s, box-shadow 0.4s;
  }
  .pc-item::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent) 45%, #f0a35c 55%, transparent);
    background-size: 220% 100%;
    animation: pc-sheen 3.6s linear infinite;
    opacity: 0.8;
  }
  @keyframes pc-sheen { 0% { background-position: 220% 0; } 100% { background-position: -220% 0; } }
  .pc-item:hover {
    transform: translateY(-5px);
    border-color: rgba(219, 107, 255, 0.55);
    box-shadow: 0 20px 44px -22px var(--glow);
  }
  .pc-n {
    font-size: clamp(30px, 3.4vw, 46px); font-weight: 800; letter-spacing: -0.03em; line-height: 0.95;
    font-variant-numeric: tabular-nums; color: var(--accent);
    background: linear-gradient(100deg, #b98bff 0%, var(--accent) 38%, #f0a35c 74%, #b98bff 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    animation: accent-slide 6s linear infinite;
    filter: drop-shadow(0 0 16px var(--glow));
  }
  .pc-t { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-soft); margin-top: 12px; line-height: 1.4; }

  .pub figcaption.pb { padding: 18px 22px 22px; }
  .pub .pb h3 { font-size: 16px; }

  /* Convite ao Facebook: lockup logo + texto + botão, bem encaixado */
  .pro-fb {
    margin-top: 40px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 28px 32px;
    border: 1px solid rgba(68, 2, 111, 0.12);
    border-radius: 12px;
    background: #f6f1e8;
    box-shadow: 0 20px 50px -28px rgba(0, 0, 0, 0.6);
  }
  .pro-fb-logo { height: 64px; width: auto; flex: 0 0 auto; }
  .pro-fb-text h3 { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; color: #44026f; }
  .pro-fb-text p { font-size: 15px; margin-top: 4px; color: #6a4a86; }
  .pro-fb-btn {
    display: inline-flex; align-items: center; gap: 10px;
    background: #1877f2; color: #fff; font-weight: 700; font-size: 15px;
    padding: 13px 22px; border-radius: 3px; white-space: nowrap;
    transition: transform 0.25s var(--e), box-shadow 0.3s;
  }
  .pro-fb-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -10px rgba(24, 119, 242, 0.5); }
  .pro-fb-btn .ic { width: 18px; height: 18px; }
  @media (max-width: 820px) {
    .pro-fb { grid-template-columns: 1fr; text-align: center; justify-items: center; gap: 18px; }
  }
  @media (max-width: 980px) { .pro-counters { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .pro-counters { grid-template-columns: repeat(2, 1fr); } .pc-n { font-size: 28px; } }
</style>

<script>
  // Mesmo separador decimal do idioma da página (ex.: "1.5M+" no EN, "1,5 Mi+" no PT).
  const LANG = document.documentElement.lang || "pt-BR";
  const fmt = (v: number, decimals: number) => v.toLocaleString(LANG, { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  const animate = (el: HTMLElement) => {
    const to = parseFloat(el.dataset.to || "0");
    const decimals = parseInt(el.dataset.decimals || "0", 10);
    const suffix = el.dataset.suffix || "";
    const dur = 1600;
    let start = 0;
    const step = (ts: number) => {
      if (!start) start = ts;
      const t = Math.min(1, (ts - start) / dur);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = fmt(to * eased, decimals) + suffix;
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = fmt(to, decimals) + suffix;
    };
    requestAnimationFrame(step);
  };
  // Sob prefers-reduced-motion não anima: o valor real já está no HTML, então basta
  // deixá-lo. Assim também não há o "flash" de 0 para quem pede menos movimento.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { animate(e.target as HTMLElement); io.unobserve(e.target); } });
    }, { threshold: 0.4 });
    document.querySelectorAll<HTMLElement>(".count").forEach((el) => io.observe(el));
  }
</script>
