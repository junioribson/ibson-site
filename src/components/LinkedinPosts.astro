---
// Últimos posts no LinkedIn: carrossel lateral de artes (hospedadas no próprio
// site para indexação no Google Images). Cada card abre o post no LinkedIn.
import { linkedinPosts as lk } from "../data/content";
const fmt = (n: number) => (n >= 1000 ? (n / 1000).toFixed(1).replace(".0", "") + "k" : String(n));
// Mostra no máximo 8 posts (os mais recentes). O resto fica no LinkedIn.
const posts = lk.posts.slice(0, 8);
---

<section class="lkposts" id="linkedin">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">LinkedIn</span>
    </div>
    <div class="lk-head reveal">
      <h2>{lk.title}</h2>
      <a class="lk-all" href={lk.profileUrl} target="_blank" rel="noopener">Ver todos ↗</a>
    </div>
    <p class="lk-sub reveal">{lk.subtitle}</p>

    <div class="lk-wrap reveal">
      <button class="lk-nav lk-prev" aria-label="Anterior" type="button">‹</button>
      <div class="lk-scroller" id="lk-scroller">
        {
          posts.map((p) => (
            <a class="lk-card" href={p.url} target="_blank" rel="noopener" aria-label="Abrir post no LinkedIn">
              <div class="lk-media">
                <img class="lk-img" src={p.image} alt={p.alt} loading="lazy" />
              </div>
              <div class="lk-meta">
                <span class="lk-stat" title="Reações">
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-9.9-9.2C.6 8.7 2 5.5 5 5.1c1.9-.3 3.4.7 4.2 2 .8-1.3 2.3-2.3 4.2-2 3 .4 4.4 3.6 2.9 6.7C19.5 16.4 12 21 12 21z"/></svg>
                  {fmt(p.reactions)}
                </span>
                <span class="lk-stat" title="Comentários">
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H8l-4 4V5a1 1 0 0 1 1-1z"/></svg>
                  {fmt(p.comments)}
                </span>
                <span class="lk-stat" title="Compartilhamentos">
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M17 7l-1.4 1.4 2.6 2.6H8a5 5 0 0 0-5 5v2h2v-2a3 3 0 0 1 3-3h10.2l-2.6 2.6L17 19l5-5-5-5z"/></svg>
                  {fmt(p.shares)}
                </span>
                <span class="lk-open">no LinkedIn ↗</span>
              </div>
            </a>
          ))
        }
      </div>
      <button class="lk-nav lk-next" aria-label="Próximo" type="button" data-profile={lk.profileUrl}>›</button>
    </div>
  </div>
</section>

<style>
  .lkposts { position: relative; overflow: hidden; padding: 96px 0; }
  .lk-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .lk-head h2 {
    font-size: clamp(26px, 3.4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.06;
    color: #fff;
    max-width: 20ch;
  }
  .lk-all {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 13.5px;
    color: #db6bff;
    text-shadow: 0 0 16px rgba(219, 107, 255, 0.5);
    white-space: nowrap;
  }
  .lk-sub { margin-top: 14px; font-size: 16px; color: var(--ink-soft); line-height: 1.6; max-width: 60ch; }

  .lk-wrap { position: relative; margin-top: 32px; }
  .lk-scroller {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 8px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .lk-scroller::-webkit-scrollbar { display: none; }

  .lk-card {
    flex: 0 0 clamp(260px, 78vw, 340px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    transition: transform 0.35s var(--e), border-color 0.35s, box-shadow 0.35s;
  }
  .lk-card:hover {
    transform: translateY(-5px);
    border-color: rgba(219, 107, 255, 0.45);
    box-shadow: 0 26px 54px -30px rgba(0, 0, 0, 0.8), 0 0 34px -20px rgba(219, 107, 255, 0.55);
  }
  /* imagem 100% visível (sem corte), legível por inteiro */
  .lk-media { background: #0d0a14; }
  .lk-img { display: block; width: 100%; height: auto; }

  .lk-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 13px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
  }
  .lk-stat { display: inline-flex; align-items: center; gap: 5px; }
  .lk-stat svg { color: #db6bff; opacity: 0.9; }
  .lk-open { margin-left: auto; color: #db6bff; font-weight: 700; white-space: nowrap; }

  .lk-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(15, 10, 24, 0.8);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.25s, border-color 0.25s, transform 0.2s var(--e);
  }
  .lk-nav:hover { background: rgba(219, 107, 255, 0.2); border-color: #db6bff; }
  .lk-prev { left: -6px; }
  .lk-next { right: -6px; }
  @media (max-width: 760px) { .lk-nav { display: none; } }
</style>

<script>
  const scroller = document.getElementById("lk-scroller");
  const prev = document.querySelector<HTMLButtonElement>(".lk-prev");
  const next = document.querySelector<HTMLButtonElement>(".lk-next");
  const step = () => Math.round((scroller?.clientWidth || 320) * 0.85);
  prev?.addEventListener("click", () => scroller?.scrollBy({ left: -step(), behavior: "smooth" }));
  next?.addEventListener("click", () => {
    if (!scroller) return;
    // No fim do carrossel, a seta leva ao LinkedIn (ver os demais posts).
    const atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
    if (atEnd && next?.dataset.profile) {
      window.open(next.dataset.profile, "_blank", "noopener");
      return;
    }
    scroller.scrollBy({ left: step(), behavior: "smooth" });
  });
</script>
