---
// ProliferArte: origem cultural e primeiro laboratório de audiência.
// Capas em alta a chegar (public/assets/capas). Até lá, placeholders elegantes.
import { cases } from "../data/content";
const p = cases.proliferarte;

const phGrads = [
  "linear-gradient(150deg,#2A0148,#5B2EE6)",
  "linear-gradient(150deg,#44026F,#C94F8A)",
  "linear-gradient(150deg,#150026,#7B57F0)",
];
---

<section class="prolifer" id="proliferarte">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{p.name} · desde 2008</span>
    </div>
    <div class="pro-grid">
      <div class="reveal">
        <h2>Cultura, comunidade e o primeiro laboratório de audiência.</h2>
        <div class="body">
          {p.body.map((par) => <p>{par}</p>)}
        </div>
      </div>
      <div class="pro-stats reveal d1">
        {
          p.provas.map((s) => (
            <div class="ps"><div class="n">{s.n}</div><div class="t">{s.t}</div></div>
          ))
        }
      </div>
    </div>
    <div class="reveal">
      <div class="pubs-lbl">Publicações</div>
      <div class="pubs">
        {
          p.galeria.map((pub, i) => (
            <div class="pub">
              <div class="pc">
                {pub.src ? (
                  <img loading="lazy" src={pub.src} alt={`Publicação da ProliferArte: ${pub.title}`} />
                ) : (
                  <div class="cov-ph" style={`background:${phGrads[i % phGrads.length]}`}>
                    <span>IB</span>
                  </div>
                )}
              </div>
              <div class="pb">
                <h3>{pub.title}</h3>
                <span class="pl">Cultura</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
