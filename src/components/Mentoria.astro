---
// Mentoria: conversa estratégica de alto valor, aberta e madura.
// Cavalo-marinho como camada sutil (adaptação, escuta, relações humanas).
import { mentorship as m, archetypes } from "../data/content";
---

<section class="ment" id="mentoria">
  <div
    class="arch-layer on-light arch-right"
    style={`--arch-img:url('${archetypes.seahorse.src}');--arch-tint:var(--magenta);--arch-opacity:.08`}
    aria-hidden="true"
  >
  </div>
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">Mentoria</span>
    </div>
    <div class="ment-head">
      <h2 class="reveal">{m.title}</h2>
      <div class="ment-intro reveal d1">
        <p>{m.subtitle}</p>
      </div>
    </div>

    <div class="ment-lead reveal">
      {m.intro.map((p) => <p>{p}</p>)}
    </div>

    <div class="ment-cols reveal">
      <div class="ment-col">
        <h3>O que é</h3>
        {m.whatIs.map((p) => <p>{p}</p>)}
      </div>
      <div class="ment-col">
        <h3>Para quem é</h3>
        <ul>
          {m.whoFor.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>

    <div class="reveal">
      <h3 style="font-family:var(--font-mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--violet);margin-bottom:16px">O que pode ser trabalhado</h3>
      <div class="chips">
        {m.topics.map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>

    <div class="ment-cta reveal">
      <a class="btn btn-violet" href={m.cta.href}>{m.cta.label}</a>
      <span class="who">{m.note}</span>
    </div>
  </div>
</section>

<style>
  .ment-lead { max-width: 70ch; margin: -18px 0 46px; }
  .ment-lead p { font-size: 17px; line-height: 1.72; color: #d8cee8; margin-bottom: 14px; }
  .ment-lead p:first-child { font-size: clamp(19px, 1.7vw, 22px); font-weight: 600; color: #fff; line-height: 1.5; }
  .ment-lead p:last-child { margin-bottom: 0; }
  @media (max-width: 760px) { .ment-lead { margin: 6px 0 34px; } }
</style>
