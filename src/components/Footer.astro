---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { getContent, localizePath, normalizeLocale } from "../i18n/utils";
import { t } from "../i18n/ui";
const locale = normalizeLocale(Astro.currentLocale);
const { footer, nav } = getContent(locale);
const ui = t(locale);
const contato = localizePath("/#contato", locale);
const EMAIL = "contato@ibsonjunior.com.br";
---

<footer>
  <div class="wrap">
    <div class="foot-cta">
      <h2 class="foot-cta-t">{ui.footerCtaTitle}</h2>
      <a class="foot-cta-btn" href={contato}><span>{ui.footerCtaBtn}</span><span aria-hidden="true">→</span></a>
    </div>
    <div class="foot-top">
      <div class="foot-brand">
        <Logo class="foot-logo" surface="dark" />
        <b>{footer.name.toUpperCase()}</b><span class="s">{footer.line}</span>
        <p>{footer.complement}</p>
        <a class="foot-mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
      <div class="fcol">
        <h3 class="fcol-h">{ui.footerNavigate}</h3>
        <div class="fcol-links">
          {nav.links.map((l) => <a href={localizePath(l.href, locale)}>{l.label}</a>)}
          <a href={localizePath("/ibson-junior", locale)}>{ui.footerAbout}</a>
          <a href={localizePath("/imprensa", locale)}>{ui.footerPress}</a>
        </div>
      </div>
      <div class="fcol">
        <h3 class="fcol-h">{ui.footerConnect}</h3>
        <div class="foot-social">
          <a href="https://www.linkedin.com/in/ibson-junior/" target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={18} class="fsic" /></a>
          <a href="https://x.com/IbsonJunior" target="_blank" rel="noopener" aria-label="X (@IbsonJunior)"><Icon name="x" size={18} class="fsic" /></a>
          <a href="https://www.instagram.com/ibsonjunior.com.br/" target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} class="fsic" /></a>
        </div>
        <a href={`mailto:${EMAIL}`}>{ui.footerEmail}</a>
        <a href={contato}>{ui.footerInviteTalk}</a>
        <a href={contato}>{ui.footerTalkMentoring}</a>
      </div>
    </div>
    <div class="foot-base">
      <span>{ui.footerRights}</span>
      <a class="foot-priv" href={localizePath("/politica-de-privacidade", locale)}>{ui.privacyPolicy}</a>
      <span>{ui.footerTagline}</span>
    </div>
  </div>
</footer>

<style>
  .foot-logo { color: #fff; }
  .foot-social { display: flex; gap: 4px; margin-bottom: 6px; }
  .foot-social a { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; margin: 0; border-radius: 7px; color: var(--text-soft); transition: color 0.2s, background 0.2s; }
  .foot-social a:hover { color: #fff; background: rgba(255, 255, 255, 0.09); }
  .fsic { width: 18px; height: 18px; }
  .foot-priv { color: var(--text-soft); transition: color 0.25s; text-underline-offset: 2px; }
  .foot-priv:hover { color: var(--accent); text-decoration: underline; }
</style>
