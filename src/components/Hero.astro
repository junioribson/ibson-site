---
// HERO v3: lobo constelação (arquétipo) como cena, com rede de pontos animada
// reativa ao cursor. Alto contraste, tipografia grande, texto à esquerda.
import { getContent } from "../i18n/utils";
import { t } from "../i18n/ui";
const { hero } = getContent(Astro.currentLocale);
const ui = t(Astro.currentLocale);
---

<section class="wh" id="hero">
  <div class="wh-bg" data-parallax data-speed="14">
    <picture>
      <source
        media="(max-width: 900px)"
        srcset="/assets/arquetipos/wolf-editorial-mobile.webp"
        width="1200"
        height="514"
      />
      <img src="/assets/arquetipos/wolf-editorial.webp" alt="" aria-hidden="true" loading="lazy" width="1916" height="821" />
    </picture>
  </div>
  <div class="wh-scrim" aria-hidden="true"></div>
  <canvas class="wh-net" aria-hidden="true"></canvas>

  <div class="wrap wh-in">
    <h1 class="wh-h1">
      {
        hero.headlineLines.map((line, i) => (
          <span class="ln">
            <i
              style={`--d:${(0.15 + i * 0.11).toFixed(2)}s`}
              class:list={{ "wh-accent": i === hero.headlineLines.length - 1 }}
            >{line}</i>
          </span>
        ))
      }
    </h1>

    <p class="wh-sub">{hero.subheadline}</p>

    <div class="wh-cta">
      <a class="wh-btn wh-btn-primary" href={hero.ctas.primary.href}><span>{hero.ctas.primary.label}</span></a>
      <a class="wh-btn wh-btn-ghost" href={hero.ctas.secondary.href}><span>{hero.ctas.secondary.label}</span></a>
    </div>
  </div>

  <a class="wh-scroll" href="#tese" aria-label={ui.heroScrollAria}><span>{ui.heroScrollLabel}</span><span class="wh-scroll-line"></span></a>
</section>

<style>
  .wh {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 150px 0 90px;
    background: var(--bg);
  }
  .wh-bg { position: absolute; inset: 0; z-index: 0; will-change: transform; }
  .wh-bg img {
    position: absolute;
    inset: -4% -4% -4% auto;
    right: -4%;
    height: 108%;
    width: auto;
    max-width: none;
    object-fit: cover;
    object-position: right center;
    opacity: 0.96;
  }
  /* escurece a esquerda para o texto respirar (alto contraste) */
  .wh-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, #08060e 26%, rgba(8, 6, 14, 0.72) 46%, rgba(8, 6, 14, 0) 72%),
      linear-gradient(0deg, #08060e 2%, transparent 26%);
  }
  .wh-net { position: absolute; inset: 0; z-index: 2; pointer-events: none; }

  .wh-in { position: relative; z-index: 3; max-width: min(var(--maxw), 1360px); }

  .wh-eye { display: flex; align-items: center; gap: 14px; margin-bottom: 30px; opacity: 0; transform: translateY(12px); animation: whr .45s var(--e) .04s forwards; }
  .wh-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 5px rgba(176, 146, 94, 0.18), 0 0 14px 2px rgba(176, 146, 94, 0.6); }
  .wh-k { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.28em; text-transform: uppercase; color: #cbb98f; }

  .wh-h1 {
    font-weight: 800;
    font-size: clamp(44px, 8vw, 132px);
    line-height: 0.94;
    letter-spacing: -0.05em;
    max-width: 15ch;
    color: var(--heading);
  }
  .wh-h1 .ln { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .wh-h1 .ln > i {
    display: inline-block;
    font-style: normal;
    transform: translateY(112%);
    animation: whline 0.92s cubic-bezier(0.16, 1, 0.3, 1) var(--d) forwards;
  }
  .wh-accent {
    background: linear-gradient(100deg, #8b6bff 0%, #db6bff 24%, #ff7ac0 46%, #f0a35c 68%, #9a6bff 88%, #8b6bff 100%);
    background-size: 280% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: whline 1.05s cubic-bezier(0.16, 1, 0.3, 1) var(--d) forwards, accent-slide 4s linear infinite;
  }
  @keyframes whline { to { transform: none; } }

  .wh-sub {
    margin-top: 32px;
    max-width: 48ch;
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.6;
    color: var(--text-soft);
    font-weight: 500;
    opacity: 0;
    transform: translateY(14px);
    animation: whr .8s var(--e) .62s forwards;
  }

  .wh-cta { margin-top: 40px; display: flex; gap: 16px; flex-wrap: wrap; opacity: 0; transform: translateY(14px); animation: whr .8s var(--e) .8s forwards; }
  .wh-btn { position: relative; overflow: hidden; font-weight: 700; font-size: 15.5px; padding: 18px 32px; border-radius: 40px; transition: transform .3s var(--e), box-shadow .3s, border-color .3s, background .3s; }
  .wh-btn span { position: relative; z-index: 2; }
  .wh-btn-primary { background: linear-gradient(100deg, #6a2ee6, #9a6bff); color: #fff; box-shadow: 0 10px 30px -12px rgba(123, 87, 240, 0.7); }
  .wh-btn-primary:hover { transform: translateY(-3px); box-shadow: 0 22px 44px -14px rgba(123, 87, 240, 0.85); }
  .wh-btn-ghost { border: 1.5px solid var(--line-strong); color: var(--heading); }
  .wh-btn-ghost:hover { transform: translateY(-3px); border-color: var(--heading); background: var(--panel-2); }

  .wh-scroll { position: absolute; right: var(--gut); bottom: 30px; z-index: 3; display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--text-dim); opacity: 0; animation: whr 1s var(--e) 1s forwards; }
  .wh-scroll-line { width: 40px; height: 1px; background: var(--line-strong); position: relative; overflow: hidden; }
  .wh-scroll-line::after { content: ""; position: absolute; inset: 0; background: var(--gold); animation: slide 1.8s var(--e) infinite; }

  @keyframes whr { to { opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    .wh-bg img { right: -30%; height: 66%; inset: auto -30% 8% auto; opacity: 0.6; }
    .wh-scrim { background: linear-gradient(0deg, #08060e 8%, rgba(8,6,14,.7) 45%, rgba(8,6,14,.35) 100%); }
  }
  @media (max-width: 620px) {
    .wh { padding-top: 120px; }
    .wh-h1 { font-size: clamp(28px, 9.2vw, 58px); }
    .wh-cta .wh-btn { flex: 1 1 auto; text-align: center; }
    .wh-scroll { display: none; }
  }
  @media (max-width: 360px) {
    .wh-h1 { font-size: 30px; letter-spacing: -0.045em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wh-h1 .ln > i, .wh-eye, .wh-sub, .wh-cta, .wh-scroll { animation: none !important; opacity: 1 !important; transform: none !important; }
    .wh-accent { animation: none; }
  }

  /* TEMA CLARO: fundo creme, pontos roxos, sem o lobo escuro, texto escuro */
  :root[data-theme="light"] .wh-bg img { opacity: 0; }
  :root[data-theme="light"] .wh-scrim {
    background: linear-gradient(0deg, var(--bg) 0%, rgba(246, 242, 234, 0.35) 32%, transparent 72%);
  }
  :root[data-theme="light"] .wh-accent {
    background: linear-gradient(100deg, #5b2ee6 0%, #7b3fd0 26%, #c94f8a 52%, #a9762e 76%, #5b2ee6 100%);
    background-size: 280% 100%;
    -webkit-background-clip: text; background-clip: text;
  }
</style>

<script>
  // CÉU ESTRELADO do hero, em canvas 2D (leve, sem WebGL e sem dependência).
  //
  // Ideia: estrelas de verdade vistas num lugar escuro, ligadas por uma malha que
  // pulsa como SINAPSE. Tamanhos e brilhos variados, cintilância e deriva lenta dão
  // vida própria; por cima, as ligações disparam e apagam em ritmos diferentes pelo
  // bloco inteiro, formando desenhos novos o tempo todo e nunca ficando sem conexão.
  // O cursor não cria as ligações, ele INTENSIFICA as que passam por perto, mantendo
  // a sensação de conduzir a cena (referência: o facho que segue o mouse no trakto.io).
  //
  // Em telas sem hover (celular/tablet) e enquanto ninguém mexe o mouse, um ponto
  // "condutor" passeia sozinho pela cena, para o efeito nunca ficar morto.
  const sec = document.getElementById("hero");
  const canvas = sec?.querySelector<HTMLCanvasElement>(".wh-net");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && sec) {
    const ctx = canvas.getContext("2d")!;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0, H = 0, rect = sec.getBoundingClientRect();

    interface Star {
      bx: number; by: number; x: number; y: number;
      r: number; a: number; tw: number; ts: number;
      vx: number; vy: number; warm: boolean; boost: number;
    }
    let stars: Star[] = [];
    // Pares vizinhos (as sinapses). Como as estrelas derivam devagar, a lista de
    // vizinhos só é refeita de tempos em tempos; a cada quadro percorremos essa
    // lista curta, o que mantém a malha leve mesmo com muitos fios na tela.
    let pairs: { a: Star; b: Star; ph: number; sp: number }[] = [];
    let pairsAt = -1e9;

    const isLight = () => document.documentElement.dataset.theme === "light";

    // Sprite de brilho pré-renderizado: desenhar um gradiente por estrela a cada
    // quadro seria caro, então geramos uma vez e reaproveitamos com drawImage.
    let glow: HTMLCanvasElement;
    const buildGlow = () => {
      const rgb = isLight() ? "78, 20, 130" : "214, 200, 255";
      const s = 64;
      const c = document.createElement("canvas");
      c.width = c.height = s;
      const g = c.getContext("2d")!;
      const grd = g.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
      grd.addColorStop(0, `rgba(${rgb},0.95)`);
      grd.addColorStop(0.22, `rgba(${rgb},0.32)`);
      grd.addColorStop(1, `rgba(${rgb},0)`);
      g.fillStyle = grd;
      g.fillRect(0, 0, s, s);
      glow = c;
    };

    const build = () => {
      rect = sec.getBoundingClientRect();
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      canvas.style.width = W + "px"; canvas.style.height = H + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Densidade por área, com teto: mantém leve no desktop grande e no celular.
      const n = Math.max(40, Math.min(170, Math.round((W * H) / 8200)));
      stars = Array.from({ length: n }, () => {
        const x = Math.random() * W, y = Math.random() * H;
        return {
          bx: x, by: y, x, y,
          // Expoente alto: muitas estrelas pequenas e poucas grandes, como no céu.
          r: 0.5 + Math.pow(Math.random(), 2.4) * 2.1,
          a: 0.34 + Math.random() * 0.66,
          tw: Math.random() * Math.PI * 2,
          ts: 0.5 + Math.random() * 1.5,
          vx: (Math.random() - 0.5) * 0.055,
          vy: (Math.random() - 0.5) * 0.055,
          warm: Math.random() < 0.22,
          boost: 0,
        };
      });
      buildGlow();
    };

    // Alcance de uma sinapse: proporcional à tela, com piso e teto para a malha
    // ficar densa o bastante no celular e não virar teia no desktop grande.
    const linkDist = () => Math.min(150, Math.max(88, Math.min(W, H) * 0.17));

    // Zona de respiro do texto. O canvas fica ACIMA do scrim, então a máscara de CSS
    // não segura os fios: quem atenua é isto. A malha continua cobrindo o bloco
    // inteiro, só perde peso onde ficam título, subtítulo e botões, para o texto não
    // disputar leitura com as linhas. A elipse acompanha o layout de cada largura.
    const textFade = (x: number, y: number) => {
      const narrow = W < 700;
      const cx = W * (narrow ? 0.5 : 0.36);
      const cy = H * (narrow ? 0.58 : 0.56);
      const rx = W * (narrow ? 0.62 : 0.4);
      const ry = H * (narrow ? 0.34 : 0.33);
      const dx = (x - cx) / rx, dy = (y - cy) / ry;
      const q = dx * dx + dy * dy;
      return q >= 1 ? 1 : 0.3 + 0.7 * q;
    };
    const buildPairs = () => {
      const L = linkDist();
      pairs = [];
      for (let i = 0; i < stars.length; i++) {
        for (let j = i + 1; j < stars.length; j++) {
          const a = stars[i], b = stars[j];
          const dx = a.bx - b.bx, dy = a.by - b.by;
          if (dx * dx + dy * dy >= L * L) continue;
          // Velocidade e fase próprias por ligação: é isso que faz umas acenderem
          // enquanto outras apagam, em vários pontos ao mesmo tempo.
          pairs.push({ a, b, ph: Math.random() * Math.PI * 2, sp: 4 + Math.random() * 10 });
        }
      }
      if (pairs.length > 900) pairs.length = 900; // teto de segurança
    };

    // Ponto condutor: o cursor quando existe, senão um passeio automático.
    const ptr = { x: 0, y: 0, on: false };
    let lastMove = -1e9, auto = 0, t = 0;

    const setPtr = (cx: number, cy: number) => {
      ptr.x = cx - rect.left; ptr.y = cy - rect.top; ptr.on = true;
      lastMove = t;
    };
    sec.addEventListener("pointermove", (e) => setPtr(e.clientX, e.clientY));
    sec.addEventListener("pointerleave", () => { ptr.on = false; });
    sec.addEventListener("touchmove", (e) => {
      const tch = e.touches[0];
      if (tch) setPtr(tch.clientX, tch.clientY);
    }, { passive: true });
    window.addEventListener("resize", build);
    window.addEventListener("scroll", () => { rect = sec.getBoundingClientRect(); }, { passive: true });
    new MutationObserver(buildGlow).observe(document.documentElement, {
      attributes: true, attributeFilter: ["data-theme"],
    });

    const draw = () => {
      const light = isLight();
      ctx.clearRect(0, 0, W, H);

      // Alvo do "facho": cursor recente, senão o passeio automático (lissajous),
      // que também é o que anima a cena em telas de toque.
      auto += 0.0022;
      const idle = t - lastMove > 1.6;
      const px = ptr.on && !idle ? ptr.x : W * (0.5 + 0.3 * Math.sin(auto) * Math.cos(auto * 0.37));
      const py = ptr.on && !idle ? ptr.y : H * (0.44 + 0.26 * Math.sin(auto * 0.73));

      const R = Math.min(W, H) * 0.32;

      for (const s of stars) {
        // Deriva lenta e contínua (vida própria), com wrap nas bordas.
        s.bx += s.vx; s.by += s.vy;
        if (s.bx < -10) s.bx = W + 10; else if (s.bx > W + 10) s.bx = -10;
        if (s.by < -10) s.by = H + 10; else if (s.by > H + 10) s.by = -10;

        const dx = px - s.bx, dy = py - s.by;
        const d = Math.hypot(dx, dy);
        s.boost = d < R ? 1 - d / R : 0;
        // Atração suave em direção ao facho, com mola de volta ao lugar de origem.
        const pull = s.boost * s.boost * 0.26;
        const tx = s.bx + dx * pull, ty = s.by + dy * pull;
        s.x += (tx - s.x) * 0.11;
        s.y += (ty - s.y) * 0.11;
      }

      // SINAPSES: a malha cobre o bloco INTEIRO, não só o entorno do cursor. Cada
      // ligação tem fase e velocidade próprias, então umas disparam enquanto outras
      // apagam, sem nunca deixar a cena sem conexões, formando desenhos diferentes o
      // tempo todo. O expoente alto no pulso encurta o "aceso", dando o estalo de
      // sinapse em vez de um respiro lento. Perto do cursor a malha acende mais.
      const L = linkDist();
      if (t - pairsAt > 0.5) { buildPairs(); pairsAt = t; }
      ctx.lineWidth = 1;
      for (const p of pairs) {
        const dx = p.a.x - p.b.x, dy = p.a.y - p.b.y;
        const dist = Math.hypot(dx, dy);
        if (dist >= L) continue;
        const pulse = 0.5 + 0.5 * Math.sin(t * p.sp + p.ph);
        const hot = Math.max(p.a.boost, p.b.boost);
        // No claro a linha precisa de mais peso: traço escuro sobre creme rende
        // menos contraste do que traço claro sobre preto.
        const fade = textFade((p.a.x + p.b.x) / 2, (p.a.y + p.b.y) / 2);
        const al = Math.pow(pulse, 3) * (1 - dist / L) * (light ? 0.62 : 0.5) * (1 + hot * 2.4) * fade;
        if (al < 0.012) continue;
        ctx.strokeStyle = light ? `rgba(68,2,111,${al})` : `rgba(176,150,255,${al})`;
        ctx.beginPath();
        ctx.moveTo(p.a.x, p.a.y);
        ctx.lineTo(p.b.x, p.b.y);
        ctx.stroke();
      }

      // Estrelas: núcleo nítido + halo nas maiores e nas acesas pelo facho.
      for (const s of stars) {
        const tw = 0.62 + 0.38 * Math.sin(t * s.ts + s.tw);
        const alpha = Math.min(1, s.a * tw * (1 + s.boost * 1.9) * (light ? 1.18 : 1));
        const r = s.r * (1 + s.boost * 0.55);

        if (s.r > 1.45 || s.boost > 0.3) {
          const g = r * (7 + s.boost * 5);
          ctx.globalAlpha = Math.min(1, alpha * (0.32 + s.boost * 0.5));
          ctx.drawImage(glow, s.x - g / 2, s.y - g / 2, g, g);
          ctx.globalAlpha = 1;
        }
        ctx.beginPath();
        ctx.arc(s.x, s.y, r, 0, Math.PI * 2);
        ctx.fillStyle = light
          ? `rgba(${s.warm ? "104,26,150" : "42,1,72"},${alpha})`
          : `rgba(${s.warm ? "255,226,196" : "246,242,255"},${alpha})`;
        ctx.fill();
      }
    };

    let raf = 0, running = true;
    const step = () => {
      if (!running) return;
      t += 0.016;
      draw();
      raf = requestAnimationFrame(step);
    };

    build();
    if (reduce) {
      // Sob prefers-reduced-motion: céu parado, sem animação nem interação.
      draw();
    } else {
      const start = () => step();
      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(start, { timeout: 1200 });
      } else {
        setTimeout(start, 300);
      }
      // Pausa fora da tela: economiza bateria e tira trabalho da thread principal.
      new IntersectionObserver((ents) => {
        ents.forEach((e) => {
          if (e.isIntersecting && !running) { running = true; raf = requestAnimationFrame(step); }
          else if (!e.isIntersecting && running) { running = false; cancelAnimationFrame(raf); }
        });
      }, { threshold: 0 }).observe(sec);
    }
  }
</script>
