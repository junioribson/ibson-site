---
// Sobre: retrato + fio condutor "de galerias de arte a comunidades de milhões".
// Quando o retrato chegar, defina `photo` com o caminho (ex.: "/assets/retratos/ibson.jpg").
const photo: string | null = null;
---

<section class="sobre" id="sobre">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">Sobre</span>
    </div>
    <div class="sobre-grid">
      <div class="sobre-photo reveal">
        <div class="fr">
          {
            photo ? (
              <img src={photo} alt="Ibson Junior" />
            ) : (
              <div class="ph-portrait" aria-label="Retrato de Ibson Junior (a chegar)">
                <span>RETRATO</span>
              </div>
            )
          }
        </div>
      </div>
      <div class="reveal d1">
        <h2>
          De galerias de arte a comunidades de milhões: sempre lidei com
          audiência.
        </h2>
        <div class="kis">
          Estrategista digital · Mentor<br />Palestrante · Conselheiro em formação
        </div>
        <div class="body">
          <p>
            Comecei aproximando arte e público, muito antes de existir a
            expressão economia da atenção. Foi ali que aprendi o ofício que
            carrego até hoje: construir audiência onde quase ninguém olha e
            transformar apreciação em alcance.
          </p>
          <p>
            Daí em diante escalei o mesmo princípio. Fundei a <strong>WolfLife</strong>,
            ecossistema de comunidades digitais com mais de 150 milhões de
            seguidores, e a vendi em 2025. Sigo à frente da <strong>ProliferArte</strong>,
            movimento cultural que mantenho há 18 anos. E participei da
            construção e da venda de uma operação brasileira de mídia esportiva
            digital.
          </p>
          <p>
            O fio condutor nunca mudou: estratégia complexa, lastro em dados e
            resultado extraordinário. Hoje coloco essa bagagem a serviço de quem
            precisa decidir melhor, se posicionar com clareza e crescer com
            percepção de valor.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ph-portrait {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--purple-deep), var(--night));
  }
  .ph-portrait span {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.34em;
    color: rgba(255, 255, 255, 0.5);
  }
</style>
