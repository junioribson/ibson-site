---
// Últimos posts no LinkedIn: carrossel de artes (hospedadas no próprio site para
// indexação no Google Imagens). Cada card mostra a arte COMPLETA (qualquer
// formato, sem corte) e abre o post exato no LinkedIn ao clicar.
import { getContent, imgDims } from "../i18n/utils";
import { t } from "../i18n/ui";
const { linkedinPosts: lk } = getContent(Astro.currentLocale);
const ui = t(Astro.currentLocale);
// Mostra no máximo 8 posts (os mais recentes). O resto fica no LinkedIn.
const posts = lk.posts.slice(0, 8);
---

<section class="lkposts" id="linkedin">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">LinkedIn</span>
    </div>
    <div class="lk-head reveal">
      <h2>{lk.title}</h2>
      <a class="lk-all" href={lk.profileUrl} target="_blank" rel="noopener">{ui.postsSeeAll}</a>
    </div>
    <p class="lk-sub reveal">{lk.subtitle}</p>

    <div class="lk-wrap reveal">
      <button class="lk-nav lk-prev" aria-label={ui.galleryPrev} type="button">‹</button>
      <div class="lk-scroller" id="lk-scroller">
        {
          posts.map((p) => (
            <a class="lk-card" href={p.url} target="_blank" rel="noopener" aria-label={ui.postsCardAria}>
              <img class="lk-img" src={p.image} {...imgDims(p.image)} alt={p.alt} loading="lazy" />
              <span class="lk-hint">{ui.postsHint}</span>
            </a>
          ))
        }
      </div>
      <button class="lk-nav lk-next" aria-label={ui.galleryNext} type="button" data-profile={lk.profileUrl}>›</button>
    </div>
  </div>
</section>

<style>
  .lkposts { position: relative; overflow: hidden; padding: 96px 0; }
  .lk-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .lk-head h2 {
    font-size: clamp(26px, 3.4vw, 44px); font-weight: 800; letter-spacing: -0.035em;
    line-height: 1.06; color: var(--heading); max-width: 20ch;
  }
  .lk-all {
    font-family: var(--font-sans); font-weight: 800; font-size: 13.5px;
    color: var(--accent); text-shadow: 0 0 16px var(--glow); white-space: nowrap;
  }
  .lk-sub { margin-top: 14px; font-size: 16px; color: var(--ink-soft); line-height: 1.6; max-width: 60ch; }

  .lk-wrap { position: relative; margin-top: 32px; }
  .lk-scroller {
    display: flex;
    align-items: stretch; /* todos os cards com a mesma altura */
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 8px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .lk-scroller::-webkit-scrollbar { display: none; }

  /* Altura fixa, largura automática: qualquer formato mantém sua proporção,
     imagem inteira visível (sem corte), fileira alinhada. */
  .lk-card {
    position: relative;
    flex: 0 0 auto;
    height: clamp(320px, 56vh, 460px);
    scroll-snap-align: start;
    display: block;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: transform 0.35s var(--e), border-color 0.35s, box-shadow 0.35s;
  }
  .lk-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 26px 54px -30px rgba(0, 0, 0, 0.8), 0 0 34px -20px var(--glow);
  }
  .lk-img { display: block; height: 100%; width: auto; }

  /* Dica de clique (aparece no hover, sem poluir a arte) */
  .lk-hint {
    position: absolute; bottom: 12px; left: 50%;
    transform: translateX(-50%) translateY(8px); opacity: 0;
    font-family: var(--font-sans); font-weight: 800; font-size: 12.5px;
    color: #fff; padding: 8px 14px; border-radius: 999px;
    background: rgba(15, 10, 24, 0.82); backdrop-filter: blur(6px);
    border: 1px solid var(--glow);
    box-shadow: 0 10px 26px -10px rgba(0, 0, 0, 0.8);
    white-space: nowrap; pointer-events: none;
    transition: opacity 0.3s, transform 0.3s var(--e);
  }
  .lk-card:hover .lk-hint { opacity: 1; transform: translateX(-50%) translateY(0); }

  .lk-nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgba(15, 10, 24, 0.8); backdrop-filter: blur(6px);
    color: #fff; font-size: 22px; line-height: 1; cursor: pointer;
    transition: background 0.25s, border-color 0.25s, transform 0.2s var(--e);
  }
  .lk-nav:hover { background: var(--glow); border-color: var(--accent); }
  .lk-prev { left: -6px; }
  .lk-next { right: -6px; }
  @media (max-width: 760px) {
    /* Só a seta PRÓXIMA, neon roxa e pulsante, no meio-direita da tela: sinaliza
       que dá pra rolar e ver os outros posts (fica sobre a área da imagem sem
       texto, não sobre o texto). */
    .lk-prev { display: none; }
    .lk-next {
      display: flex; align-items: center; justify-content: center;
      right: 2px; top: 46%;
      width: 46px; height: 46px; font-size: 24px;
      color: #fff;
      background: linear-gradient(135deg, #7b3fe4, #a05bff);
      border: 1.5px solid #c9b3ff;
      box-shadow: 0 0 18px 2px rgba(139, 92, 255, 0.85), 0 10px 24px -10px rgba(0, 0, 0, 0.5);
      animation: lk-pulse 2s ease-in-out infinite;
    }
    .lk-next:active { background: linear-gradient(135deg, #8b4cf0, #b06bff); }
    @keyframes lk-pulse {
      0%, 100% { box-shadow: 0 0 14px 1px rgba(139, 92, 255, 0.6), 0 10px 24px -10px rgba(0, 0, 0, 0.5); }
      50% { box-shadow: 0 0 30px 6px rgba(139, 92, 255, 0.95), 0 10px 24px -10px rgba(0, 0, 0, 0.5); }
    }
    .lk-hint { opacity: 1; transform: translateX(-50%); } /* no touch, dica sempre visível */
  }
  @media (prefers-reduced-motion: reduce) { .lk-next { animation: none; } }
</style>

<script>
  const scroller = document.getElementById("lk-scroller");
  const prev = document.querySelector<HTMLButtonElement>(".lk-prev");
  const next = document.querySelector<HTMLButtonElement>(".lk-next");
  const step = () => Math.round((scroller?.clientWidth || 320) * 0.85);
  prev?.addEventListener("click", () => scroller?.scrollBy({ left: -step(), behavior: "smooth" }));
  next?.addEventListener("click", () => {
    if (!scroller) return;
    // No fim do carrossel, a seta leva ao LinkedIn (ver os demais posts).
    const atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
    if (atEnd && next?.dataset.profile) {
      window.open(next.dataset.profile, "_blank", "noopener");
      return;
    }
    scroller.scrollBy({ left: step(), behavior: "smooth" });
  });
</script>
