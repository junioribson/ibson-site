---
// Sobre: trajetória com autoridade, sem currículo nem autopromoção.
// TODO(asset): quando houver retrato editorial, definir `photo`
// (ex.: "/assets/retratos/ibson.jpg"). Até lá, placeholder sóbrio.
import { about } from "../data/content";
const photo: string | null = null;
---

<section class="sobre" id="sobre">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">Sobre</span>
    </div>
    <div class="sobre-grid">
      <div class="sobre-photo reveal">
        <div class="fr">
          {
            photo ? (
              <img src={photo} alt="Retrato editorial de Ibson Junior." />
            ) : (
              <div class="ph-portrait" aria-label="Retrato editorial de Ibson Junior (a chegar)">
                <span>RETRATO</span>
              </div>
            )
          }
        </div>
      </div>
      <div class="reveal d1">
        <h2>{about.title}</h2>
        <p class="about-sub">{about.subtitle}</p>
        <div class="body">
          {about.body.map((p) => <p set:html={p} />)}
        </div>
        <div class="about-proofs">
          {
            about.microprovas.map((m) => (
              <div class="pr">
                <span class="k">{m.k}</span>
                <span class="v">{m.v}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-sub {
    margin-top: 14px;
    font-size: 17px;
    color: var(--ink-soft);
    font-style: italic;
    max-width: 48ch;
  }
  .ph-portrait {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--purple-deep), var(--night));
  }
  .ph-portrait span {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.34em;
    color: rgba(255, 255, 255, 0.5);
  }
</style>
