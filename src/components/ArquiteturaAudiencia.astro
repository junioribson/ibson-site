---
// "A arquitetura por trás da audiência": bloco de autoridade entre a biografia e os
// cases. Explica que os projetos seguintes são consequência de repertório (conteúdo,
// comunidade, algoritmo, leitura de comportamento), não eventos isolados.
//
// Seção ESCURA nos dois temas (como Repertório e Contato), criando respiro entre o
// Sobre e o Cases, que são claros. Por isso as cores de texto são explícitas, e não
// tokens de tema.
//
// Ordem responsiva: no desktop o texto fica à esquerda e os números à direita; no
// mobile o card "+10 Bi" sobe logo depois do subhead (grid-template-areas).
import { getContent, normalizeLocale } from "../i18n/utils";
const locale = normalizeLocale(Astro.currentLocale);
const { audienceArchitecture: a } = getContent(locale);
---

<section class="arq" id="arquitetura-audiencia" aria-labelledby="arq-title">
  <div class="arq-net" aria-hidden="true"></div>
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{a.kicker}</span>
    </div>

    <div class="arq-grid">
      <div class="arq-head reveal">
        <h2 id="arq-title">{a.title}</h2>
        <p class="arq-sub">{a.subhead}</p>
      </div>

      <div class="arq-metrics reveal" role="group" aria-label={a.metricsAria}>
        <article class="arq-card arq-card-feat">
          <strong class="arq-n arq-n-feat">{a.featured.n}</strong>
          <span class="arq-lbl">{a.featured.label}</span>
          <small class="arq-note-in">{a.featured.note}</small>
        </article>
        <div class="arq-cards stagger">
          {a.metrics.map((m) => (
            <article class="arq-card">
              <strong class="arq-n">{m.n}</strong>
              <span class="arq-lbl">{m.label}</span>
            </article>
          ))}
        </div>
      </div>

      <div class="arq-rest reveal">
        {a.body.map((p) => <p class="arq-p">{p}</p>)}
        <p class="arq-impact">
          {a.impact.map((line) => <span>{line}</span>)}
        </p>
        <div class="arq-cta">
          <a class="arq-btn arq-btn-primary" href={a.ctas.primary.href}>{a.ctas.primary.label}</a>
          <a class="arq-btn arq-btn-ghost" href={a.ctas.secondary.href}>{a.ctas.secondary.label}</a>
        </div>
      </div>
    </div>

    <p class="arq-note">{a.note}</p>
  </div>
</section>

<style>
  /* Fundo escuro nos DOIS temas: dá respiro entre Sobre e Cases (ambos claros). */
  .arq {
    position: relative;
    overflow: hidden;
    padding: 118px 0;
    background: linear-gradient(158deg, #1a0433 0%, #10021f 54%, #08060e 100%);
    color: #e7dcc6;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  /* Camada "arquitetura": malha sutil + focos de luz. Sugere rede e distribuição
     sem parecer tecnologia fria. */
  .arq-net {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(52% 42% at 88% 6%, rgba(122, 74, 255, 0.28), transparent 62%),
      radial-gradient(40% 34% at 4% 96%, rgba(201, 79, 138, 0.14), transparent 64%),
      linear-gradient(rgba(168, 130, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(168, 130, 255, 0.06) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 76px 76px, 76px 76px;
    -webkit-mask-image: radial-gradient(120% 92% at 70% 30%, #000 30%, transparent 78%);
    mask-image: radial-gradient(120% 92% at 70% 30%, #000 30%, transparent 78%);
  }
  .arq .wrap { position: relative; z-index: 1; }
  .arq .shead .rule { background: linear-gradient(90deg, #a882ff, transparent); opacity: 0.9; }

  /* Desktop: texto à esquerda, números à direita (métricas ocupam as duas linhas).
     Mobile: cabeçalho, depois o card grande, depois o texto. */
  .arq-grid {
    display: grid;
    grid-template-columns: minmax(0, 48%) minmax(0, 52%);
    grid-template-areas: "head metrics" "rest metrics";
    gap: 34px 58px;
    align-items: start;
  }
  .arq-head { grid-area: head; }
  .arq-metrics { grid-area: metrics; }
  .arq-rest { grid-area: rest; }
  /* No desktop a coluna de texto é bem mais alta que a de números. Fixar os números
     evita um vazio grande à direita e mantém a prova à vista durante a leitura. */
  @media (min-width: 1081px) {
    .arq-metrics { position: sticky; top: 92px; }
  }

  .arq h2 {
    font-size: clamp(32px, 4.4vw, 62px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: #fff;
    max-width: 15ch;
  }
  .arq-sub {
    margin-top: 20px;
    font-size: 18px;
    line-height: 1.65;
    color: #cbbcdd;
    max-width: 46ch;
  }
  .arq-p {
    margin-top: 16px;
    font-size: 16.5px;
    line-height: 1.72;
    color: #b7a8c9;
    max-width: 52ch;
  }
  .arq-p:first-child { margin-top: 0; }

  /* Frase de impacto: duas linhas, tipografia grande, fecha o argumento. */
  .arq-impact {
    margin-top: 34px;
    padding-left: 20px;
    border-left: 2px solid rgba(168, 130, 255, 0.55);
    display: grid;
    gap: 6px;
  }
  .arq-impact span {
    font-size: clamp(19px, 2vw, 26px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.28;
    color: #fff;
  }
  .arq-impact span:last-child {
    background: linear-gradient(100deg, #c7a6ff, #e05aa8 72%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Números */
  .arq-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }
  .arq-card {
    position: relative;
    padding: 22px 22px 24px;
    border-radius: 16px;
    border: 1px solid rgba(168, 130, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
    box-shadow: 0 26px 60px -44px rgba(122, 74, 255, 0.9);
    transition: border-color 0.3s var(--e), background 0.3s var(--e), transform 0.3s var(--e);
  }
  .arq-card:hover {
    border-color: rgba(168, 130, 255, 0.45);
    background: rgba(255, 255, 255, 0.055);
    transform: translateY(-2px);
  }
  /* Contagem ímpar de cards: o último ocupa a linha inteira, para não sobrar um
     buraco na grade de duas colunas. */
  .arq-cards > article:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .arq-card-feat {
    padding: 32px 30px 30px;
    border-color: rgba(168, 130, 255, 0.34);
    background:
      radial-gradient(74% 120% at 88% 0%, rgba(122, 74, 255, 0.22), transparent 66%),
      rgba(255, 255, 255, 0.045);
  }
  .arq-n {
    display: block;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.9;
    font-size: clamp(30px, 3.4vw, 44px);
    color: #fff;
    background: linear-gradient(120deg, #ffffff, #a882ff 78%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .arq-n-feat { font-size: clamp(52px, 7.2vw, 104px); letter-spacing: -0.05em; }
  .arq-lbl {
    display: block;
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.5;
    color: #c3b4d5;
  }
  .arq-card-feat .arq-lbl { font-size: 16px; color: #e2d7f0; max-width: 26ch; }
  .arq-note-in {
    display: block;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 12.5px;
    line-height: 1.6;
    color: #9d8fb0;
  }

  /* Microcopy de credibilidade: discreta, mas presente (contexto das métricas). */
  .arq-note {
    margin-top: 40px;
    font-size: 12.5px;
    line-height: 1.65;
    color: #9184a3;
    max-width: 88ch;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* CTAs */
  .arq-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .arq-btn {
    font-weight: 700;
    font-size: 14.5px;
    padding: 14px 26px;
    border-radius: 100px;
    transition: transform 0.25s var(--e), filter 0.25s var(--e), background 0.25s var(--e);
  }
  .arq-btn-primary {
    background: linear-gradient(100deg, #6a2ee6, #c94f8a);
    color: #fff;
    box-shadow: 0 16px 40px -16px rgba(122, 74, 255, 0.85);
  }
  .arq-btn-primary:hover { filter: brightness(1.1); transform: translateY(-2px); }
  .arq-btn-ghost { border: 1.5px solid rgba(168, 130, 255, 0.5); color: #e7dcc6; }
  .arq-btn-ghost:hover { background: rgba(168, 130, 255, 0.12); transform: translateY(-2px); }

  /* ===== Tablet/iPad: uma coluna, números logo após o cabeçalho ===== */
  @media (max-width: 1080px) {
    .arq { padding: 88px 0; }
    .arq-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "metrics" "rest";
      gap: 30px;
    }
    .arq h2 { max-width: 20ch; }
    .arq-sub, .arq-p { max-width: 62ch; }
  }
  @media (max-width: 700px) {
    .arq { padding: 68px 0; }
    .arq-cards { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .arq-card { padding: 20px; }
    .arq-card-feat { padding: 26px 22px; }
    .arq-impact { padding-left: 16px; }
    .arq-cta { gap: 10px; }
    .arq-btn { width: 100%; text-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .arq-card, .arq-btn { transition: none; }
    .arq-card:hover, .arq-btn:hover { transform: none; }
  }
</style>
