---
// Contato: rotas claras por intenção + formulário.
// O formulário compõe um e-mail no cliente (mailto), sem backend.
// TODO(infra): integrar um serviço de formulário (ex.: Formspree) para receber
// envios sem depender do cliente de e-mail do visitante.
import { getContent } from "../i18n/utils";
import { t } from "../i18n/ui";
const { contact } = getContent(Astro.currentLocale);
const ui = t(Astro.currentLocale);
import Moon from "./Moon.astro";
import Icon from "./Icon.astro";
---

<section class="contato" id="contato">
  <div class="glow" aria-hidden="true"></div>
  <div class="stars" aria-hidden="true"></div>
  <Moon class="moon" />
  <div class="wrap in">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerContato}</span>
    </div>
    <h2 class="reveal display">{contact.title}</h2>
    <p class="lead reveal d1">{contact.subtitle}</p>

    <div class="contato-grid">
      <div class="quick reveal">
        <a class="qbtn qbtn-li" href={contact.linkedin} target="_blank" rel="noopener">
          <span class="qb-l"><Icon name="linkedin" class="ic" /> Conecte-se comigo no LinkedIn</span>
          <span>↗</span>
        </a>
        {
          contact.quickButtons.map((label) => (
            <a href="#form-contato" data-subject={label} class="qbtn">
              {label} <span>→</span>
            </a>
          ))
        }
        <a href={`mailto:${contact.email}`} class="qbtn">
          {contact.email} <span>↗</span>
        </a>
      </div>

      <form class="cform reveal d1" id="form-contato">
        <input type="hidden" name="access_key" value="ae5d5592-e6e5-4e58-bd78-d24f8240874c" />
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div>
          <label for="cf-nome">{ui.formName}</label>
          <input id="cf-nome" name="nome" type="text" autocomplete="name" required />
        </div>
        <div>
          <label for="cf-empresa">{ui.formCompany}</label>
          <input id="cf-empresa" name="empresa" type="text" autocomplete="organization" />
        </div>
        <div>
          <label for="cf-email">{ui.formEmail}</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div>
          <label for="cf-whats">WhatsApp</label>
          <input id="cf-whats" name="whatsapp" type="tel" autocomplete="tel" />
        </div>
        <div class="full">
          <label for="cf-assunto">{ui.formSubject}</label>
          <select id="cf-assunto" name="assunto">
            {contact.subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div class="full">
          <label for="cf-msg">{ui.formMessage}</label>
          <textarea id="cf-msg" name="mensagem" required></textarea>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-violet">{ui.formSend}</button>
          <span class="note">{contact.support}</span>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .qbtn-li { border-color: rgba(10, 102, 194, 0.6); }
  .qbtn-li:hover { background: #0a66c2; border-color: #0a66c2; }
  .qb-l { display: inline-flex; align-items: center; gap: 10px; }
  .qb-l .ic { width: 18px; height: 18px; }
</style>

<script define:vars={{ email: contact.email, successMsg: ui.formSuccess }}>
  const form = document.getElementById("form-contato");
  const assunto = document.getElementById("cf-assunto");

  // Botões de rota rápida: pré-selecionam o assunto e levam ao formulário.
  document.querySelectorAll(".quick a[data-subject]").forEach((a) => {
    a.addEventListener("click", () => {
      const sub = a.getAttribute("data-subject") || "";
      const map = {
        "Convidar para palestra": "Palestra",
        "Falar sobre mentoria": "Mentoria",
        "Propor entrevista": "Entrevista",
        "Falar sobre conselho/advisory": "Conselho / advisory",
      };
      if (assunto && map[sub]) assunto.value = map[sub];
    });
  });

  // Envio real via Web3Forms (sem sair da página), com feedback ao visitante.
  const btn = form?.querySelector('button[type="submit"]');
  const note = form?.querySelector(".note");
  const noteDefault = note?.textContent || "";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!btn || !note) return;
    const data = Object.fromEntries(new FormData(form).entries());
    data.subject = `[Site] ${data.assunto || "Contato"} · ${data.nome || ""}`;
    data.from_name = "Site Ibson Junior";

    const btnLabel = btn.textContent;
    btn.setAttribute("disabled", "true");
    btn.textContent = "Enviando...";
    note.style.color = "";
    note.textContent = "Enviando sua mensagem...";

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        form.reset();
        btn.textContent = "Enviado ✓";
        note.style.color = "#8ff0b8";
        note.textContent = successMsg;
      } else {
        throw new Error(json.message || "falha");
      }
    } catch (err) {
      btn.removeAttribute("disabled");
      btn.textContent = btnLabel;
      note.style.color = "#f0a35c";
      note.textContent = `Não consegui enviar agora. Escreva direto para ${email}.`;
    }
  });
</script>
