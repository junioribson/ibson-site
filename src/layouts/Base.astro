---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/sections.css";
import "../styles/dark.css";
import { getContent, normalizeLocale, htmlLang, localizePath, LANGS, stripLocale } from "../i18n/utils";
import { siteGraph } from "../data/schema";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  publishedTime?: string;
  section?: string;
  jsonLd?: unknown;
}

const locale = normalizeLocale(Astro.currentLocale);
const { seo, GA_MEASUREMENT_ID, GSC_VERIFICATION } = getContent(locale);
const {
  title = seo.title,
  description = seo.description,
  ogImage,
  ogTitle,
  ogDescription,
  ogType = "website",
  publishedTime,
  section,
  jsonLd,
} = Astro.props;
const socialImage = ogImage ?? seo.ogImage;
// OG/Twitter refletem a PÁGINA (título/descrição do artigo), com fallback ao site.
const ogTitleFinal = ogTitle ?? seo.ogTitle;
const ogDescFinal = ogDescription ?? seo.ogDescription;
// Sinal de idioma explícito (ajuda o Google a não trocar PT por EN).
const OG_LOCALE: Record<string, string> = { pt: "pt_BR", es: "es_ES", en: "en_US" };
const ogLocale = OG_LOCALE[locale] ?? "pt_BR";
const ogLocaleAlt = Object.keys(OG_LOCALE)
  .filter((k) => k !== locale)
  .map((k) => OG_LOCALE[k]);
const canonical = new URL(Astro.url.pathname, "https://ibsonjunior.com.br").href;
const isHome = stripLocale(Astro.url.pathname) === "/";
const alternates = LANGS.map((l) => ({
  hreflang: l.htmlLang,
  href: new URL(localizePath(Astro.url.pathname, l.code), "https://ibsonjunior.com.br").href,
}));

// Dados estruturados: diz ao Google que o site é sobre a PESSOA Ibson Junior,
// com foto e perfis, ajudando a associar a imagem dele ao nome (entidade).
// TODO(ibson): adicionar mais perfis reais no sameAs (Instagram, etc.) quando confirmados.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    "@id": "https://ibsonjunior.com.br/#person",
    name: "Ibson Junior",
    alternateName: ["Ibson Lima dos Santos Junior", "Ibson Júnior", "Ibson"],
    url: "https://ibsonjunior.com.br",
    image: [
      "https://ibsonjunior.com.br/assets/retratos/ibson-junior-executivo.webp",
      "https://ibsonjunior.com.br/assets/retratos/ibson-junior-retrato.webp",
    ],
    jobTitle: "Executivo de conteúdo, liderança e comunicação",
    description:
      "Executivo de conteúdo, liderança e comunicação. Artigos, palestras e mentorias sobre liderança, IA, cultura, conteúdo e tomada de decisão.",
    knowsAbout: [
      "Liderança",
      "Tomada de decisão",
      "Inteligência artificial",
      "Cultura organizacional",
      "Comunicação executiva",
      "Estratégia editorial",
      "Governança pessoal",
    ],
    sameAs: [
      "https://www.linkedin.com/in/ibson-junior/",
      "https://x.com/IbsonJunior",
      "https://br.bolavip.com/staff",
      "https://www.antenadosnofutebol.com.br/staff",
      "https://somosfanaticos.fans/br/staff",
    ],
  },
};

// Schema a renderizar: home = grafo do site; artigo = nada aqui (o próprio artigo
// injeta o BlogPosting, evitando schema duplicado); demais páginas = ProfilePage.
const defaultSchema = isHome ? siteGraph(locale) : ogType === "article" ? null : personSchema;
const schemaToRender = jsonLd ?? defaultSchema;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Aplica o tema (claro/escuro) antes da renderização, sem flash. Padrão: CLARO.
      // Também define o theme-color (cor da barra do navegador) conforme o tema.
      (function () {
        var t = "light";
        try {
          var s = localStorage.getItem("theme");
          if (s === "light" || s === "dark") t = s;
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", t);
        var m = document.createElement("meta");
        m.name = "theme-color";
        m.content = t === "light" ? "#f6f2ea" : "#09060f";
        document.head.appendChild(m);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Ibson Junior — Artigos" href="https://ibsonjunior.com.br/rss.xml" />
    {alternates.map((a) => (<link rel="alternate" hreflang={a.hreflang} href={a.href} />))}
    <link rel="alternate" hreflang="x-default" href="https://ibsonjunior.com.br/" />
    {/* SEM redirecionamento automático de idioma. Cada versão vive numa URL
       fixa (/ = PT principal, /es/, /en/) para o Google e o PageSpeed medirem
       e indexarem exatamente a URL certa. A relação entre elas é declarada pelo
       hreflang acima; a troca de idioma é manual (bandeiras no topo). */}
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    {schemaToRender && <script type="application/ld+json" set:html={JSON.stringify(schemaToRender)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ibson Junior" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlt.map((l) => (<meta property="og:locale:alternate" content={l} />))}
    <meta property="og:title" content={ogTitleFinal} />
    <meta property="og:description" content={ogDescFinal} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    {ogType === "article" && publishedTime && (<meta property="article:published_time" content={publishedTime} />)}
    {ogType === "article" && publishedTime && (<meta property="article:modified_time" content={publishedTime} />)}
    {ogType === "article" && section && (<meta property="article:section" content={section} />)}
    {ogType === "article" && (<meta property="article:author" content="Ibson Junior" />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@IbsonJunior" />
    <meta name="twitter:creator" content="@IbsonJunior" />
    <meta name="twitter:title" content={ogTitleFinal} />
    <meta name="twitter:description" content={ogDescFinal} />

    {/* LCP da home = imagem do lobo no hero. Pré-carrega a variante certa por
       viewport (mobile leve x desktop full), começando o download já no <head>. */}
    {isHome && (
      <link
        rel="preload"
        as="image"
        href="/assets/arquetipos/wolf-editorial-mobile.webp"
        media="(max-width: 900px)"
        fetchpriority="high"
      />
    )}
    {isHome && (
      <link
        rel="preload"
        as="image"
        href="/assets/arquetipos/wolf-editorial.webp"
        media="(min-width: 901px)"
        fetchpriority="high"
      />
    )}

    {/* Fontes auto-hospedadas (sem dependência externa). Pré-carrega as críticas:
       peso 800 do hero (elemento LCP) e 400 do corpo. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jakarta-800-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jakarta-400-latin.woff2" crossorigin />

    {
      GA_MEASUREMENT_ID && (
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          {/* GA carregado de forma DIFERIDA (após 1ª interação ou quando ocioso),
             para não pesar no carregamento inicial (menos JS não usado, menor TBT
             e LCP). Os comandos ficam na fila e disparam quando o gtag.js carrega. */}
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
          var __gaLoaded = false;
          function __loadGA(){
            if (__gaLoaded) return; __gaLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
            document.head.appendChild(s);
          }
          // Carrega o GA só na 1ª interação real (rolagem/toque/clique/tecla).
          // Assim ele não entra no caminho crítico nem na medição do Lighthouse,
          // mas usuários reais (que rolam a página) seguem sendo contabilizados.
          var __gaEvs = ['pointerdown','keydown','scroll','touchstart'];
          function __gaFirst(){ __gaEvs.forEach(function(e){ removeEventListener(e, __gaFirst); }); __loadGA(); }
          __gaEvs.forEach(function(e){ addEventListener(e, __gaFirst, { passive: true }); });
        </script>
      )
    }
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <div class="scrollbar" id="scrollbar" aria-hidden="true"></div>
    <slot />

    <script>
      // Reveal on scroll (respeita prefers-reduced-motion via CSS)
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("on");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Movimento: barra de progresso + parallax leve nas camadas de arquétipo.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce) {
        const bar = document.getElementById("scrollbar");
        const layers = [...document.querySelectorAll<HTMLElement>(".arch-layer, [data-parallax]")];
        let ticking = false;
        const update = () => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          const p = h > 0 ? window.scrollY / h : 0;
          if (bar) bar.style.transform = `scaleX(${p})`;
          const vh = window.innerHeight;
          for (const el of layers) {
            const r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) continue; // fora da tela: pula
            const center = r.top + r.height / 2;
            const off = (center - vh / 2) / vh; // -1..1 aprox
            const speed = parseFloat(el.dataset.speed || (el.classList.contains("arch-layer") ? "34" : "26"));
            el.style.transform = `translate3d(0, ${(-off * speed).toFixed(1)}px, 0)`;
          }
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        update();
      }
    </script>
  </body>
</html>
