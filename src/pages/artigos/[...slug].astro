---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticlePage from "../../components/ArticlePage.astro";

export async function getStaticPaths() {
  const artigos = await getCollection("artigos");
  return artigos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
// Camadas de SEO com fallback: se o artigo não define, usa o título/excerpt.
const seoTitle = d.seoTitle ?? d.title;
const socialTitle = d.socialTitle ?? d.seoTitle ?? d.title;
const metaDesc = d.seoDescription ?? d.excerpt;
const ogImg = `https://ibsonjunior.com.br${d.ogImage ?? d.cover}`;
---

<Base
  title={`${seoTitle} | Ibson Junior`}
  description={metaDesc}
  ogTitle={socialTitle}
  ogDescription={metaDesc}
  ogImage={ogImg}
  ogType="article"
  publishedTime={d.dateISO}
  section={d.category}
>
  <ArticlePage entry={entry} />
</Base>
