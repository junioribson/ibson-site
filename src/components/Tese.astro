---
import { getContent } from "../i18n/utils";
const { thesis, archetypes } = getContent(Astro.currentLocale);
---

<section class="tese" id="tese">
  <div
    class="arch-layer on-dark arch-left"
    style={`--arch-img:url('${archetypes.wolf.src}');--arch-tint:var(--violet-2);--arch-opacity:.1`}
    aria-hidden="true"
  >
  </div>
  <div class="wrap tese-grid">
    <div class="reveal">
      <div class="kicker">{thesis.kicker}</div>
      <blockquote>{thesis.title}</blockquote>
    </div>
    <div class="body reveal d1">
      {thesis.body.map((p) => <p>{p}</p>)}
      <p class="closing">{thesis.closing}</p>
    </div>
  </div>
</section>
