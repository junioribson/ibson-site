---
// Palestras: frente nova, aberta com elegância, sem inventar histórico.
// Atmosfera de noite preservada. Seis temas reais em desenvolvimento.
import { talks } from "../data/content";
import Moon from "./Moon.astro";
---

<section class="pal" id="palestras">
  <div class="pa" aria-hidden="true"></div>
  <div class="stars" aria-hidden="true"></div>
  <Moon class="moon" />
  <div class="wrap pal-body">
    <div class="reveal">
      <div class="lbl">Palestras</div>
      <h2>{talks.title}</h2>
      <p>{talks.subtitle}</p>
      <div style="margin-top:18px;max-width:52ch">
        {talks.intro.map((p) => <p style="margin-top:12px">{p}</p>)}
      </div>
    </div>

    <div class="talks-grid reveal">
      {
        talks.themes.map((th, i) => (
          <div class="talk">
            <div class="tn">/{String(i + 1).padStart(2, "0")}</div>
            <h3>{th.title}</h3>
            <p>{th.description}</p>
            <span class="who">{th.audience}</span>
          </div>
        ))
      }
    </div>

    <div class="reveal">
      <div class="pal-meta">
        {talks.formats.map((fmt) => <span class="pm">{fmt}</span>)}
        {talks.durations.map((d) => <span class="pm">{d}</span>)}
      </div>
      <div class="ment-cta">
        <a class="btn btn-ghost" href={talks.cta.href}>{talks.cta.label} →</a>
      </div>
      <p class="pal-note">{talks.note}</p>
    </div>
  </div>
</section>
