---
// Kit de imprensa (/imprensa/): bios (curta/média/longa) com botão copiar, foto
// oficial, temas, contato e links oficiais. Reaproveita `identity` (bio longa + foto).
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { getContent, normalizeLocale, localizePath } from "../i18n/utils";
import { t } from "../i18n/ui";

const locale = normalizeLocale(Astro.currentLocale);
const { press, identity } = getContent(locale);
const ui = t(locale);
const home = localizePath("/", locale);
const LINKEDIN = "https://www.linkedin.com/in/ibson-junior/";
const X = "https://x.com/IbsonJunior";
const EMAIL = "contato@ibsonjunior.com.br";
---

<Nav />
<main id="top" class="prs">
  <section class="prs-hero">
    <span class="prs-orb" aria-hidden="true"></span>
    <div class="wrap prs-hero-in">
      <a class="prs-back" href={home}>‹ {ui.breadcrumbHome}</a>
      <span class="prs-kicker reveal">{press.kicker}</span>
      <h1 class="prs-h1 reveal">{press.h1}</h1>
      <p class="prs-intro reveal">{press.intro}</p>
      <dl class="prs-cite reveal">
        <div><dt>{press.citeLabel}</dt><dd>{press.citeName}</dd></div>
        <div><dt>{press.fullLabel}</dt><dd>{press.fullName}</dd></div>
        <div><dt>{press.roleLabel}</dt><dd>{press.role}</dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap prs-sec">
    <div class="prs-shead reveal"><span class="prs-dot"></span>{press.biosTitle}</div>
    <div class="prs-bios">
      <article class="prs-bio reveal">
        <header><span class="prs-bio-l">{press.bioShortLabel}</span><button class="prs-copy" data-copy="bio-short" data-copied={press.copied}>{press.copy}</button></header>
        <p id="bio-short">{press.bioShort}</p>
      </article>
      <article class="prs-bio reveal">
        <header><span class="prs-bio-l">{press.bioMediumLabel}</span><button class="prs-copy" data-copy="bio-medium" data-copied={press.copied}>{press.copy}</button></header>
        <p id="bio-medium">{press.bioMedium}</p>
      </article>
      <article class="prs-bio prs-bio-long reveal">
        <header><span class="prs-bio-l">{press.bioLongLabel}</span><button class="prs-copy" data-copy="bio-long" data-copied={press.copied}>{press.copy}</button></header>
        <div id="bio-long">{identity.bio.map((p) => <p>{p}</p>)}</div>
      </article>
    </div>
  </section>

  <section class="wrap prs-sec prs-grid2">
    <div class="prs-photo reveal">
      <div class="prs-shead"><span class="prs-dot"></span>{press.photoTitle}</div>
      <figure>
        <img src={identity.portrait} alt={identity.portraitAlt} width="900" height="1125" loading="lazy" />
      </figure>
      <a class="prs-dl" href={identity.portrait} target="_blank" rel="noopener">{press.photoDownload} ↗</a>
    </div>
    <div class="prs-topics reveal">
      <div class="prs-shead"><span class="prs-dot"></span>{press.topicsTitle}</div>
      <div class="prs-chips">{press.topics.map((tp) => <span class="prs-chip">{tp}</span>)}</div>

      <div class="prs-shead prs-contact-h"><span class="prs-dot"></span>{press.contactTitle}</div>
      <div class="prs-links">
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={X} target="_blank" rel="noopener">X (@IbsonJunior) ↗</a>
        <a href={home}>ibsonjunior.com.br</a>
      </div>
    </div>
  </section>
</main>
<Footer />

<script is:inline>
  document.querySelectorAll(".prs-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = document.getElementById(btn.getAttribute("data-copy"));
      if (!el) return;
      try { await navigator.clipboard.writeText(el.innerText.trim()); } catch (e) {}
      const orig = btn.textContent;
      btn.textContent = btn.getAttribute("data-copied");
      btn.classList.add("ok");
      setTimeout(() => { btn.textContent = orig; btn.classList.remove("ok"); }, 1600);
    });
  });
</script>

<style>
  .prs-hero { position: relative; overflow: hidden; padding: 130px 0 56px; background: var(--bg); }
  .prs-orb { position: absolute; width: 42vw; height: 42vw; right: -12vw; top: -18vw; z-index: 0; border-radius: 50%; filter: blur(80px); background: radial-gradient(circle, #7b57f0, transparent 66%); opacity: 0.24; pointer-events: none; }
  :root[data-theme="light"] .prs-orb { opacity: 0.16; }
  .prs-hero-in { position: relative; z-index: 2; max-width: 900px; }
  .prs-back { display: block; width: fit-content; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--accent); margin-bottom: 26px; }
  .prs-kicker { display: inline-block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); text-shadow: 0 0 18px var(--glow); margin-bottom: 16px; }
  .prs-h1 { font-size: clamp(36px, 6vw, 68px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; color: var(--heading); margin: 0; }
  .prs-intro { margin-top: 18px; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.6; color: var(--text); max-width: 60ch; }
  .prs-cite { margin: 34px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .prs-cite div { border: 1px solid var(--line); border-radius: 12px; background: var(--panel); padding: 14px 16px; }
  .prs-cite dt { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 5px; }
  .prs-cite dd { margin: 0; font-size: 14.5px; font-weight: 700; color: var(--heading); line-height: 1.3; }

  .prs-sec { padding: clamp(48px, 7vw, 84px) 0 0; }
  .prs-shead { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 22px; }
  .prs-dot { width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(120deg, #6a2ee6, #c94f8a); box-shadow: 0 0 14px var(--glow); }

  .prs-bios { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .prs-bio-long { grid-column: 1 / -1; }
  .prs-bio { border: 1px solid var(--line); border-radius: 14px; background: var(--panel); padding: 20px 22px 22px; }
  .prs-bio header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .prs-bio-l { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .prs-copy { font-family: var(--font-sans); font-weight: 700; font-size: 12.5px; color: var(--heading); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; transition: border-color 0.25s, color 0.25s, background 0.25s; }
  .prs-copy:hover { border-color: var(--accent); color: var(--accent); }
  .prs-copy.ok { border-color: var(--accent); color: #fff; background: var(--accent); }
  .prs-bio p { font-size: 15px; line-height: 1.66; color: var(--text); margin: 0 0 14px; }
  .prs-bio p:last-child { margin-bottom: 0; }
  .prs-bio-long #bio-long { columns: 2; column-gap: 34px; }
  .prs-bio-long #bio-long p { break-inside: avoid; }

  .prs-grid2 { display: grid; grid-template-columns: 300px 1fr; gap: clamp(28px, 5vw, 60px); align-items: start; }
  .prs-photo figure { margin: 0 0 14px; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 26px 54px -34px rgba(0,0,0,0.8); }
  .prs-photo img { display: block; width: 100%; height: auto; }
  .prs-dl { font-family: var(--font-sans); font-weight: 800; font-size: 13.5px; color: var(--accent); text-shadow: 0 0 16px var(--glow); }
  .prs-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }
  .prs-chip { font-family: var(--font-sans); font-weight: 700; font-size: 14px; color: var(--heading); padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); }
  .prs-contact-h { margin-top: 4px; }
  .prs-links { display: flex; flex-direction: column; gap: 2px; }
  .prs-links a { font-family: var(--font-sans); font-weight: 700; font-size: 15.5px; color: var(--heading); padding: 11px 0; border-bottom: 1px solid var(--line); transition: color 0.25s, padding-left 0.25s; }
  .prs-links a:hover { color: var(--accent); padding-left: 6px; }

  main.prs { padding-bottom: clamp(70px, 10vw, 120px); }
  @media (max-width: 820px) {
    .prs-cite { grid-template-columns: 1fr; }
    .prs-bios { grid-template-columns: 1fr; }
    .prs-bio-long #bio-long { columns: 1; }
    .prs-grid2 { grid-template-columns: 1fr; }
    .prs-photo figure { max-width: 260px; }
  }
</style>
