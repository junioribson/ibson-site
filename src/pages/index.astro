---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Tese from "../components/Tese.astro";
import Sobre from "../components/Sobre.astro";
import LinkedinPosts from "../components/LinkedinPosts.astro";
import Cases from "../components/Cases.astro";
import ProliferArte from "../components/ProliferArte.astro";
import Galeria from "../components/Galeria.astro";
import Artigos from "../components/Artigos.astro";
import Repertorio from "../components/Repertorio.astro";
import Mentoria from "../components/Mentoria.astro";
import Palestras from "../components/Palestras.astro";
import Videos from "../components/Videos.astro";
import Contato from "../components/Contato.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main id="top">
    <!-- Arco emocional: reconhecimento, tensão, autoridade, prova,
         profundidade, aplicação, conversão. -->
    <Hero />
    <Tese />
    <Sobre />
    <LinkedinPosts />
    <Cases />
    <ProliferArte />
    <Galeria />
    <Artigos />
    <Repertorio />
    <Mentoria />
    <Palestras />
    <Videos />
    <Contato />
  </main>
  <Footer />
</Base>
