---
import Logo from "./Logo.astro";
import { footer, nav } from "../data/content";
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <Logo class="foot-logo" variant="branca" />
        <b>{footer.name.toUpperCase()}</b><span class="s">{footer.line}</span>
        <p>{footer.complement}</p>
      </div>
      <div class="fcol">
        <h4>Navegar</h4>
        {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="fcol">
        <h4>Conectar</h4>
        <a href="https://www.linkedin.com/in/ibson-junior/" target="_blank" rel="noopener">Conecte-se comigo no LinkedIn ↗</a>
        <a href="mailto:contato@ibsonjunior.com.br">E-mail ↗</a>
        <a href="#contato">Iniciar uma conversa</a>
      </div>
    </div>
    <div class="foot-base">
      <span>© 2026 IBSON JUNIOR · IBSONJUNIOR.COM.BR</span>
      <span>CONSCIÊNCIA · DECISÃO · RESPONSABILIDADE</span>
    </div>
  </div>
</footer>

<style>
  .foot-logo { color: #fff; }
</style>
