---
// ProliferArte: origem cultural, contadores animados, estante de publicações
// (só apresentação, sem link) e convite para o Facebook do movimento.
import { cases } from "../data/content";
import Icon from "./Icon.astro";
const p = cases.proliferarte;
const FACEBOOK = "https://www.facebook.com/ProliferArte/";
---

<section class="prolifer" id="proliferarte">
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{p.name} · desde 2008</span>
    </div>
    <div class="pro-grid">
      <div class="reveal">
        <h2>Cultura, comunidade e o primeiro laboratório de audiência.</h2>
        <div class="body">
          {p.body.map((par) => <p>{par}</p>)}
        </div>
      </div>
    </div>

    <div class="pro-counters reveal stagger">
      {
        p.provas.map((s) => (
          <div class="pc-item">
            {s.static ? (
              <div class="pc-n">{s.display}</div>
            ) : (
              <div class="pc-n">
                <span class="count" data-to={s.to} data-decimals={s.decimals ?? 0} data-suffix={s.suffix ?? ""}>0{s.suffix}</span>
              </div>
            )}
            <div class="pc-t">{s.label}</div>
          </div>
        ))
      }
    </div>

    <div class="reveal">
      <div class="pubs-lbl">Publicações e coletâneas</div>
      <div class="pubs">
        {
          p.galeria.map((pub) => (
            <figure class="pub">
              <div class="pc">
                <img loading="lazy" src={pub.src} alt={`Publicação da ProliferArte: ${pub.title}`} />
              </div>
              <figcaption class="pb"><h3>{pub.title}</h3></figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="pro-fb reveal">
      <img class="pro-fb-logo" src="/assets/logo/proliferarte.png" alt="ProliferArte" width="220" height="220" loading="lazy" />
      <div class="pro-fb-text">
        <h3>A ProliferArte é um movimento vivo.</h3>
        <p>Acompanhe as publicações, os artistas e a comunidade na página oficial.</p>
      </div>
      <a class="pro-fb-btn" href={FACEBOOK} target="_blank" rel="noopener">
        <Icon name="facebook" class="ic" /> Seguir no Facebook
      </a>
    </div>
  </div>
</section>

<style>
  .pro-counters {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
    margin: 6px 0 54px;
  }
  .pc-item { background: rgba(255, 255, 255, 0.035); padding: 26px 20px 24px; }
  .pc-n { color: var(--violet-2); }
  .pc-n { font-size: clamp(26px, 3vw, 40px); font-weight: 800; letter-spacing: -0.03em; line-height: 0.95; color: var(--purple); font-variant-numeric: tabular-nums; }
  .pc-t { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); margin-top: 10px; line-height: 1.4; }

  .pub figcaption.pb { padding: 18px 22px 22px; }
  .pub .pb h3 { font-size: 16px; }

  /* Convite ao Facebook: lockup logo + texto + botão, bem encaixado */
  .pro-fb {
    margin-top: 40px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 28px 32px;
    border: 1px solid var(--hair);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
  }
  .pro-fb-logo { height: 64px; width: auto; flex: 0 0 auto; }
  .pro-fb-text h3 { color: #fff; }
  .pro-fb-text h3 { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; }
  .pro-fb-text p { font-size: 15px; color: var(--ink-soft); margin-top: 4px; }
  .pro-fb-btn {
    display: inline-flex; align-items: center; gap: 10px;
    background: #1877f2; color: #fff; font-weight: 700; font-size: 15px;
    padding: 13px 22px; border-radius: 3px; white-space: nowrap;
    transition: transform 0.25s var(--e), box-shadow 0.3s;
  }
  .pro-fb-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -10px rgba(24, 119, 242, 0.5); }
  .pro-fb-btn .ic { width: 18px; height: 18px; }
  @media (max-width: 820px) {
    .pro-fb { grid-template-columns: 1fr; text-align: center; justify-items: center; gap: 18px; }
  }
  @media (max-width: 980px) { .pro-counters { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .pro-counters { grid-template-columns: repeat(2, 1fr); } .pc-n { font-size: 28px; } }
</style>

<script>
  const fmt = (v: number, decimals: number) => v.toLocaleString("pt-BR", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  const animate = (el: HTMLElement) => {
    const to = parseFloat(el.dataset.to || "0");
    const decimals = parseInt(el.dataset.decimals || "0", 10);
    const suffix = el.dataset.suffix || "";
    const dur = 1600;
    let start = 0;
    const step = (ts: number) => {
      if (!start) start = ts;
      const t = Math.min(1, (ts - start) / dur);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = fmt(to * eased, decimals) + suffix;
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = fmt(to, decimals) + suffix;
    };
    requestAnimationFrame(step);
  };
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { animate(e.target as HTMLElement); io.unobserve(e.target); } });
  }, { threshold: 0.4 });
  document.querySelectorAll<HTMLElement>(".count").forEach((el) => io.observe(el));
</script>
