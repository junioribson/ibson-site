---
// Teaser compacto na home que substitui a seção completa e leva para a landing
// page dedicada (/palestras/, /mentoria/). Mantém o id para âncora e liga
// visualmente às LPs com um toque discreto da aurora.
interface Props {
  id: string;
  kicker: string;
  title: string;
  text: string;
  href: string;
  label: string;
}
const { id, kicker, title, text, href, label } = Astro.props;
---

<section class="teaser" id={id}>
  <span class="teaser-orb" aria-hidden="true"></span>
  <div class="wrap teaser-in reveal">
    <span class="teaser-kicker">{kicker}</span>
    <h2 class="teaser-title">{title}</h2>
    <p class="teaser-text">{text}</p>
    <a class="teaser-btn" href={href}>{label} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .teaser { position: relative; overflow: hidden; padding: clamp(64px, 9vw, 104px) 0; }
  .teaser-orb {
    position: absolute; width: 44vw; height: 44vw; right: -12vw; top: -16vw; z-index: 0;
    border-radius: 50%; filter: blur(80px); pointer-events: none;
    background: radial-gradient(circle, #7b57f0, transparent 66%); opacity: 0.24;
    animation: teaserDrift 24s ease-in-out infinite;
  }
  :root[data-theme="light"] .teaser-orb { opacity: 0.16; }
  @keyframes teaserDrift { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-3vw,3vw) scale(1.1); } }
  @media (prefers-reduced-motion: reduce) { .teaser-orb { animation: none; } }

  .teaser-in { position: relative; z-index: 2; max-width: 760px; }
  .teaser-kicker {
    display: inline-block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent); text-shadow: 0 0 18px var(--glow); margin-bottom: 18px;
  }
  .teaser-title {
    font-size: clamp(26px, 3.6vw, 44px); font-weight: 800; letter-spacing: -0.03em;
    line-height: 1.1; color: var(--heading); margin: 0; max-width: 20ch; text-wrap: balance;
  }
  .teaser-text {
    margin-top: 18px; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.6; color: var(--text); max-width: 58ch;
  }
  .teaser-btn {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 30px;
    font-family: var(--font-sans); font-weight: 800; font-size: 15px; color: #fff;
    background: linear-gradient(120deg, #6a2ee6 0%, #9a54ff 50%, #c94f8a 100%);
    padding: 14px 28px; border-radius: 999px; box-shadow: 0 18px 40px -14px rgba(122, 46, 230, 0.6);
    transition: transform 0.3s var(--e), box-shadow 0.3s var(--e), filter 0.3s var(--e);
  }
  .teaser-btn span { transition: transform 0.3s var(--e); }
  .teaser-btn:hover { transform: translateY(-3px); box-shadow: 0 26px 54px -16px rgba(201, 79, 138, 0.65); filter: brightness(1.07); }
  .teaser-btn:hover span { transform: translateX(4px); }
</style>
