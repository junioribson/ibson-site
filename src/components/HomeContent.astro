---
// Corpo da home (Nav + seções + Footer). Os componentes leem Astro.currentLocale,
// então as 3 páginas (/, /es/, /en/) reaproveitam este mesmo conteúdo.
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Tese from "./Tese.astro";
import Sobre from "./Sobre.astro";
import ArquiteturaAudiencia from "./ArquiteturaAudiencia.astro";
import LinkedinPosts from "./LinkedinPosts.astro";
import Cases from "./Cases.astro";
import ProliferArte from "./ProliferArte.astro";
import Galeria from "./Galeria.astro";
import Artigos from "./Artigos.astro";
import Repertorio from "./Repertorio.astro";
import LpTeaser from "./LpTeaser.astro";
import Videos from "./Videos.astro";
import Contato from "./Contato.astro";
import Footer from "./Footer.astro";
import { getContent, localizePath, normalizeLocale } from "../i18n/utils";
import { t } from "../i18n/ui";

const locale = normalizeLocale(Astro.currentLocale);
const { talks, mentorship } = getContent(locale);
const ui = t(locale);
---

<Nav />
<main id="top">
  <!-- Arco emocional: reconhecimento, tensão, autoridade, prova,
       profundidade, aplicação, conversão. -->
  <Hero />
  <Tese />
  <Sobre />
  <ArquiteturaAudiencia />
  <LinkedinPosts />
  <Cases />
  <ProliferArte />
  <Galeria />
  <Artigos />
  <Repertorio />
  <LpTeaser
    id="mentoria"
    kicker={ui.kickerMentoria}
    title={mentorship.title}
    text={mentorship.subtitle}
    href={localizePath("/mentoria", locale)}
    label={ui.lpSeeMentoria}
  />
  <LpTeaser
    id="palestras"
    kicker={ui.kickerPalestras}
    title={talks.title}
    text={talks.subtitle}
    href={localizePath("/palestras", locale)}
    label={ui.lpSeeTalks}
  />
  <Videos />
  <Contato />
</main>
<Footer />
