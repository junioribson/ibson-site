---
// Palestras: cards cinematográficos com imagem de fundo + texto sobreposto.
// Clima de noite (lua + estrelas). Sem inventar histórico.
import { talks } from "../data/content";
---

<section class="pal" id="palestras">
  <div class="pal-top">
    <div class="pal-stars" aria-hidden="true"></div>
    <div class="pal-owl" aria-hidden="true" data-parallax data-speed="14">
      <img src="/assets/arquetipos/owl-editorial.webp" alt="" loading="lazy" />
    </div>
    <div class="pal-scrim" aria-hidden="true"></div>
    <canvas class="pal-net" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="reveal pal-hero-txt">
        <div class="lbl">Palestras</div>
        <h2>{talks.title}</h2>
        <p>{talks.subtitle}</p>
        <div class="pal-intro">
          {talks.intro.map((p) => <p set:html={p} />)}
        </div>
      </div>
    </div>
  </div>

  <div class="wrap pal-body">
    <div class="pcards reveal stagger">
      {
        talks.themes.map((th, i) => (
          <article class="pcard">
            <div class="pcard-media">
              {th.cover ? (
                <img class="pcard-img" loading="lazy" src={th.cover} alt="" />
              ) : (
                <div class="pcard-img pcard-ph" />
              )}
            </div>
            <div class="pcard-body">
              <h3>{th.title}</h3>
              <p>{th.description}</p>
              <span class="pcard-who">{th.audience}</span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal">
      <div class="pal-meta">
        {talks.formats.map((fmt) => <span class="pm">{fmt}</span>)}
        {talks.durations.map((d) => <span class="pm">{d}</span>)}
      </div>
      <div class="ment-cta">
        <a class="btn btn-ghost" href={talks.cta.href}>{talks.cta.label} →</a>
      </div>
      <p class="pal-note">{talks.note}</p>
    </div>
  </div>
</section>

<style>
  /* Fundo da seção = mesma noite estrelada do fundo da coruja (quase preto),
     com o roxo apenas como BRILHO suave, nunca como metade clara. Assim não há
     emenda: a imagem se funde no fundo como no hero do lobo. */
  .pal {
    background:
      radial-gradient(116% 88% at 74% 14%, rgba(102, 48, 158, 0.5) 0%, transparent 56%),
      radial-gradient(120% 100% at 10% 92%, rgba(52, 14, 92, 0.42) 0%, transparent 58%),
      #0b0617;
  }
  /* Bloco do topo: a coruja vive AQUI, com overflow, então nunca invade os cards */
  .pal-top {
    position: relative;
    overflow: hidden;
    min-height: 600px;
    display: flex;
    align-items: center;
  }
  .pal-top > .wrap { position: relative; z-index: 2; width: 100%; }
  /* Campo de estrelas contínuo por toda a seção: o céu da coruja não fica
     isolado, o fundo inteiro é um só. */
  .pal-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
    background-image:
      radial-gradient(1.4px 1.4px at 12% 20%, rgba(232, 206, 150, 0.55), transparent),
      radial-gradient(1px 1px at 27% 62%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1.6px 1.6px at 45% 28%, rgba(232, 206, 150, 0.45), transparent),
      radial-gradient(1px 1px at 61% 76%, rgba(255, 255, 255, 0.32), transparent),
      radial-gradient(1px 1px at 8% 82%, rgba(232, 206, 150, 0.38), transparent),
      radial-gradient(1.5px 1.5px at 86% 56%, rgba(255, 255, 255, 0.32), transparent),
      radial-gradient(1px 1px at 34% 90%, rgba(232, 206, 150, 0.32), transparent),
      radial-gradient(1.3px 1.3px at 70% 12%, rgba(255, 255, 255, 0.3), transparent);
    background-repeat: no-repeat;
  }
  /* Coruja em COVER (preenche a área, o céu da imagem sangra até a borda como
     o lobo no hero). As bordas internas (esquerda/baixo) dissolvem no escuro via
     scrim, então a imagem e o fundo viram uma coisa só, sem emenda. */
  .pal-owl {
    position: absolute;
    top: 0;
    right: 0;
    width: min(62%, 800px);
    height: 100%;
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }
  .pal-owl img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 15%;
    opacity: 0.96;
    animation: owl-breathe 12s ease-in-out infinite;
  }
  @keyframes owl-breathe {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; }
  }
  /* Scrim = pinta o MESMO escuro da seção sobre a esquerda e o rodapé da imagem,
     fazendo o céu da coruja dissolver no fundo (sem contorno de recorte). */
  .pal-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, #0b0617 18%, rgba(11, 6, 23, 0.72) 40%, rgba(11, 6, 23, 0) 66%),
      linear-gradient(180deg, rgba(11, 6, 23, 0) 56%, rgba(11, 6, 23, 0.85) 92%, #0b0617 100%);
  }
  /* Rede de partículas reativa ao cursor (mesma linguagem do hero do lobo) */
  .pal-net { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  @media (max-width: 900px) {
    .pal-owl { width: 66vw; right: -6%; top: 0; height: 100%; }
  }
  /* Telefone: coruja vira uma FAIXA de destaque no topo (cover, sangra nas
     laterais), dissolvendo no fundo em cima e embaixo. Texto abaixo, sem sobrepor. */
  @media (max-width: 760px) {
    .pal-top { display: block; min-height: 0; }
    .pal-owl {
      position: static;
      width: 100%;
      height: clamp(260px, 74vw, 360px);
      margin: 4px 0 10px;
      transform: none !important;
    }
    .pal-owl img {
      object-fit: cover;
      object-position: 50% 16%;
      opacity: 0.96;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 76%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 76%, transparent 100%);
    }
    .pal-scrim { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .pal-owl img { animation: none; } }

  .pal-intro { margin-top: 20px; max-width: 54ch; }
  .pal-intro p { margin-top: 13px; }
  .pal-intro p:first-child { margin-top: 0; }
  .pal-intro :global(strong) { color: #fff; font-weight: 700; }

  .pcards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 44px 0 34px;
  }
  /* Card limpo: imagem em cima, texto num painel CLARO abaixo (contrasta com as
     fotos escuras, texto sempre fora da imagem). */
  .pcard {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    background: #f4efe4;
    box-shadow: 0 26px 60px -34px rgba(0, 0, 0, 0.85);
    transition: transform 0.4s var(--e), box-shadow 0.4s;
  }
  .pcard:hover {
    transform: translateY(-6px);
    box-shadow: 0 36px 70px -32px rgba(0, 0, 0, 0.9), 0 0 44px -20px rgba(219, 107, 255, 0.55);
  }
  .pcard-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .pcard-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--e);
  }
  .pcard-ph { width: 100%; height: 100%; background: linear-gradient(150deg, #3a0a5e, #180030 70%); }
  .pcard:hover .pcard-img { transform: scale(1.05); }
  .pcard-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 24px;
    flex: 1;
  }
  .pcard-body h3 {
    font-size: clamp(18px, 1.4vw, 22px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.18;
    color: #1b0e1f;
  }
  .pcard-body p {
    font-size: 14px;
    line-height: 1.55;
    color: #5a4c63;
    flex: 1;
  }
  .pcard-who {
    display: block;
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid rgba(27, 14, 31, 0.12);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: #9a6a2e;
  }
  @media (max-width: 1100px) { .pcards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .pcards { grid-template-columns: 1fr; } .pcard-media { aspect-ratio: 16 / 9; } }
</style>

<script>
  // Rede de constelação dourada, reativa ao cursor, no clima da coruja.
  const canvas = document.querySelector<HTMLCanvasElement>("#palestras .pal-net");
  const sec = canvas?.closest<HTMLElement>(".pal-top") ?? document.getElementById("palestras");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && sec && !reduce) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const mouse = { x: -9999, y: -9999 };
    interface Node { x: number; y: number; vx: number; vy: number; }
    let nodes: Node[] = [];

    const build = () => {
      const r = sec.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      canvas.style.width = W + "px"; canvas.style.height = H + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(64, Math.round((W * H) / 30000));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * W, y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.22, vy: (Math.random() - 0.5) * 0.22,
      }));
    };

    const step = () => {
      ctx.clearRect(0, 0, W, H);
      for (const n of nodes) {
        n.x += n.vx; n.y += n.vy;
        if (n.x < 0 || n.x > W) n.vx *= -1;
        if (n.y < 0 || n.y > H) n.vy *= -1;
        const dx = mouse.x - n.x, dy = mouse.y - n.y;
        if (dx * dx + dy * dy < 26000) { n.x += dx * 0.0014; n.y += dy * 0.0014; }
      }
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 132) {
            ctx.strokeStyle = `rgba(214,182,120,${(1 - dist / 132) * 0.34})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }
      for (const n of nodes) {
        const dm = Math.hypot(mouse.x - n.x, mouse.y - n.y);
        const glow = dm < 160 ? 1 - dm / 160 : 0;
        ctx.beginPath();
        ctx.arc(n.x, n.y, 1.2 + glow * 1.7, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(232,206,150,${0.4 + glow * 0.55})`;
        ctx.fill();
      }
      raf = requestAnimationFrame(step);
    };

    let raf = 0;
    sec.addEventListener("mousemove", (e) => {
      const r = sec.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    sec.addEventListener("mouseleave", () => { mouse.x = -9999; mouse.y = -9999; });
    window.addEventListener("resize", build);
    build();
    step();
  }
</script>
