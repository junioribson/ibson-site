---
// Mentoria: conversa estratégica de alto valor, aberta e madura.
// Cavalo-marinho como camada sutil (adaptação, escuta, relações humanas).
import { mentorship as m, archetypes } from "../data/content";
---

<section class="ment" id="mentoria">
  <div
    class="arch-layer on-light arch-right"
    style={`--arch-img:url('${archetypes.seahorse.src}');--arch-tint:var(--magenta);--arch-opacity:.08`}
    aria-hidden="true"
  >
  </div>
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">Mentoria</span>
    </div>
    <div class="ment-head">
      <h2 class="reveal">{m.title}</h2>
      <div class="ment-intro reveal d1">
        <p>{m.subtitle}</p>
      </div>
    </div>

    <div class="ment-cols reveal">
      <div class="ment-col">
        <h3>O que é</h3>
        {m.whatIs.map((p) => <p>{p}</p>)}
      </div>
      <div class="ment-col">
        <h3>Para quem é</h3>
        <ul>
          {m.whoFor.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>

    <div class="reveal">
      <h3 style="font-family:var(--font-mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--violet);margin-bottom:16px">Temas possíveis</h3>
      <div class="chips">
        {m.topics.map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>

    <div class="ment-cta reveal">
      <a class="btn btn-violet" href={m.cta.href}>{m.cta.label}</a>
      <span class="who">{m.note}</span>
    </div>
  </div>
</section>
