---
// DEMO da "opção 3" (linguagem artística mais dramática) SEM transformar o site:
// renderiza o HOME REAL inteiro (Base + HomeContent = todas as seções, todo o texto,
// responsivo, com o toggle de tema real). A liberdade artística é a CAMADA por cima:
// no hero, a constelação vira uma ESFERA de partículas 3D (WebGL) cujos PONTOS reagem
// ao mouse (deformam, formando figuras). noindex, não linkada, NÃO afeta produção.
import Base from "../layouts/Base.astro";
import HomeContent from "../components/HomeContent.astro";
---

<Base demo noindex title="Demo, opção 3 | Ibson Junior" description="Demonstração isolada de direção de arte. Não indexar.">
  <HomeContent />
  <div class="demo-badge">Demo, opção 3 (direção de arte). Não afeta ibsonjunior.com.br</div>
</Base>

<style is:global>
  /* Camada "opção 3" (só sob body[data-demo]). Não remove/resume nada: troca a cena
     de fundo do hero pela esfera e realça o drama. Theme-aware (herda o toggle do site). */
  /* Hero: no ESCURO a esfera brilha; no CLARO ela vira quadrados faltos sobre o
     creme (ruim), então no claro volta a constelação real (limpa e desenhada). */
  body[data-demo] .wh-net { display: none; }
  body[data-demo] .wh-bg { display: none; }
  body[data-demo] .demo-sphere { position: absolute; inset: 0; z-index: 0; }
  :root[data-theme="light"] body[data-demo] .demo-sphere { display: none; }
  :root[data-theme="light"] body[data-demo] .wh-net { display: block; }
  /* Um scrim um pouco mais forte à esquerda, para o texto respirar sobre a esfera. */
  body[data-demo] .wh-scrim {
    background:
      linear-gradient(90deg, var(--bg) 22%, color-mix(in srgb, var(--bg) 78%, transparent) 44%, transparent 70%),
      linear-gradient(0deg, var(--bg) 2%, transparent 26%);
  }
  /* ===== Camada "opção 3" no SITE INTEIRO (atinge todas as seções pelos
     elementos compartilhados: kicker .lbl, .dot, .rule e os h2). ===== */
  body[data-demo] .shead .lbl {
    background: linear-gradient(100deg, #8b6bff, #db6bff 46%, #ff7ac0);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  body[data-demo] .shead .dot { background: #a882ff; box-shadow: 0 0 10px 2px rgba(122, 74, 255, 0.7); }
  body[data-demo] .shead .rule { background: linear-gradient(90deg, #a882ff, transparent); opacity: 0.9; }
  /* h2 de seção um pouco mais dramático em todo o site */
  body[data-demo] main :is(section) h2 { letter-spacing: -0.04em; }

  /* ================= CASES na OPÇÃO 3 (piloto de seção inteira) ================= */
  /* Fundo dramático com glows (theme-aware). Nenhum conteúdo removido. */
  body[data-demo] .cases {
    background:
      radial-gradient(60% 46% at 88% 4%, rgba(122, 74, 255, 0.05), transparent 60%),
      radial-gradient(48% 40% at 3% 98%, rgba(201, 79, 138, 0.04), transparent 60%),
      var(--bg);
  }
  :root:not([data-theme="light"]) body[data-demo] .cases {
    background:
      radial-gradient(70% 55% at 84% 6%, rgba(122, 74, 255, 0.22), transparent 58%),
      radial-gradient(55% 45% at 4% 96%, rgba(201, 79, 138, 0.14), transparent 58%),
      #08060e;
  }
  body[data-demo] .cases .cases-head h2 { font-size: clamp(36px, 5.6vw, 80px); letter-spacing: -0.045em; line-height: 1.0; }

  /* Card WolfLife: mais dramático (glow forte, borda sutil, raio maior) */
  body[data-demo] .cases .feat {
    border-radius: 22px; border: 1px solid rgba(122, 74, 255, 0.28);
    box-shadow: 0 50px 130px -55px rgba(122, 74, 255, 0.7);
    background: linear-gradient(150deg, #140a2e, #0a0618 70%);
  }
  body[data-demo] .cases .feat .fglow { width: 62%; height: 180%; background: radial-gradient(circle, rgba(122, 74, 255, 0.55), transparent 62%); filter: blur(46px); }

  /* Números GIGANTES da WolfLife (a estrela; já contam via motion.ts) */
  body[data-demo] .cases .fstats { gap: clamp(22px, 3vw, 44px) clamp(30px, 4vw, 58px); margin-top: 30px; }
  body[data-demo] .cases .fstats .fs .n {
    font-size: clamp(42px, 6vw, 84px); line-height: 0.86; letter-spacing: -0.05em; color: #fff;
    background: linear-gradient(120deg, #ffffff, #a882ff 72%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  body[data-demo] .cases .fstats .fs .t { font-size: 11.5px; margin-top: 8px; }

  /* Subcase "9 Bi+" gigante, com o número em gradiente */
  body[data-demo] .cases .subcase .num { font-size: clamp(52px, 8vw, 120px); line-height: 0.86; letter-spacing: -0.05em; }
  body[data-demo] .cases .subcase .num em {
    background: linear-gradient(120deg, #a882ff, #e05aa8);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
  }

  /* Botões com gradiente + glow (WolfLife e Futmarketing) */
  body[data-demo] .cases .feat .fbtn, body[data-demo] .cases .casecard .cc-cta {
    background: linear-gradient(100deg, #6a2ee6, #c94f8a); color: #fff; border: none;
    border-radius: 100px; padding: 14px 26px; box-shadow: 0 16px 40px -16px rgba(122, 74, 255, 0.8);
    letter-spacing: 0.04em;
  }
  body[data-demo] .cases .feat .fbtn:hover, body[data-demo] .cases .casecard .cc-cta:hover { filter: brightness(1.1); transform: translateY(-2px); }

  /* ================= OPÇÃO 3 no SITE INTEIRO (todas as seções) ================= */
  /* Fundo dramático com brilhos, por seção (theme-aware via var(--bg)). Exclui o
     hero (tem a esfera), o Cases (já feito) e Palestras (já é dark dramático). */
  /* Brilho ambiente SÓ nas seções "claras" comuns (Sobre, ProliferArte, Galeria,
     Artigos, Mentoria, Vídeos). As seções que JÁ têm fundo escuro dramático próprio
     (Hero, Cases, Palestras, Tese, Repertório, Contato) ficam de fora: mexer nelas
     apagava o fundo escuro e deixava texto claro sobre creme (sem contraste). Só a
     IMAGEM do brilho é trocada, então a cor/ritmo alternado das seções continua vivo. */
  body[data-demo] main > section:not(.wh):not(.cases):not(.pal):not(.tese):not(.repo):not(.contato) {
    background-image: radial-gradient(46% 36% at 90% 6%, rgba(122, 74, 255, 0.04), transparent 62%);
  }
  :root:not([data-theme="light"]) body[data-demo] main > section:not(.wh):not(.cases):not(.pal):not(.tese):not(.repo):not(.contato) {
    background-image: radial-gradient(50% 40% at 90% 6%, rgba(122, 74, 255, 0.13), transparent 62%);
  }

  /* Botões primários viram gradiente com glow (site todo) */
  body[data-demo] :is(.btn-primary, .btn-violet, .btn-lg, .id-cta, .ment-cta, .lp-cta, .teaser-btn) {
    background: linear-gradient(100deg, #6a2ee6, #c94f8a) !important;
    color: #fff !important; border-color: transparent !important;
    box-shadow: 0 16px 40px -16px rgba(122, 74, 255, 0.75);
  }
  body[data-demo] :is(.btn-primary, .btn-violet, .btn-lg, .id-cta, .ment-cta, .lp-cta, .teaser-btn):hover {
    filter: brightness(1.1); transform: translateY(-2px);
  }
  /* Botões ghost/outline ganham borda com brilho roxo */
  body[data-demo] :is(.btn-ghost, .btn-outline) { border-color: rgba(122, 74, 255, 0.55) !important; }

  /* Cards ganham borda e glow sutis (publicações, mentoria, vídeos, teasers, artigos) */
  body[data-demo] :is(.pcard, .ment-card, .vcard, .teaser, .artcard, .feat) {
    border: 1px solid rgba(122, 74, 255, 0.22);
    box-shadow: 0 34px 90px -55px rgba(122, 74, 255, 0.5);
  }

  /* Selo de demo, discreto. */
  body[data-demo] .demo-badge {
    position: fixed; z-index: 120; left: 16px; bottom: 16px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em;
    color: var(--text-soft); background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid var(--line); padding: 8px 14px; border-radius: 100px; backdrop-filter: blur(8px);
  }
</style>

<script>
  import * as THREE from "three";

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hero = document.getElementById("hero");

  if (hero && !reduce) {
    const canvas = document.createElement("canvas");
    canvas.className = "demo-sphere";
    canvas.setAttribute("aria-hidden", "true");
    hero.insertBefore(canvas, hero.firstChild);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
    cam.position.z = 3.2;

    // Pontos distribuídos numa esfera (fibonacci). Guardamos a posição "casa".
    const N = 2200;
    const home = new Float32Array(N * 3);
    const cur = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      const phi = Math.acos(1 - (2 * (i + 0.5)) / N);
      const theta = Math.PI * (1 + Math.sqrt(5)) * i;
      const x = Math.sin(phi) * Math.cos(theta), y = Math.sin(phi) * Math.sin(theta), z = Math.cos(phi);
      home[i * 3] = x; home[i * 3 + 1] = y; home[i * 3 + 2] = z;
      cur[i * 3] = x; cur[i * 3 + 1] = y; cur[i * 3 + 2] = z;
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute("position", new THREE.BufferAttribute(cur, 3));

    const mat = new THREE.PointsMaterial({ size: 0.02, transparent: true, depthWrite: false });
    const glowMat = new THREE.PointsMaterial({ size: 0.055, transparent: true, depthWrite: false });
    const applyTheme = () => {
      const light = document.documentElement.getAttribute("data-theme") === "light";
      mat.color = new THREE.Color(light ? "#5b2ee6" : "#a98bff");
      mat.opacity = 0.92;
      mat.blending = light ? THREE.NormalBlending : THREE.AdditiveBlending;
      mat.needsUpdate = true;
      glowMat.color = new THREE.Color(light ? "#c94f8a" : "#e05aa8");
      glowMat.opacity = light ? 0.16 : 0.3;
      glowMat.blending = light ? THREE.NormalBlending : THREE.AdditiveBlending;
      glowMat.needsUpdate = true;
    };
    applyTheme();
    new MutationObserver(applyTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    const grp = new THREE.Group();
    grp.add(new THREE.Points(geo, glowMat));
    grp.add(new THREE.Points(geo, mat));
    scene.add(grp);

    // Responsivo: em telas largas a esfera fica à direita e maior; no mobile, menor,
    // mais ao centro/atrás, e com menos intensidade (fica de cenário).
    let W = 0, H = 0, radiusPx = 150;
    const resize = () => {
      W = hero.clientWidth; H = hero.clientHeight;
      renderer.setSize(W, H, false);
      cam.aspect = W / H; cam.updateProjectionMatrix();
      const small = W < 820;
      // escala e posição responsivas: a esfera aparece bem no canto direito, sem
      // cobrir o texto (que fica à esquerda com o scrim). No mobile fica de cenário.
      grp.scale.setScalar(small ? 1.05 : 1.5);
      grp.position.x = small ? 0.15 : 0.78;
      grp.position.y = small ? 0.5 : 0.02;
      cam.position.z = small ? 3.6 : 3.2;
      radiusPx = Math.min(W, H) * (small ? 0.24 : 0.22);
      canvas.style.opacity = small ? "0.55" : "1";
    };
    resize();
    addEventListener("resize", resize);

    // Mouse relativo ao hero (para deformar os pontos onde o cursor está).
    const mouse = { x: -9999, y: -9999, active: false };
    let rect = hero.getBoundingClientRect();
    hero.addEventListener("pointermove", (e) => { mouse.x = e.clientX - rect.left; mouse.y = e.clientY - rect.top; mouse.active = true; });
    hero.addEventListener("pointerleave", () => { mouse.active = false; });
    addEventListener("scroll", () => { rect = hero.getBoundingClientRect(); }, { passive: true });

    const attr = geo.getAttribute("position") as THREE.BufferAttribute;
    const proj = new THREE.Vector3();
    let raf = 0, on = true, t = 0;
    const tick = () => {
      if (!on) return;
      t += 0.01;
      grp.rotation.y += 0.0006; // giro quase imperceptível; o "movimento" é dos pontos
      grp.updateMatrixWorld();
      for (let i = 0; i < N; i++) {
        const i3 = i * 3;
        const hx = home[i3], hy = home[i3 + 1], hz = home[i3 + 2];
        // respiração sutil (vida mesmo sem mouse)
        const breathe = 1 + Math.sin(t * 1.4 + i * 0.35) * 0.012;
        let tx = hx * breathe, ty = hy * breathe, tz = hz * breathe;
        // deformação: pontos perto do cursor incham para fora (formam figuras)
        if (mouse.active) {
          proj.set(hx, hy, hz).applyMatrix4(grp.matrixWorld).project(cam);
          const sx = (proj.x * 0.5 + 0.5) * W, sy = (-proj.y * 0.5 + 0.5) * H;
          const d = Math.hypot(sx - mouse.x, sy - mouse.y);
          if (d < radiusPx) {
            const f = 1 - d / radiusPx;
            const push = 1 + f * f * 0.7;
            tx = hx * push; ty = hy * push; tz = hz * push;
          }
        }
        // mola de volta à posição alvo (suave)
        cur[i3] += (tx - cur[i3]) * 0.14;
        cur[i3 + 1] += (ty - cur[i3 + 1]) * 0.14;
        cur[i3 + 2] += (tz - cur[i3 + 2]) * 0.14;
      }
      attr.needsUpdate = true;
      renderer.render(scene, cam);
      raf = requestAnimationFrame(tick);
    };
    tick();

    // pausa quando o hero sai da tela (economia)
    new IntersectionObserver((es) => es.forEach((en) => {
      if (en.isIntersecting && !on) { on = true; raf = requestAnimationFrame(tick); }
      else if (!en.isIntersecting && on) { on = false; cancelAnimationFrame(raf); }
    })).observe(hero);
  }
</script>
