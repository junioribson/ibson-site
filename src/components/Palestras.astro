---
// Palestras: cards cinematográficos com imagem de fundo + texto sobreposto.
// Clima de noite (lua + estrelas). Sem inventar histórico.
import { talks } from "../data/content";
---

<section class="pal" id="palestras">
  <div class="pal-owl" aria-hidden="true" data-parallax data-speed="14">
    <img src="/assets/arquetipos/owl-editorial.webp" alt="" loading="lazy" />
  </div>
  <div class="pa" aria-hidden="true"></div>
  <div class="pal-scrim" aria-hidden="true"></div>
  <canvas class="pal-net" aria-hidden="true"></canvas>
  <div class="wrap pal-body">
    <div class="reveal">
      <div class="lbl">Palestras</div>
      <h2>{talks.title}</h2>
      <p>{talks.subtitle}</p>
      <div class="pal-intro">
        {talks.intro.map((p) => <p set:html={p} />)}
      </div>
    </div>

    <div class="pcards reveal stagger">
      {
        talks.themes.map((th, i) => (
          <article class="pcard">
            {th.cover ? (
              <img class="pcard-img" loading="lazy" src={th.cover} alt="" />
            ) : (
              <div class="pcard-img pcard-ph" />
            )}
            <div class="pcard-ov">
              <div class="pcard-txt">
                <h3>{th.title}</h3>
                <p>{th.description}</p>
                <span class="pcard-who">{th.audience}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal">
      <div class="pal-meta">
        {talks.formats.map((fmt) => <span class="pm">{fmt}</span>)}
        {talks.durations.map((d) => <span class="pm">{d}</span>)}
      </div>
      <div class="ment-cta">
        <a class="btn btn-ghost" href={talks.cta.href}>{talks.cta.label} →</a>
      </div>
      <p class="pal-note">{talks.note}</p>
    </div>
  </div>
</section>

<style>
  /* Fundo da seção: roxo à esquerda, noite quase preta à direita, para a coruja
     (constelação sobre céu escuro) se fundir de forma nativa, como o lobo. */
  .pal {
    background: linear-gradient(102deg, #2a0148 0%, #200a3a 42%, #0c0518 100%);
  }
  /* Coruja como retrato editorial de fundo, nítida e inteira (object-fit contain),
     com a constelação dissolvendo nas bordas por máscara radial. */
  .pal-owl {
    position: absolute;
    top: 30px;
    right: min(0px, -1vw);
    width: min(50vw, 620px);
    height: min(92%, 920px);
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }
  .pal-owl img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center top;
    opacity: 0.97;
    -webkit-mask-image: radial-gradient(72% 66% at 54% 40%, #000 55%, transparent 90%);
    mask-image: radial-gradient(72% 66% at 54% 40%, #000 55%, transparent 90%);
    animation: owl-breathe 12s ease-in-out infinite;
  }
  @keyframes owl-breathe {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; }
  }
  /* Scrim: escurece a esquerda (texto legível) e o rodapé (funde nos cards) */
  .pal-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(99deg, #230b3f 24%, rgba(35, 11, 63, 0.5) 48%, transparent 72%),
      linear-gradient(180deg, transparent 60%, rgba(10, 4, 22, 0.6) 100%);
  }
  /* Rede de partículas reativa ao cursor (mesma linguagem do hero do lobo) */
  .pal-net { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  @media (max-width: 900px) {
    .pal-owl { width: 74vw; right: -10%; top: 8px; height: min(70%, 560px); }
    .pal-scrim { background: linear-gradient(180deg, rgba(35,11,63,.15) 0%, transparent 34%, transparent 62%, rgba(10,4,22,.55) 100%); }
  }
  @media (prefers-reduced-motion: reduce) { .pal-owl img { animation: none; } }

  .pal-intro { margin-top: 20px; max-width: 54ch; }
  .pal-intro p { margin-top: 13px; }
  .pal-intro p:first-child { margin-top: 0; }
  .pal-intro :global(strong) { color: #fff; font-weight: 700; }

  .pcards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 44px 0 34px;
  }
  .pcard {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 26px 60px -34px rgba(0, 0, 0, 0.8);
    isolation: isolate;
  }
  .pcard-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: transform 0.9s var(--e);
  }
  .pcard-ph { background: linear-gradient(150deg, #3a0a5e, #180030 70%); }
  .pcard:hover .pcard-img { transform: scale(1.06); }
  .pcard::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(21, 0, 38, 0.12) 0%, rgba(21, 0, 38, 0.35) 42%, rgba(15, 0, 28, 0.93) 100%);
  }
  .pcard-ov {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px 26px 28px;
  }
  .pcard-n {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--gold);
  }
  .pcard-txt h3 {
    font-size: clamp(19px, 1.5vw, 23px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.16;
    color: #fff;
  }
  .pcard-txt p {
    font-size: 14px;
    line-height: 1.5;
    color: #e4d8f5;
    margin-top: 10px;
    /* mostra 3 linhas, resto no hover */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: -webkit-line-clamp 0.3s;
  }
  .pcard:hover .pcard-txt p { -webkit-line-clamp: 6; }
  .pcard-who {
    display: block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: #b49fd6;
  }
  @media (max-width: 1100px) { .pcards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .pcards { grid-template-columns: 1fr; } .pcard { aspect-ratio: 16 / 12; } }
</style>

<script>
  // Rede de constelação dourada, reativa ao cursor, no clima da coruja.
  const sec = document.getElementById("palestras");
  const canvas = sec?.querySelector<HTMLCanvasElement>(".pal-net");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && sec && !reduce) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const mouse = { x: -9999, y: -9999 };
    interface Node { x: number; y: number; vx: number; vy: number; }
    let nodes: Node[] = [];

    const build = () => {
      const r = sec.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      canvas.style.width = W + "px"; canvas.style.height = H + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(64, Math.round((W * H) / 30000));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * W, y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.22, vy: (Math.random() - 0.5) * 0.22,
      }));
    };

    const step = () => {
      ctx.clearRect(0, 0, W, H);
      for (const n of nodes) {
        n.x += n.vx; n.y += n.vy;
        if (n.x < 0 || n.x > W) n.vx *= -1;
        if (n.y < 0 || n.y > H) n.vy *= -1;
        const dx = mouse.x - n.x, dy = mouse.y - n.y;
        if (dx * dx + dy * dy < 26000) { n.x += dx * 0.0014; n.y += dy * 0.0014; }
      }
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 132) {
            ctx.strokeStyle = `rgba(214,182,120,${(1 - dist / 132) * 0.34})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }
      for (const n of nodes) {
        const dm = Math.hypot(mouse.x - n.x, mouse.y - n.y);
        const glow = dm < 160 ? 1 - dm / 160 : 0;
        ctx.beginPath();
        ctx.arc(n.x, n.y, 1.2 + glow * 1.7, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(232,206,150,${0.4 + glow * 0.55})`;
        ctx.fill();
      }
      raf = requestAnimationFrame(step);
    };

    let raf = 0;
    sec.addEventListener("mousemove", (e) => {
      const r = sec.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    sec.addEventListener("mouseleave", () => { mouse.x = -9999; mouse.y = -9999; });
    window.addEventListener("resize", build);
    build();
    step();
  }
</script>
