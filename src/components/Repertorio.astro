---
// Repertório: lastro intelectual que sustenta a prática. Coruja como arquétipo
// (discernimento, visão, leitura fina). Fatos reais apenas.
// Lista como <dl> semântica (rótulo + descrição). Transição 2026: ciclo Futbol
// Sites no passado; sai "organizador de obras editoriais" (já está na ProliferArte).
import { getContent, normalizeLocale } from "../i18n/utils";
import { t } from "../i18n/ui";
const locale = normalizeLocale(Astro.currentLocale);
const { archetypes } = getContent(locale);
const ui = t(locale);

// TODO(asset): logomarca de Dr. José Eduardo / Mães que Curam quando o Ibson enviar.
const REP = {
  pt: {
    h2: "Repertório que sustenta a prática.",
    intro:
      "A autoridade que me interessa não nasce da exposição. Nasce da combinação entre experiência, leitura, escuta e decisões tomadas sob pressão. Cada linha abaixo é menos um título e mais uma marca de percurso: é desse acúmulo, e não do cargo do momento, que nasce o critério.",
    itens: [
      { t: "Conselheiro consultivo", d: "em projeto liderado pelo Dr. José Eduardo, nas frentes de saúde, educação e comunidade." },
      { t: "Formação executiva Advanced", d: "em Conselhos e Governança pela Board Academy." },
      { t: "Coautor", d: "do livro Conselho Diário, 365 Insights Estratégicos." },
      { t: "Nove anos com a Futbol Sites (2017 a 2026)", d: "de parceiro externo pela Futmarketing a Head of Digital Product e Diretor de Conteúdo no Brasil, com integrações pós-aquisição e reestruturações." },
      { t: "Duas operações construídas e vendidas", d: "Futmarketing (2022) e WolfLife (2025), com sócios e equipes." },
      { t: "Criação de ativos editoriais no esporte digital", d: "Antenados no Futebol e a chegada da Bolavip ao Brasil." },
      { t: "Artigos autorais mensais", d: "sobre IA, cultura, conteúdo, liderança e decisão." },
    ],
  },
  es: {
    h2: "Un repertorio que sostiene la práctica.",
    intro:
      "La autoridad que me interesa no nace de la exposición. Nace de la combinación entre experiencia, lectura, escucha y decisiones tomadas bajo presión. Cada línea a continuación es menos un título y más una marca de recorrido: es de esa acumulación, y no del cargo del momento, que nace el criterio.",
    itens: [
      { t: "Consejero consultivo", d: "en un proyecto liderado por el Dr. José Eduardo, en los frentes de salud, educación y comunidad." },
      { t: "Formación ejecutiva Advanced", d: "en Consejos y Gobernanza por la Board Academy." },
      { t: "Coautor", d: "del libro Conselho Diário, 365 Insights Estratégicos." },
      { t: "Nueve años con Futbol Sites (2017 a 2026)", d: "de socio externo por Futmarketing a Head of Digital Product y Director de Contenido en Brasil, con integraciones pos-adquisición y reestructuraciones." },
      { t: "Dos operaciones construidas y vendidas", d: "Futmarketing (2022) y WolfLife (2025), con socios y equipos." },
      { t: "Creación de activos editoriales en el deporte digital", d: "Antenados no Futebol y la llegada de Bolavip a Brasil." },
      { t: "Artículos de autor mensuales", d: "sobre IA, cultura, contenido, liderazgo y decisión." },
    ],
  },
  en: {
    h2: "A repertoire that sustains the practice.",
    intro:
      "The authority I care about is not born from exposure. It comes from the combination of experience, reading, listening and decisions made under pressure. Each line below is less a title and more a mark of the journey: it is from that accumulation, not from the current role, that judgment is born.",
    itens: [
      { t: "Advisory board member", d: "in a project led by Dr. José Eduardo, across health, education and community." },
      { t: "Advanced executive training", d: "in Boards and Governance by Board Academy." },
      { t: "Co-author", d: "of the book Conselho Diário, 365 Insights Estratégicos." },
      { t: "Nine years with Futbol Sites (2017 to 2026)", d: "from external partner through Futmarketing to Head of Digital Product and Content Director in Brazil, with post-acquisition integrations and restructurings." },
      { t: "Two operations built and sold", d: "Futmarketing (2022) and WolfLife (2025), with partners and teams." },
      { t: "Creation of editorial assets in digital sports", d: "Antenados no Futebol and Bolavip's arrival in Brazil." },
      { t: "Monthly authored articles", d: "on AI, culture, content, leadership and decision." },
    ],
  },
} as const;
const rep = REP[locale];
const itens = rep.itens;
// Retrato com troca por tema: poltrona (fundo escuro) no tema escuro, cinza (fundo
// claro) no tema claro. A moldura (object-fit cover, 4/5) faz o recorte.
const REP_ALT = {
  pt: { dark: "Ibson Junior de terno preto sobre fundo escuro, retrato executivo em estúdio", light: "Ibson Junior de braços cruzados, blazer marrom, retrato executivo em estúdio" },
  es: { dark: "Ibson Junior con traje negro sobre fondo oscuro, retrato ejecutivo de estudio", light: "Ibson Junior con los brazos cruzados, blazer marrón, retrato ejecutivo de estudio" },
  en: { dark: "Ibson Junior in a black suit on a dark background, executive studio portrait", light: "Ibson Junior with arms crossed, brown blazer, executive studio portrait" },
}[locale];
---

<section class="repo repertorio" id="repertorio">
  <div
    class="arch-layer on-light arch-right"
    style={`--arch-img:url('${archetypes.owl.src}');--arch-tint:var(--purple-deep);--arch-opacity:.09`}
    aria-hidden="true"
  >
  </div>
  <div class="wrap">
    <div class="shead reveal">
      <span class="dot"></span><span class="rule"></span><span class="lbl">{ui.kickerRepertorio}</span>
    </div>
    <div class="rep-grid">
      <div class="rep-left reveal">
        <h2>{rep.h2}</h2>
        <p>{rep.intro}</p>
        <dl class="rep-list">
          {itens.map((i) => (
            <div class="rep-row">
              <dt>{i.t}</dt>
              <dd>{i.d}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="rep-photo-col reveal d1">
        <img class="rep-photo rep-photo-dark" src="/assets/retratos/ibson-preto.webp" alt={REP_ALT.dark} width="915" height="1600" loading="lazy" style="object-position:50% 18%" />
        <img class="rep-photo rep-photo-light" src="/assets/retratos/ibson-marrom.webp" alt={REP_ALT.light} width="1086" height="1448" loading="lazy" style="object-position:50% 15%" />
      </div>
    </div>
  </div>
</section>

<style>
  /* Grade 7/5: texto à esquerda, imagem à direita. */
  .repertorio .rep-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 54px;
    align-items: stretch;
  }
  .rep-photo-col { position: relative; min-height: 0; }
  .rep-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    border-radius: 14px;
    box-shadow: 0 30px 66px -34px rgba(0, 0, 0, 0.85);
  }
  /* Troca por tema: poltrona (escuro) / cinza (claro). Só um renderiza. */
  .rep-photo-light { display: none; }
  :root[data-theme="light"] .rep-photo-dark { display: none; }
  :root[data-theme="light"] .rep-photo-light { display: block; }
  .repertorio h2 {
    font-size: clamp(26px, 3.4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.06;
    max-width: 16ch;
    color: var(--heading);
  }
  .repertorio .rep-grid > div > p {
    margin-top: 22px;
    font-size: 17px;
    color: var(--text);
    line-height: 1.72;
    max-width: 46ch;
  }

  /* Lista como definição semântica: rótulo (dt) + descrição (dd), alinhados ao topo,
     com divisórias e espaçamento vertical iguais. A seção é escura nos DOIS temas,
     então as cores são claras explícitas (não tokens que invertem com o tema). */
  .rep-list { margin-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .rep-row {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .rep-list dt {
    margin: 0;
    font-weight: 700;
    color: #ffffff;
    font-size: 16.5px;
    line-height: 1.4;
  }
  .rep-list dd {
    margin: 0;
    color: rgba(231, 220, 198, 0.9);
    font-size: 16.5px;
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .repertorio .rep-grid { grid-template-columns: minmax(0, 1fr); gap: 30px; align-items: start; }
    .rep-photo-col { order: -1; }
    .rep-photo { height: auto; aspect-ratio: 4 / 5; max-height: 540px; }
  }
  @media (max-width: 768px) {
    .rep-row { grid-template-columns: 1fr; gap: 4px; padding: 16px 0; }
  }
</style>
